def parse(s):
    out=[]
    for line in s.strip().splitlines():
        if line.strip():
            ja,en,y,school=line.split('|')
            out.append((ja,en,int(y),school))
    return out
pool=[]; seen=set()
for item in parse(classic)+parse(recent):
    if item[0] not in seen:
        pool.append(item); seen.add(item[0])
must={'拡散モデル拡張','RLHF Direct Preference Optimization','Mixture-of-Experts','Retrieval-Augmented Generation','Constitutional AI','Tool-use Agent'}
# select balanced: all must, then preserve broad history and make sure 2015+ >= 30%
selected=[]; seen=set()
def add(item):
    if item[0] not in seen:
        selected.append(item); seen.add(item[0])
for item in pool:
    if item[0] in must: add(item)
for item in pool:
    if item[2] < 2015 and len([x for x in selected if x[2]<2015]) < 210: add(item)
for item in pool:
    if item[2] >= 2015: add(item)
for item in pool:
    add(item)
selected=selected[:350]
# if truncation dropped must, replace tail
for m in must:
    if m not in {x[0] for x in selected}:
        item=next(x for x in pool if x[0]==m)
        selected[-1]=item
assert len(selected)==350, len(selected)
assert len({x[0] for x in selected})==350
assert must <= {x[0] for x in selected}
recent_count=sum(2015<=x[2]<=2025 for x in selected)
assert recent_count>=105, recent_count
