for x in recent: add(*x)

# ensure 250 exactly by trimming if accidental over, but fail if under
if len(entries) "'!= 250:
    raise SystemExit(f"got {len(entries)} entries, expected 250")
# validate uniqueness and lengths
names = [e['"'name_en'] for e in entries]
assert len(names) == len(set(names)), 'duplicate name_en'
for e in entries:
    assert e['subfield'] == 'デザイン理論'
    assert len(e['definition']) >= 100, (e['name_en'], len(e['definition']))
    assert len(e['impact_summary']) >= 50, (e['name_en'], len(e['impact_summary']))
