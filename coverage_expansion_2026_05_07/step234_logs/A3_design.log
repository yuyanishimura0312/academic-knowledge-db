    entries.append({\"name_ja\":ja,\"name_en\":en,\"definition\":definition,\"impact_summary\":impact,\"subfield\":\"デザイン理論\",\"school_of_thought\":school,\"era_start\":y,\"era_end\":None,\"keywords_ja\":kj,\"keywords_en\":ke,\"key_researchers\":rs,\"key_works\":ws})
