    ([1901,1945], [\"Walter Gropius\",\"László Moholy-Nagy\"], [\"Bauhaus Manifesto (1919)\",\"The New Vision (1928)\"], \"モダニズム,産業,形態\", \"modernism,industry,form\"),
    ([1946,1979], [\"Herbert A. Simon\",\"Christopher Alexander\"], [\"The Sciences of the Artificial (1969)\",\"A Pattern Language (1977)\"], \"方法論,人工物,システム\", \"methods,artifact,systems\"),
    ([1980,1999], [\"Donald A. Norman\",\"Nigel Cross\"], [\"The Design of Everyday Things (1988)\",\"Designerly Ways of Knowing (2006)\"], \"認知,経験,実践\", \"cognition,experience,practice\"),
    ([2000,2014], [\"Anthony Dunne\",\"Ezio Manzini\"], [\"Speculative Everything (2013)\",\"Design, When Everybody Designs (2015)\"], \"サービス,批評,参加\", \"service,critique,participation\"),
    ([2015,2025], [\"Sasha Costanza-Chock\",\"Ben Shneiderman\"], [\"Design Justice (2020)\",\"Human-Centered AI (2022)\"], \"正義,AI,持続可能性\", \"justice,AI,sustainability\"),
]

def profile(y):
    for (lohi, rs, ws, kj, ke) in profiles:
