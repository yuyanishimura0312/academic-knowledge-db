  {"name_ja":"儒教的民主主義","name_en":"Confucian Democracy","definition":"民本、徳、公共討議、教育を民主的制度と結び、個人主義的リベラル民主主義とは異なる参加政治を構想する理論。","impact_summary":"東アジア民主主義論、比較政治哲学、権威主義批判、公共徳論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"現代儒教政治哲学","era_start":2015,"era_end":null,"keywords_ja":"儒教的民主主義,民本,公共討議,徳","keywords_en":"Confucian democracy,minben,deliberation,virtue","key_researchers":["ソラフ・キム","白彤東","スティーブン・アングル"],"key_works":["Confucian Democracy in East Asia (2014)","Against Political Equality (2020)"]},
  {"name_ja":"儒教的人権論","name_en":"Confucian Human Rights Theory","definition":"人権を孤立した個人の権利でなく、尊厳、関係的義務、民本、仁政の延長として正当化する理論。","impact_summary":"アジア的人権論、比較法哲学、儒教政治倫理、国際規範論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"現代儒教法哲学","era_start":2015,"era_end":null,"keywords_ja":"儒教的人権,尊厳,義務,民本","keywords_en":"Confucian human rights,dignity,duties,minben","key_researchers":["ジョセフ・チャン","スティーブン・アングル","ウィリアム・セオドア・ドバリー"],"key_works":["Confucian Perfectionism (2014)","The Trouble with Confucianism (1991)"]},
  {"name_ja":"アジア的価値論争","name_en":"Asian Values Debate","definition":"共同体、秩序、家族、経済発展を重視するアジア的価値が普遍的人権とどう関係するかをめぐる政治哲学論争。","impact_summary":"人権論、シンガポール政治、東アジア民主化、文化相対主義批判に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"東アジア政治哲学","era_start":1990,"era_end":null,"keywords_ja":"アジア的価値,人権,共同体,文化相対主義","keywords_en":"Asian values,human rights,community,cultural relativism","key_researchers":["リー・クアンユー","アマルティア・セン","ダニエル・A・ベル"],"key_works":["East Meets West (2000)","Human Rights and Asian Values (1997)"]},
  {"name_ja":"アジア的フェミニズム倫理","name_en":"Asian Feminist Ethics","definition":"家族、労働、植民地性、宗教、国家開発を踏まえ、アジア女性の経験からケア、正義、自由を再構成する。","impact_summary":"グローバル・フェミニズム、移住労働、家族倫理、宗教批判に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"アジア・フェミニズム","era_start":2015,"era_end":null,"keywords_ja":"アジアフェミニズム,ケア,家族,植民地性","keywords_en":"Asian feminist ethics,care,family,coloniality","key_researchers":["チャンドラ・モハンティ","ウマ・ナラヤン","ローズマリー・タン"],"key_works":["Feminism without Borders (2003)","Dislocating Cultures (1997)"]},
  {"name_ja":"東アジア移民倫理","name_en":"East Asian Migration Ethics","definition":"家族義務、国籍、労働、ケア、排外主義を儒教・仏教・公共哲学の観点から検討する現代応用倫理。","impact_summary":"移民政策、介護労働、国民国家批判、多文化共生論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"東アジア公共倫理","era_start":2015,"era_end":null,"keywords_ja":"移民倫理,東アジア,家族,多文化共生","keywords_en":"migration ethics,East Asia,family,multiculturalism","key_researchers":["小熊英二","山脇直司","ブレンダ・イェオ"],"key_works":["単一民族神話の起源 (1995)","East Asian Public Philosophy (2014)"]},
  {"name_ja":"非西洋平和教育哲学","name_en":"Non-Western Philosophy of Peace Education","definition":"ガンディー非暴力、仏教慈悲、ウブントゥ、先住民和解を用いて、平和を関係修復と教育実践として考える。","impact_summary":"平和教育、紛争後和解、市民教育、宗教間対話に多元的資源を提供した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較平和哲学","era_start":2015,"era_end":null,"keywords_ja":"平和教育,非暴力,ウブントゥ,和解","keywords_en":"peace education,nonviolence,ubuntu,reconciliation","key_researchers":["ヨハン・ガルトゥング","池田大作","デズモンド・ツツ"],"key_works":["Peace by Peaceful Means (1996)","No Future Without Forgiveness (1999)"]},
  {"name_ja":"宗教的多元主義のアジア的展開","name_en":"Asian Religious Pluralism","definition":"仏教、儒教、道教、ヒンドゥー、イスラームが共存してきた歴史を踏まえ、排他性を超える公共宗教哲学を探る。","impact_summary":"宗教間対話、多文化政策、比較宗教哲学、紛争予防に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較宗教哲学","era_start":2015,"era_end":null,"keywords_ja":"宗教的多元主義,アジア,共存,公共宗教","keywords_en":"Asian religious pluralism,coexistence,public religion,dialogue","key_researchers":["ジョン・ヒック","杜維明","ラージーヴ・バルガヴァ"],"key_works":["An Interpretation of Religion (1989)","Secularism and Its Critics (1998)"]},
  {"name_ja":"インド的世俗主義","name_en":"Indian Secularism","definition":"宗教の公的排除ではなく、国家が複数宗教に原理的距離を保ちつつ介入・保護する政治哲学。","impact_summary":"多宗教民主主義、憲法論、宗教暴力、ポストコロニアル政治哲学に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"インド政治哲学","era_start":1950,"era_end":null,"keywords_ja":"インド的世俗主義,多宗教,憲法,原理的距離","keywords_en":"Indian secularism,pluralism,constitution,principled distance","key_researchers":["ラージーヴ・バルガヴァ","アシス・ナンディ"],"key_works":["Secularism and Its Critics (1998)","The Politics of Secularism and the Recovery of Religious Tolerance (1998)"]},
  {"name_ja":"ヒンドゥトヴァ批判哲学","name_en":"Philosophical Critiques of Hindutva","definition":"ヒンドゥー・ナショナリズムの宗教、民族、国家、歴史記述を批判的に分析し、多元的インド性を擁護する思想。","impact_summary":"インド政治哲学、世俗主義、少数者権利、歴史認識論争に大きな影響を与えた。","subfield":"東洋・非西洋哲学","school_of_thought":"現代インド政治哲学","era_start":2015,"era_end":null,"keywords_ja":"ヒンドゥトヴァ批判,ナショナリズム,世俗主義,多元性","keywords_en":"Hindutva critique,nationalism,secularism,pluralism","key_researchers":["アシス・ナンディ","ラージーヴ・バルガヴァ","ニヴェディタ・メノン"],"key_works":["The Intimate Enemy (1983)","Seeing Like a Feminist (2012)"]},
  {"name_ja":"非西洋ポピュリズム批判","name_en":"Non-Western Critiques of Populism","definition":"アジア、アフリカ、ラテンアメリカの宗教、民族、植民地記憶を動員するポピュリズムを比較政治哲学で分析する。","impact_summary":"民主主義論、宗教ナショナリズム、脱植民地政治、公共理性の研究を広げた。","subfield":"東洋・非西洋哲学","school_of_thought":"比較政治哲学","era_start":2016,"era_end":null,"keywords_ja":"ポピュリズム批判,宗教,民族,民主主義","keywords_en":"populism critique,religion,nation,democracy","key_researchers":["パルタ・チャタジー","ヤン＝ヴェルナー・ミュラー","チャンタル・ムフ"],"key_works":["I Am the People (2019)","What Is Populism? (2016)"]},
  {"name_ja":"脱植民地教育哲学","name_en":"Decolonial Philosophy of Education","definition":"学校と大学が植民地的知識階層を再生産する仕組みを批判し、地域語、先住民知、解放的教育を重視する。","impact_summary":"カリキュラム改革、大学脱植民地化、先住民教育、世界哲学教育に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"脱植民地教育思想","era_start":2015,"era_end":null,"keywords_ja":"脱植民地教育,地域語,先住民知,大学改革","keywords_en":"decolonial education,Indigenous knowledge,curriculum,university","key_researchers":["リンダ・トゥヒワイ・スミス","アチーレ・ムベンベ","パウロ・フレイレ"],"key_works":["Decolonizing Methodologies (1999)","Decolonizing the University (2018)"]},
  {"name_ja":"言語的脱植民地化","name_en":"Linguistic Decolonization","definition":"植民地語の支配を批判し、地域語や先住民語で哲学し書くことを知識主権の実践として捉える思想。","impact_summary":"文学、哲学教育、翻訳論、アフリカ・南アジア思想の再評価に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"脱植民地言語哲学","era_start":1986,"era_end":null,"keywords_ja":"言語的脱植民地化,地域語,翻訳,知識主権","keywords_en":"linguistic decolonization,vernaculars,translation,knowledge sovereignty","key_researchers":["グギ・ワ・ジオンゴ","ガナナート・オベイセーカラ"],"key_works":["Decolonising the Mind (1986)","Moving the Centre (1993)"]},
  {"name_ja":"翻訳としての世界哲学","name_en":"World Philosophy as Translation","definition":"哲学概念の移動を単なる等価語置換でなく、意味の変形、権力、創造的誤読を含む翻訳実践として捉える。","impact_summary":"比較哲学、翻訳研究、思想史、グローバル人文学の方法論を発展させた。","subfield":"東洋・非西洋哲学","school_of_thought":"比較哲学方法論","era_start":2015,"era_end":null,"keywords_ja":"翻訳,世界哲学,概念移動,比較","keywords_en":"translation,world philosophy,conceptual transfer,comparison","key_researchers":["リディア・リウ","ナオキ・サカイ","ラルフ・ウェーバー"],"key_works":["Translingual Practice (1995)","Translation and Subjectivity (1997)"]},
  {"name_ja":"非西洋概念工学","name_en":"Non-Western Conceptual Engineering","definition":"西洋語彙に合わせるのでなく、仁、空、ウブントゥ、ダルマなどを用いて哲学概念そのものを作り替える方法論。","impact_summary":"分析哲学、比較哲学、言語哲学、脱植民地知識論の接点を形成した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較方法論","era_start":2020,"era_end":null,"keywords_ja":"概念工学,非西洋概念,比較哲学,脱植民地","keywords_en":"conceptual engineering,non-Western concepts,comparative philosophy,decolonial","key_researchers":["アレクシス・バージェス","デイヴィッド・プランケット","ブライアン・ヴァン・ノーデン"],"key_works":["Conceptual Engineering and Conceptual Ethics (2020)","Taking Back Philosophy (2017)"]},
  {"name_ja":"非西洋認識論的多元主義","name_en":"Non-Western Epistemic Pluralism","definition":"知覚、証言、修行知、口承、占 divination、啓示、身体知など複数の知の形を哲学的に正当化する立場。","impact_summary":"認識論、科学哲学、先住民知、宗教哲学、世界哲学の議論を多元化した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較認識論","era_start":2015,"era_end":null,"keywords_ja":"認識論的多元主義,口承,身体知,証言","keywords_en":"epistemic pluralism,oral knowledge,embodied knowledge,testimony","key_researchers":["ボアヴェントゥラ・デ・ソウザ・サントス","リンダ・トゥヒワイ・スミス","ジョナードン・ガネリ"],"key_works":["Epistemologies of the South (2014)","The Lost Age of Reason (2011)"]},
  {"name_ja":"儀礼の哲学","name_en":"Philosophy of Ritual","definition":"儀礼を非合理的形式でなく、感情、身体、社会秩序、記憶、倫理的変容を作る実践として分析する領域。","impact_summary":"儒教礼論、宗教哲学、社会哲学、パフォーマンス研究、認知科学に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較宗教哲学","era_start":2015,"era_end":null,"keywords_ja":"儀礼哲学,礼,身体,社会秩序","keywords_en":"philosophy of ritual,li,body,social order","key_researchers":["キャサリン・ベル","マイケル・ピュエット","エイミー・オルバーディング"],"key_works":["Ritual Theory, Ritual Practice (1992)","Ritual and Its Consequences (2008)"]},
  {"name_ja":"非西洋感情政治","name_en":"Non-Western Politics of Emotion","definition":"恥、怒り、慈悲、敬、哀れ、屈辱を、植民地経験、共同体、宗教実践、政治動員と結びつけて分析する。","impact_summary":"政治感情論、ポストコロニアル研究、宗教政治、和解論に多元的視点を与えた。","subfield":"東洋・非西洋哲学","school_of_thought":"比較政治感情論","era_start":2015,"era_end":null,"keywords_ja":"感情政治,恥,慈悲,屈辱","keywords_en":"politics of emotion,shame,compassion,humiliation","key_researchers":["マーサ・ヌスバウム","アシス・ナンディ","エイミー・オルバーディング"],"key_works":["Political Emotions (2013)","The Intimate Enemy (1983)"]},
  {"name_ja":"東洋・非西洋美学の世界化","name_en":"Global Non-Western Aesthetics","definition":"ラサ、侘び寂び、書、茶、仮面、音楽、儀礼を通じて、美を西洋芸術制度に限定せず再定義する領域。","impact_summary":"美学、芸術哲学、博物館研究、文化遺産論、デザイン理論を拡張した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較美学","era_start":2015,"era_end":null,"keywords_ja":"非西洋美学,ラサ,侘び寂び,儀礼","keywords_en":"non-Western aesthetics,rasa,wabi-sabi,ritual","key_researchers":["エリオット・ドイッチュ","カーティス・カーター","小田部胤久"],"key_works":["Comparative Aesthetics (2015)","The Routledge Companion to Aesthetics (2013)"]},
  {"name_ja":"非西洋音楽哲学","name_en":"Non-Western Philosophy of Music","definition":"ラーガ、ガムラン、雅楽、アフリカン・リズム、儀礼歌を通じて、音楽を宇宙秩序、共同体、身体と結ぶ領域。","impact_summary":"音楽美学、民族音楽学、身体論、儀礼研究に哲学的枠組みを与えた。","subfield":"東洋・非西洋哲学","school_of_thought":"比較音楽美学","era_start":2015,"era_end":null,"keywords_ja":"音楽哲学,ラーガ,ガムラン,儀礼","keywords_en":"philosophy of music,raga,gamelan,ritual","key_researchers":["ルイス・ロウェル","ジュディス・ベッカー","キフィ・アガウ"],"key_works":["Deep Listeners (2004)","Representing African Music (2003)"]},
  {"name_ja":"アジア映画哲学","name_en":"Asian Film Philosophy","definition":"日本、韓国、中国、インド、イラン映画を通じて、時間、記憶、家族、植民地性、倫理を哲学的に考える領域。","impact_summary":"映画哲学、世界映画研究、美学、政治記憶論にアジア的視点を与えた。","subfield":"東洋・非西洋哲学","school_of_thought":"映像哲学","era_start":2015,"era_end":null,"keywords_ja":"アジア映画哲学,記憶,家族,時間","keywords_en":"Asian film philosophy,cinema,memory,time","key_researchers":["スタンリー・カヴェル","デイヴィッド・マーティン＝ジョーンズ","吉本光宏"],"key_works":["The Oxford Handbook of Japanese Cinema (2014)","Deleuze, Cinema and National Identity (2006)"]},
  {"name_ja":"アフリカ美学","name_en":"African Aesthetics","definition":"仮面、踊り、彫刻、音楽、身体装飾を共同体、祖先、儀礼、機能と結びつけて美の意味を考える哲学領域。","impact_summary":"美学の自律芸術中心主義を批判し、儀礼と共同体に根ざす美の理解を広げた。","subfield":"東洋・非西洋哲学","school_of_thought":"アフリカ美学","era_start":1960,"era_end":null,"keywords_ja":"アフリカ美学,仮面,儀礼,共同体","keywords_en":"African aesthetics,masks,ritual,community","key_researchers":["クワメ・アンソニー・アピア","ロバート・ファリス・トンプソン","ロウランド・アビオドゥン"],"key_works":["African Art in Motion (1974)","Yoruba Art and Language (2014)"]},
  {"name_ja":"イスラーム美学","name_en":"Islamic Aesthetics","definition":"書、幾何学、光、反偶像性、詩、建築を通じて、神の一性と美の経験を結ぶイスラーム芸術哲学。","impact_summary":"建築、美術史、宗教美学、比較芸術哲学に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"イスラーム美学","era_start":800,"era_end":null,"keywords_ja":"イスラーム美学,書,幾何学,光","keywords_en":"Islamic aesthetics,calligraphy,geometry,light","key_researchers":["オレグ・グラバー","セイイェド・ホセイン・ナスル"],"key_works":["The Sense of Unity (1973)","Islamic Art and Spirituality (1987)"]},
  {"name_ja":"中国書の哲学","name_en":"Philosophy of Chinese Calligraphy","definition":"書を文字情報ではなく、気、身体運動、人格、時間性が可視化される実践として捉える中国美学。","impact_summary":"東アジア美学、身体論、芸術教育、人格修養論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"中国美学","era_start":300,"era_end":null,"keywords_ja":"書道哲学,気,身体,人格","keywords_en":"Chinese calligraphy,qi,body,personhood","key_researchers":["王羲之","宗白華","熊秉明"],"key_works":["書譜 (687)","中国美学史 (1980年代)"]},
  {"name_ja":"山水画の哲学","name_en":"Philosophy of Shanshui Painting","definition":"山水を単なる風景でなく、道、気、遊、隠逸、宇宙との関係を表す哲学的空間として理解する中国美学。","impact_summary":"東アジア絵画論、環境美学、空間哲学、自然観に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"中国美学","era_start":900,"era_end":null,"keywords_ja":"山水画,中国美学,気,自然","keywords_en":"shanshui,landscape painting,Chinese aesthetics,qi","key_researchers":["郭熙","石濤","宗炳"],"key_works":["林泉高致 (11世紀)","苦瓜和尚画語録 (1700頃)"]},
  {"name_ja":"茶の湯の哲学","name_en":"Philosophy of Chanoyu","definition":"茶の湯を和敬清寂、身体作法、道具、空間、一期一会を通じた倫理的・美的修養として捉える思想。","impact_summary":"日本美学、礼法、デザイン、国際的な日本文化理解に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"日本美学","era_start":1500,"era_end":null,"keywords_ja":"茶の湯,和敬清寂,一期一会,修養","keywords_en":"chanoyu,tea ceremony,wakei-seijaku,ichigo-ichie","key_researchers":["千利休","岡倉天心","久松真一"],"key_works":["南方録 (17世紀頃)","茶の本 (1906)"]},
  {"name_ja":"弁証法的仏教哲学","name_en":"Dialectical Buddhist Philosophy","definition":"空、二諦、矛盾、否定を用いて、近代弁証法と仏教論理を対話させる比較哲学の潮流。","impact_summary":"京都学派、マルクス主義仏教論、比較論理、社会批判の議論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較仏教哲学","era_start":2015,"era_end":null,"keywords_ja":"弁証法,仏教,空,二諦","keywords_en":"dialectics,Buddhism,emptiness,two truths","key_researchers":["田辺元","西谷啓治","ジェイ・ガーフィールド"],"key_works":["懺悔道としての哲学 (1946)","The Fundamental Wisdom of the Middle Way (1995)"]},
  {"name_ja":"非西洋マルクス主義哲学","name_en":"Non-Western Marxist Philosophy","definition":"マルクス主義を中国、インド、アフリカ、ラテンアメリカの植民地経験、農民、民族解放と接続する思想群。","impact_summary":"反植民地運動、開発国家、解放哲学、第三世界主義に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"第三世界マルクス主義","era_start":1920,"era_end":null,"keywords_ja":"非西洋マルクス主義,民族解放,農民,植民地","keywords_en":"non-Western Marxism,national liberation,peasants,colonialism","key_researchers":["毛沢東","フランツ・ファノン","ホセ・カルロス・マリアテギ"],"key_works":["実践論 (1937)","地に呪われたる者 (1961)"]},
  {"name_ja":"毛沢東の実践論","name_en":"Mao's Theory of Practice","definition":"認識は社会的実践から生まれ、再び実践で検証されるとする毛沢東のマルクス主義認識論。","impact_summary":"中国革命理論、第三世界マルクス主義、教育運動、実践哲学に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"中国マルクス主義","era_start":1937,"era_end":null,"keywords_ja":"実践論,毛沢東,認識論,革命","keywords_en":"Mao,practice,epistemology,revolution","key_researchers":["毛沢東"],"key_works":["実践論 (1937)","矛盾論 (1937)"]},
  {"name_ja":"矛盾論","name_en":"Mao's Theory of Contradiction","definition":"矛盾を事物発展の普遍法則とし、主要矛盾と副次矛盾の分析により政治戦略を導く毛沢東の弁証法。","impact_summary":"中国革命、政治哲学、マルクス主義理論、社会分析の語彙に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"中国マルクス主義","era_start":1937,"era_end":null,"keywords_ja":"矛盾論,毛沢東,弁証法,主要矛盾","keywords_en":"contradiction,Mao,dialectics,principal contradiction","key_researchers":["毛沢東"],"key_works":["矛盾論 (1937)"]},
  {"name_ja":"マリアテギのインディヘニスモ社会主義","name_en":"Mariategui's Indigenous Socialism","definition":"ペルーの先住民共同体とマルクス主義を結び、欧州モデルの機械的輸入を拒むラテンアメリカ社会哲学。","impact_summary":"ラテンアメリカ・マルクス主義、先住民政治、解放思想に強い影響を与えた。","subfield":"東洋・非西洋哲学","school_of_thought":"ラテンアメリカ社会思想","era_start":1928,"era_end":null,"keywords_ja":"マリアテギ,インディヘニスモ,社会主義,先住民","keywords_en":"Mariategui,Indigenous socialism,Latin America,Marxism","key_researchers":["ホセ・カルロス・マリアテギ"],"key_works":["ペルーの現実解釈のための七試論 (1928)"]},
  {"name_ja":"ファノンの脱植民地主体論","name_en":"Fanonian Decolonial Subjectivity","definition":"植民地化が身体、言語、欲望、暴力を通じて主体を形成する過程を分析し、解放の主体生成を論じる思想。","impact_summary":"ポストコロニアル理論、黒人実存主義、解放心理学、政治暴力論に大きな影響を与えた。","subfield":"東洋・非西洋哲学","school_of_thought":"反植民地哲学","era_start":1952,"era_end":null,"keywords_ja":"ファノン,脱植民地,主体性,暴力","keywords_en":"Fanon,decolonization,subjectivity,violence","key_researchers":["フランツ・ファノン"],"key_works":["黒い皮膚・白い仮面 (1952)","地に呪われたる者 (1961)"]},
  {"name_ja":"アシス・ナンディの近代批判","name_en":"Ashis Nandy's Critique of Modernity","definition":"植民地主義が被支配者と支配者双方の心理を変形し、近代的合理性が暴力と結びつく過程を批判する思想。","impact_summary":"南アジア政治心理、ポストコロニアル理論、世俗主義批判、暴力論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"インド・ポストコロニアル思想","era_start":1983,"era_end":null,"keywords_ja":"近代批判,ナンディ,植民地心理,暴力","keywords_en":"Ashis Nandy,modernity,colonial psychology,violence","key_researchers":["アシス・ナンディ"],"key_works":["The Intimate Enemy (1983)"]},
