  {"name_ja":"チャクラバルティのヨーロッパ地方化","name_en":"Provincializing Europe","definition":"ヨーロッパを普遍的歴史主体でなく一つの地域的経験として位置づけ、近代性の複数性を示す歴史哲学。","impact_summary":"ポストコロニアル歴史学、近代性論、世界哲学、社会理論に大きな影響を与えた。","subfield":"東洋・非西洋哲学","school_of_thought":"ポストコロニアル歴史哲学","era_start":2000,"era_end":null,"keywords_ja":"ヨーロッパ地方化,近代性,歴史哲学,ポストコロニアル","keywords_en":"Provincializing Europe,modernity,history,postcolonial","key_researchers":["ディペシュ・チャクラバルティ"],"key_works":["Provincializing Europe (2000)"]},
  {"name_ja":"複数近代論","name_en":"Multiple Modernities","definition":"近代化を西洋化の単線過程でなく、文明ごとの制度、宗教、文化が生む複数の近代として捉える理論。","impact_summary":"東アジア近代、イスラーム近代、比較社会理論、ポストコロニアル研究に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較近代論","era_start":2000,"era_end":null,"keywords_ja":"複数近代,近代性,文明,比較","keywords_en":"multiple modernities,modernity,civilizations,comparison","key_researchers":["S・N・アイゼンシュタット","杜維明"],"key_works":["Multiple Modernities (2000)","Confucian Traditions in East Asian Modernity (1996)"]},
  {"name_ja":"アジア間思想","name_en":"Inter-Asia Thought","definition":"アジアを西洋との対比だけでなく、植民地、冷戦、移動、翻訳を通じた地域間の相互参照として考える潮流。","impact_summary":"アジア研究、ポストコロニアル理論、地域思想史、文化研究の方法論を変えた。","subfield":"東洋・非西洋哲学","school_of_thought":"インターアジア文化研究","era_start":2015,"era_end":null,"keywords_ja":"アジア間思想,地域間,翻訳,冷戦","keywords_en":"Inter-Asia thought,regionality,translation,Cold War","key_researchers":["陳光興","孫歌"],"key_works":["Asia as Method (2010)","Inter-Asia Cultural Studies Reader (2015)"]},
  {"name_ja":"アジア・アズ・メソッド","name_en":"Asia as Method","definition":"アジアを研究対象でなく、相互参照と脱帝国化の方法として用い、西洋中心の理論依存を減らす思想方法。","impact_summary":"文化研究、比較思想、脱植民地方法論、アジア知識共同体の形成に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"インターアジア思想","era_start":2010,"era_end":null,"keywords_ja":"アジアアズメソッド,脱帝国化,相互参照,方法論","keywords_en":"Asia as Method,inter-referencing,deimperialization,methodology","key_researchers":["陳光興"],"key_works":["Asia as Method (2010)"]},
  {"name_ja":"脱帝国化","name_en":"Deimperialization","definition":"植民地支配を受けた側だけでなく、帝国を形成した社会が自らの歴史、知識、主体性を批判的に解体する過程。","impact_summary":"東アジア歴史和解、日本帝国批判、台湾・韓国研究、脱植民地理論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"インターアジア思想","era_start":2010,"era_end":null,"keywords_ja":"脱帝国化,帝国批判,東アジア,歴史責任","keywords_en":"deimperialization,empire critique,East Asia,historical responsibility","key_researchers":["陳光興","孫歌","冨山一郎"],"key_works":["Asia as Method (2010)","近代日本社会と沖縄人 (1990)"]},
  {"name_ja":"非西洋記憶哲学","name_en":"Non-Western Philosophy of Memory","definition":"植民地暴力、祖先、戦争、口承、慰霊を通じて、記憶を個人心理でなく共同体的責任として考える領域。","impact_summary":"歴史和解、移行期正義、先住民研究、東アジア戦争記憶論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較記憶哲学","era_start":2015,"era_end":null,"keywords_ja":"記憶哲学,祖先,植民地暴力,和解","keywords_en":"philosophy of memory,ancestors,colonial violence,reconciliation","key_researchers":["ポール・リクール","アシル・ムベンベ","高橋哲哉"],"key_works":["記憶・歴史・忘却 (2000)","靖国問題 (2005)"]},
  {"name_ja":"祖先倫理","name_en":"Ancestor Ethics","definition":"死者や祖先を現在の共同体の道徳的関係者として扱い、責任、継承、記憶、土地との関係を論じる倫理。","impact_summary":"アフリカ哲学、先住民思想、東アジア祭祀、環境倫理、死生学に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較倫理","era_start":2015,"era_end":null,"keywords_ja":"祖先倫理,死者,記憶,土地","keywords_en":"ancestor ethics,dead,memory,land","key_researchers":["ジョン・ムビティ","ロビン・ウォール・キマラー","和辻哲郎"],"key_works":["African Religions and Philosophy (1969)","Braiding Sweetgrass (2013)"]},
  {"name_ja":"ポスト世俗アジア思想","name_en":"Postsecular Asian Thought","definition":"宗教が公共圏から消えるという世俗化論を問い直し、アジアの宗教、国家、市民社会の関係を再考する潮流。","impact_summary":"宗教政治、公共哲学、多文化主義、イスラーム・仏教・ヒンドゥー研究に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"ポスト世俗思想","era_start":2015,"era_end":null,"keywords_ja":"ポスト世俗,アジア,公共宗教,市民社会","keywords_en":"postsecular Asian thought,public religion,civil society,secularity","key_researchers":["タラル・アサド","ラージーヴ・バルガヴァ","ホセ・カサノヴァ"],"key_works":["Formations of the Secular (2003)","Secularism and Its Critics (1998)"]},
  {"name_ja":"アジア的公共理性","name_en":"Asian Public Reason","definition":"公共的正当化を西洋リベラリズムの形式に限定せず、儒教、仏教、イスラーム、多宗教社会の理由づけから考える。","impact_summary":"公共哲学、民主主義論、宗教的多元主義、アジア憲法論に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較政治哲学","era_start":2015,"era_end":null,"keywords_ja":"公共理性,アジア,宗教,民主主義","keywords_en":"Asian public reason,religion,democracy,pluralism","key_researchers":["ラージーヴ・バルガヴァ","ジョセフ・チャン","ダニエル・A・ベル"],"key_works":["Secularism and Its Critics (1998)","Confucian Perfectionism (2014)"]},
  {"name_ja":"非西洋法哲学","name_en":"Non-Western Philosophy of Law","definition":"シャリーア、ダルマ、礼、慣習法、先住民法を通じて、法を国家制定法に還元しない多元的法秩序として考える。","impact_summary":"法多元主義、人権、先住民権利、比較法哲学、宗教法研究に影響した。","subfield":"東洋・非西洋哲学","school_of_thought":"比較法哲学","era_start":2015,"era_end":null,"keywords_ja":"非西洋法哲学,法多元主義,シャリーア,ダルマ","keywords_en":"non-Western legal philosophy,legal pluralism,sharia,dharma","key_researchers":["ワエル・ハッラーク","ヴェルナー・メンスキー","ジョン・ボロウズ"],"key_works":["An Introduction to Islamic Law (2009)","Comparative Law in a Global Context (2006)"]},
