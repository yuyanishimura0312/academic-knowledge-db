    "era_start": 1964,
    "era_end": null,
    "keywords_en": "kin selection,inclusive fitness,Hamilton rule",
    "key_researchers": ["W. D. Hamilton"]
  },
  {
    "name_ja": "包括適応度",
    "name_en": "Inclusive Fitness",
    "definition": "個体自身の繁殖による直接適応度と、血縁者を通じた間接的な遺伝的寄与を合わせて評価する概念。利他性、協力、真社会性などの進化を、遺伝子共有率と費用便益の関係から分析する枠組みである。",
    "subfield": "進化・遺伝学",
    "school_of_thought": "社会進化論",
    "era_start": 1964,
    "era_end": null,
    "keywords_en": "inclusive fitness,altruism,relatedness",
    "key_researchers": ["W. D. Hamilton"]
  },
  {
    "name_ja": "親の投資",
