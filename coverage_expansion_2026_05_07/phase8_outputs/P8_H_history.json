  },
  {
    "name_ja": "新文化史",
    "name_en": "New Cultural History",
    "definition": "文化を高級芸術や思想の集合ではなく、象徴、言説、儀礼、身体、表象、日常実践を通じて社会的意味が作られる場として捉える歴史研究。社会構造の説明に加えて、意味の生成や権力との結びつきを分析する点に特徴がある。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "文化論的転回",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "representation,symbolic practice",
    "key_researchers": ["Lynn Hunt", "Robert Darnton", "Roger Chartier"]
  },
  {
    "name_ja": "文化論的転回",
    "name_en": "Cultural Turn",
    "definition": "歴史研究において経済構造や制度だけでなく、言語、表象、象徴、アイデンティティ、記憶、身体、意味づけの過程を重視するようになった知的転換。社会的現実は単に反映されるのではなく、言説や実践を通じて構成されると考える。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "ポスト構造主義",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "language,representation",
    "key_researchers": ["Michel Foucault", "Lynn Hunt", "Hayden White"]
  },
  {
    "name_ja": "言語論的転回",
    "name_en": "Linguistic Turn",
    "definition": "歴史叙述は過去の事実を透明に写すものではなく、言語、物語形式、比喩、概念枠組みによって構成されるという認識を広めた転回。史料も叙述も言語的媒介を免れないため、歴史家の語り方そのものが分析対象となる。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "ポストモダン歴史論",
