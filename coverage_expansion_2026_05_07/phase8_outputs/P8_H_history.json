  },
  {
    "name_ja": "歴史的因果性",
    "name_en": "Historical Causation",
    "definition": "歴史上の出来事がどのような条件、構造、意図、偶然、制度、環境の組み合わせによって生じたのかを説明するための概念。単一原因ではなく、多層的で相互作用的な因果連鎖を扱うため、説明の尺度や反事実推論も重要となる。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "分析的歴史哲学",
    "era_start": 1940,
    "era_end": null,
    "keywords_en": "causality,explanation",
    "key_researchers": ["Carl Hempel", "William Dray", "Arthur Danto"]
  },
  {
    "name_ja": "反事実歴史",
    "name_en": "Counterfactual History",
    "definition": "もし特定の出来事や決定が異なっていたなら歴史はどう展開したかを検討し、因果関係や偶然性の重みを明らかにする方法。娯楽的な仮想史とは異なり、実際に可能だった選択肢や条件に基づいて歴史説明を検証する。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "分析的歴史哲学",
