  {
    "name_ja": "ビッグヒストリー",
    "name_en": "Big History",
    "definition": "宇宙の誕生から生命、人類、文明、現代社会までを一続きの時間軸で扱う広域的な歴史叙述。自然科学と人文社会科学を横断し、エネルギー、複雑性、閾値、環境変化などを軸に、人間史を地球史・宇宙史の中に位置づける。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "グローバル史",
    "era_start": 1989,
    "era_end": null,
    "keywords_en": "cosmic evolution,complexity",
    "key_researchers": ["David Christian", "Fred Spier", "Cynthia Stokes Brown"]
  },
  {
    "name_ja": "気候史",
    "name_en": "Climate History",
    "definition": "気温、降水、旱魃、寒冷化、火山噴火、海流変動などの気候要因が社会、農業、疫病、戦争、移住、国家形成に与えた影響を研究する分野。自然環境を歴史の背景ではなく、制度や文化と相互作用する能動的条件として分析する。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "環境史",
    "era_start": 1960,
    "era_end": null,
    "keywords_en": "climate change,environmental history",
    "key_researchers": ["Emmanuel Le Roy Ladurie", "Geoffrey Parker", "John L. Brooke"]
  },
  {
    "name_ja": "感情史",
    "name_en": "History of Emotions",
    "definition": "怒り、恐怖、愛、悲嘆、羞恥、共感などの感情が、時代や社会によってどのように規範化され、表現され、政治や宗教、家族、身体観と結びついたかを研究する領域。感情を普遍的心理ではなく、言語・制度・実践に媒介された歴史的現象として扱う。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "文化史",
    "era_start": 1985,
    "era_end": null,
    "keywords_en": "emotional regimes,affect",
    "key_researchers": ["Barbara H. Rosenwein", "William M. Reddy", "Ute Frevert"]
  },
  {
    "name_ja": "ミクロストリア",
    "name_en": "Microhistory",
    "definition": "小さな共同体、個人、裁判記録、事件などを精密に分析し、そこから広い社会構造や文化的意味を読み解く歴史研究の方法。対象の規模を縮小することで、通常の大きな叙述では見落とされる交渉、矛盾、偶然性、権力関係を浮かび上がらせる。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "イタリア・ミクロストリア",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "scale,thick description",
    "key_researchers": ["Carlo Ginzburg", "Giovanni Levi", "Natalie Zemon Davis"]
  },
  {
    "name_ja": "歴史主義",
    "name_en": "Historicism",
    "definition": "社会、制度、思想、価値を普遍的・抽象的な原理からではなく、それぞれの時代固有の文脈と発展過程の中で理解しようとする立場。歴史的個別性を重視する一方、時に相対主義や発展法則への過度な依存をめぐって批判の対象にもなった。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "ドイツ歴史学派",
    "era_start": 1820,
    "era_end": null,
    "keywords_en": "contextualism,historical specificity",
    "key_researchers": ["Leopold von Ranke", "Friedrich Meinecke", "Johann Gustav Droysen"]
  },
  {
    "name_ja": "実証主義史学",
    "name_en": "Positivist Historiography",
    "definition": "史料批判、文書証拠、事実確認、年代順叙述を重んじ、歴史研究を経験的根拠に基づく学問として確立しようとする方法。客観的な事実復元を理想としたが、後には史料選択や叙述そのものに含まれる価値判断を軽視していると批判された。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "実証主義",
    "era_start": 1830,
    "era_end": null,
    "keywords_en": "source criticism,empiricism",
    "key_researchers": ["Leopold von Ranke", "Charles-Victor Langlois", "Charles Seignobos"]
  },
  {
    "name_ja": "アナール学派",
    "name_en": "Annales School",
    "definition": "政治事件中心の歴史叙述を批判し、社会構造、経済、地理、人口、心性、長期持続を重視したフランス発の歴史学潮流。歴史を諸社会科学と結びつけ、短期の出来事だけでなく、ゆっくり変化する生活世界や制度の層を分析対象にした。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "アナール学派",
    "era_start": 1929,
    "era_end": null,
    "keywords_en": "longue duree,social history",
    "key_researchers": ["Marc Bloch", "Lucien Febvre", "Fernand Braudel"]
  },
  {
    "name_ja": "長期持続",
    "name_en": "Longue Duree",
    "definition": "歴史を短期の事件や個人の行為だけでなく、地理、気候、交易路、社会構造、生活慣行のように長い時間をかけて変化する層から捉える概念。政治的出来事の背後にある緩慢な制約や反復を分析するための時間論である。",
    "subfield": "歴史学・歴史哲学",
    "school_of_thought": "アナール学派",
    "era_start": 1949,
    "era_end": null,
    "keywords_en": "long duration,structures",
    "key_researchers": ["Fernand Braudel", "Marc Bloch", "Emmanuel Le Roy Ladurie"]
  },
  {
    "name_ja": "社会史",
    "name_en": "Social History",
    "definition": "王侯や政治家、戦争、外交だけでなく、労働者、農民、家族、都市、日常生活、階級、ジェンダー、共同体などを対象に社会の構造と変化を研究する分野。歴史を上からの政治叙述から解放し、普通の人々の経験を分析に含めた。",
    "subfield": "歴史学・歴史哲学",
