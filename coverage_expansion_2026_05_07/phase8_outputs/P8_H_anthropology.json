[
  {
    "name_ja": "文化相対主義",
    "name_en": "Cultural Relativism",
    "definition": "文化相対主義は、価値観や制度や慣習を普遍的な尺度で優劣づけるのではなく、それぞれの歴史的・社会的文脈の中で理解しようとする立場である。植民地主義的偏見や進化主義的序列化への批判として発展した。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "ボアズ学派",
    "era_start": 1910,
    "era_end": null,
    "keywords_en": "relativism,culture,context",
    "key_researchers": ["Franz Boas", "Ruth Benedict"]
  },
  {
    "name_ja": "参与観察",
    "name_en": "Participant Observation",
    "definition": "参与観察は、研究者が調査地の日常生活に参加しながら観察し、会話や実践や沈黙を含む社会的経験を記録する民族誌的方法である。外部からの観察だけでなく、身体的関与を通じて意味生成を理解する点に特徴がある。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "フィールドワーク人類学",
    "era_start": 1920,
    "era_end": null,
    "keywords_en": "fieldwork,ethnography,method",
    "key_researchers": ["Bronislaw Malinowski"]
  },
  {
    "name_ja": "厚い記述",
    "name_en": "Thick Description",
    "definition": "厚い記述は、行為を単なる外形的事実としてではなく、当事者が共有する象徴体系や状況的含意の中で解釈する民族誌的記述である。身振りや儀礼の意味を多層的に読み解き、文化を解釈可能なテキストとして扱う。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "解釈人類学",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "thick description,interpretation,meaning",
    "key_researchers": ["Clifford Geertz"]
  },
  {
    "name_ja": "構造機能主義",
    "name_en": "Structural Functionalism",
    "definition": "構造機能主義は、親族、政治、宗教、法などの制度を社会全体の秩序維持に果たす機能から分析する立場である。個人心理よりも社会構造の持続性を重視し、制度間の相互依存を民族誌的に説明した。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "英国社会人類学",
    "era_start": 1930,
    "era_end": null,
    "keywords_en": "structure,function,social order",
    "key_researchers": ["A. R. Radcliffe-Brown", "E. E. Evans-Pritchard"]
  },
  {
    "name_ja": "機能主義",
    "name_en": "Functionalism",
    "definition": "機能主義は、文化制度や慣習を人間の基本的欲求や社会生活の実践的要請に応答するものとして分析する理論である。儀礼や経済や親族を孤立した要素ではなく、生活世界を成り立たせる働きとして捉えた。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "機能主義人類学",
    "era_start": 1920,
    "era_end": null,
    "keywords_en": "function,needs,institutions",
    "key_researchers": ["Bronislaw Malinowski"]
  },
  {
    "name_ja": "構造主義",
    "name_en": "Structuralism",
    "definition": "構造主義は、神話、親族、分類、料理などの文化現象の背後にある二項対立や変換規則を分析する立場である。表面的な差異の下に人間精神の普遍的構造を見いだし、文化を関係体系として理解した。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "フランス構造主義",
    "era_start": 1950,
    "era_end": null,
    "keywords_en": "structure,myth,binary opposition",
    "key_researchers": ["Claude Levi-Strauss"]
  },
  {
    "name_ja": "解釈人類学",
    "name_en": "Interpretive Anthropology",
    "definition": "解釈人類学は、文化を人びとが意味を編み込む象徴的秩序として捉え、民族誌をその意味の解釈として位置づける潮流である。社会を法則的に説明するよりも、当事者にとって世界がどのように意味づけられるかを重視する。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "解釈人類学",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "interpretation,symbols,meaning",
    "key_researchers": ["Clifford Geertz", "Victor Turner"]
  },
  {
    "name_ja": "象徴人類学",
    "name_en": "Symbolic Anthropology",
    "definition": "象徴人類学は、儀礼、神話、色彩、身体表現などを社会的意味を担う象徴として分析する分野である。象徴が社会秩序を表現するだけでなく、感情、葛藤、変化を媒介し、共同体の経験を組織する点を明らかにする。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "象徴人類学",
    "era_start": 1960,
    "era_end": null,
    "keywords_en": "symbols,ritual,meaning",
    "key_researchers": ["Victor Turner", "Mary Douglas"]
  },
  {
    "name_ja": "儀礼過程",
    "name_en": "Ritual Process",
    "definition": "儀礼過程は、通過儀礼や社会的危機の場面で人びとが通常の秩序から離れ、境界状態を経て新たな位置へ移行する過程を分析する概念である。リミナリティやコミュニタスを通じて、社会構造と変容の関係を説明する。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "象徴人類学",
    "era_start": 1960,
    "era_end": null,
    "keywords_en": "ritual,liminality,communitas",
    "key_researchers": ["Victor Turner", "Arnold van Gennep"]
  },
  {
    "name_ja": "リミナリティ",
    "name_en": "Liminality",
    "definition": "リミナリティは、通過儀礼や社会的移行において、既存の地位や分類から一時的に外れた境界的状態を指す。そこでは秩序が宙吊りになり、通常は抑制される関係性や創造性が現れ、再統合や変化の契機となる。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "儀礼研究",
    "era_start": 1909,
    "era_end": null,
    "keywords_en": "liminality,transition,ritual",
    "key_researchers": ["Arnold van Gennep", "Victor Turner"]
  },
  {
    "name_ja": "コミュニタス",
    "name_en": "Communitas",
    "definition": "コミュニタスは、リミナルな状況で身分や階層の差異が一時的に弱まり、直接的で平等的な結びつきが生じる状態を指す。巡礼、祭礼、社会運動などで現れ、構造化された社会秩序に対する批判的契機を含む。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "象徴人類学",
    "era_start": 1969,
    "era_end": null,
    "keywords_en": "communitas,liminality,solidarity",
    "key_researchers": ["Victor Turner"]
  },
  {
    "name_ja": "親族体系",
    "name_en": "Kinship System",
    "definition": "親族体系は、血縁、婚姻、養子、系譜、呼称、相続などを通じて社会関係を組織する仕組みである。家族を自然な単位として前提にせず、関係の作り方や義務、交換、政治秩序との結びつきを比較分析する。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "親族研究",
    "era_start": 1870,
    "era_end": null,
    "keywords_en": "kinship,descent,marriage",
    "key_researchers": ["Lewis Henry Morgan", "Claude Levi-Strauss"]
  },
  {
    "name_ja": "贈与交換",
    "name_en": "Gift Exchange",
    "definition": "贈与交換は、物やサービスのやり取りが単なる経済取引ではなく、義務、名誉、負債、連帯、競争を生み出す社会的実践であることを示す概念である。贈る、受け取る、返礼するという循環が関係を形成する。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "交換理論",
    "era_start": 1925,
    "era_end": null,
    "keywords_en": "gift,exchange,reciprocity",
    "key_researchers": ["Marcel Mauss", "Annette Weiner"]
  },
  {
    "name_ja": "互酬性",
    "name_en": "Reciprocity",
    "definition": "互酬性は、贈与、労働、食物、情報などの交換が、即時の等価交換ではなく長期的な関係や道徳的義務を通じて維持される仕組みである。一般化された互酬、均衡的互酬、否定的互酬などの類型で分析される。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "経済人類学",
    "era_start": 1960,
    "era_end": null,
    "keywords_en": "reciprocity,exchange,obligation",
    "key_researchers": ["Marshall Sahlins", "Marcel Mauss"]
  },
  {
    "name_ja": "ポトラッチ",
    "name_en": "Potlatch",
    "definition": "ポトラッチは、北西海岸先住民社会に見られる競争的贈与儀礼を指し、富の破壊や分配を通じて名誉、地位、権威を構築する実践として分析されてきた。経済合理性だけでは説明できない贈与と権力の関係を示す。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "贈与論",
    "era_start": 1920,
    "era_end": null,
    "keywords_en": "potlatch,gift,status",
    "key_researchers": ["Franz Boas", "Marcel Mauss"]
  },
  {
    "name_ja": "クラ交換",
    "name_en": "Kula Exchange",
    "definition": "クラ交換は、トロブリアンド諸島周辺で貝製装飾品が反対方向に循環する広域交換制度である。実用品の取引とは異なり、名声、航海、同盟、物語を結びつける制度として、経済と社会関係の不可分性を示した。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "機能主義人類学",
    "era_start": 1922,
    "era_end": null,
    "keywords_en": "kula,exchange,prestige",
    "key_researchers": ["Bronislaw Malinowski"]
  },
  {
    "name_ja": "サブスタンティヴィズム",
    "name_en": "Substantivism",
    "definition": "サブスタンティヴィズムは、経済を市場合理性や利潤最大化だけで捉えず、親族、宗教、政治、道徳に埋め込まれた生活維持の制度として理解する立場である。形式主義的な普遍経済モデルへの批判として展開した。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "経済人類学",
    "era_start": 1940,
    "era_end": null,
    "keywords_en": "substantivism,economy,embeddedness",
    "key_researchers": ["Karl Polanyi", "George Dalton"]
  },
  {
    "name_ja": "形式主義",
    "name_en": "Formalism",
    "definition": "形式主義は、人間が希少資源を合理的に配分する主体であるという経済学的前提を、非市場社会を含む多様な社会に適用できるとする立場である。サブスタンティヴィズムとの論争を通じて経済人類学の理論的焦点となった。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "経済人類学",
    "era_start": 1950,
    "era_end": null,
    "keywords_en": "formalism,rational choice,economy",
    "key_researchers": ["Raymond Firth", "Harold Schneider"]
  },
  {
    "name_ja": "政治人類学",
    "name_en": "Political Anthropology",
    "definition": "政治人類学は、国家、首長制、ビッグマン制、紛争解決、権威、支配、抵抗などを民族誌的に分析する分野である。公式制度だけでなく、儀礼、親族、贈与、暴力、言説を通じた権力の生成を扱う。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "政治人類学",
    "era_start": 1940,
    "era_end": null,
    "keywords_en": "power,authority,politics",
    "key_researchers": ["E. E. Evans-Pritchard", "Max Gluckman"]
  },
  {
    "name_ja": "分節リネージ体系",
    "name_en": "Segmentary Lineage System",
    "definition": "分節リネージ体系は、共通祖先をもつ系譜集団が状況に応じて分裂や連合を行い、政治的対立や協力を組織する仕組みである。国家をもたない社会の秩序形成を説明する概念として、ヌアー研究などで重要となった。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "英国社会人類学",
    "era_start": 1940,
    "era_end": null,
    "keywords_en": "lineage,segmentation,politics",
    "key_researchers": ["E. E. Evans-Pritchard", "Meyer Fortes"]
  },
  {
    "name_ja": "首長制",
    "name_en": "Chiefdom",
    "definition": "首長制は、親族や儀礼的権威に基づき、首長が再分配、調停、戦争、祭祀を担う政治組織の形態である。国家ほど官僚化されていないが、平等主義的集団よりも階層化された社会として比較研究されてきた。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "政治人類学",
    "era_start": 1950,
    "era_end": null,
    "keywords_en": "chiefdom,redistribution,hierarchy",
    "key_researchers": ["Elman Service", "Marshall Sahlins"]
  },
  {
    "name_ja": "ビッグマン制",
    "name_en": "Big Man System",
    "definition": "ビッグマン制は、世襲的地位ではなく、贈与、弁舌、労働動員、同盟形成によって影響力を獲得する指導者のあり方を指す。メラネシア研究で重視され、権力が固定制度ではなく関係的成果として生じることを示す。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "政治人類学",
    "era_start": 1960,
    "era_end": null,
    "keywords_en": "big man,leadership,prestige",
    "key_researchers": ["Marshall Sahlins", "Maurice Godelier"]
  },
  {
    "name_ja": "ジェンダー人類学",
    "name_en": "Anthropology of Gender",
    "definition": "ジェンダー人類学は、性差、役割、身体、労働、親族、権力、欲望が文化的・歴史的に構成される過程を研究する。女性の経験を補足するだけでなく、男性性、クィア性、交差性を含む関係的な権力編成を分析する。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "フェミニスト人類学",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "gender,feminism,power",
    "key_researchers": ["Sherry Ortner", "Gayle Rubin"]
  },
  {
    "name_ja": "フェミニスト人類学",
    "name_en": "Feminist Anthropology",
    "definition": "フェミニスト人類学は、民族誌の対象、方法、理論に埋め込まれた男性中心主義を批判し、性別化された権力関係と知識生産を問い直す潮流である。研究者の位置性や調査協力者との関係も反省的に扱う。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "フェミニスト人類学",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "feminism,ethnography,reflexivity",
    "key_researchers": ["Michelle Rosaldo", "Henrietta Moore"]
  },
  {
    "name_ja": "身体技法",
    "name_en": "Techniques of the Body",
    "definition": "身体技法は、歩く、眠る、食べる、泳ぐ、出産するなどの身体行為が自然な動作ではなく、社会的に学習される技術であることを示す概念である。身体を文化が刻み込まれる場として捉え、習慣と社会秩序を結びつける。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "身体人類学",
    "era_start": 1934,
    "era_end": null,
    "keywords_en": "body,technique,habitus",
    "key_researchers": ["Marcel Mauss", "Pierre Bourdieu"]
  },
  {
    "name_ja": "ハビトゥス",
    "name_en": "Habitus",
    "definition": "ハビトゥスは、社会的経験を通じて身体化された知覚、判断、行為の傾向性を指す。個人の自由な選択と構造的決定の中間に位置し、階級、趣味、身振り、生活様式がどのように再生産されるかを説明する。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "実践理論",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "habitus,practice,embodiment",
    "key_researchers": ["Pierre Bourdieu"]
  },
  {
    "name_ja": "実践理論",
    "name_en": "Practice Theory",
    "definition": "実践理論は、社会構造と個人行為を対立的に扱うのではなく、日常的実践を通じて構造が再生産され、同時に変化する過程を分析する立場である。規則、身体化、戦略、権力を結びつけて文化を動態的に捉える。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "実践理論",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "practice,agency,structure",
    "key_researchers": ["Pierre Bourdieu", "Sherry Ortner"]
  },
  {
    "name_ja": "エージェンシー",
    "name_en": "Agency",
    "definition": "エージェンシーは、個人や集団が構造的制約の中で意味を解釈し、選択し、交渉し、時に抵抗や変革を行う能力を指す。人類学では、権力に完全に決定されない行為主体性を、歴史や身体や関係性の中で検討する。",
    "subfield": "文化人類学・民族誌",
    "school_of_thought": "実践理論",
    "era_start": 1980,
    "era_end": null,
    "keywords_en": "agency,subjectivity,practice",
    "key_researchers": ["Sherry Ortner", "Saba Mahmood"]
  },
  {
    "name_ja": "ポストコロニアル人類学",
    "name_en": "Postcolonial Anthropology",
    "definition": "ポストコロニアル人類学は、人類学の知識生産が植民地主義、帝国、開発、他者表象とどのように関わってきたかを批判的に検討する。被調査者を受動的対象とせず、歴史的暴力や翻訳の政治を分析に含める。",
    "subfield": "文化人類学・民族誌",
