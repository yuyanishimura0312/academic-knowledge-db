    "subfield": "言語学",
    "school_of_thought": "実験音声学",
    "era_start": 1880,
    "era_end": null,
    "keywords_en": "articulation,acoustics",
    "key_researchers": ["Daniel Jones", "Peter Ladefoged"]
  },
  {
