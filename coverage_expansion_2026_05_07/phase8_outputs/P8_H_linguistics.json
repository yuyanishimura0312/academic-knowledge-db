    "subfield": "言語学",
    "school_of_thought": "音韻理論",
    "era_start": 1920,
    "era_end": null,
    "keywords_en": "phoneme,prosody",
    "key_researchers": ["Nikolai Trubetzkoy", "Morris Halle"]
  },
  {
    "name_ja": "音声学",
    "name_en": "Phonetics",
