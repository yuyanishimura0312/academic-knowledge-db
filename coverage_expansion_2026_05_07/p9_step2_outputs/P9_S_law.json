[
  {
    "name_ja": "AI法学",
    "name_en": "AI Law",
    "definition": "人工知能の開発、利用、責任、透明性、差別、知的財産、行政判断、司法支援などを法的に扱う領域。技術革新を促進しつつ、権利侵害や説明不能な意思決定を抑制する制度設計を検討する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "技術法学",
    "era_start": 2010,
    "era_end": null,
    "keywords_en": "artificial intelligence,algorithmic accountability",
    "key_researchers": ["Ryan Calo", "Mireille Hildebrandt"]
  },
  {
    "name_ja": "プライバシー法",
    "name_en": "Privacy Law",
    "definition": "個人情報、私生活、通信、身体、位置情報、データ処理に関する権利と義務を定める法領域。国家監視や企業によるデータ利用に対して、同意、目的限定、透明性、救済を通じて人格的自律を保護する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "情報法学",
    "era_start": 1890,
    "era_end": null,
    "keywords_en": "privacy,data protection",
    "key_researchers": ["Samuel Warren", "Louis Brandeis", "Daniel Solove"]
  },
  {
    "name_ja": "プラットフォーム責任",
    "name_en": "Platform Liability",
    "definition": "検索、SNS、マーケットプレイス、動画共有などの媒介者が、利用者投稿、違法取引、名誉毀損、差別広告、偽情報にどこまで責任を負うかを問う概念。表現の自由と被害救済の均衡が中心課題となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "情報法学",
    "era_start": 1996,
    "era_end": null,
    "keywords_en": "platforms,intermediary liability",
    "key_researchers": ["Jack Balkin", "Daphne Keller"]
  },
  {
    "name_ja": "気候訴訟",
    "name_en": "Climate Litigation",
    "definition": "国家や企業に対し、温室効果ガス削減、気候適応、人権保護、投資リスク開示などを求める訴訟実践。環境法、憲法、人権法、不法行為法を結び、司法が気候政策に関与する限界を問う。",
    "subfield": "法学・法哲学",
    "school_of_thought": "環境法学",
    "era_start": 1990,
    "era_end": null,
    "keywords_en": "climate change,litigation",
    "key_researchers": ["Jacqueline Peel", "Hari Osofsky"]
  },
  {
    "name_ja": "法現実主義",
    "name_en": "Legal Realism",
    "definition": "法を抽象的な規則体系としてではなく、裁判官、行政官、社会的権力、制度的慣行によって実際に運用されるものとして理解する立場。判決の予測可能性、事実認定、政策判断を重視する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "Legal Realism",
    "era_start": 1920,
    "era_end": null,
    "keywords_en": "legal realism,judicial behavior",
    "key_researchers": ["Oliver Wendell Holmes Jr.", "Karl Llewellyn", "Jerome Frank"]
  },
  {
    "name_ja": "自然法",
    "name_en": "Natural Law",
    "definition": "人間の理性、自然、本性、神法、道徳秩序に基づいて、実定法を超える正義の基準が存在すると考える法思想。悪法も法かという問題に対し、法の妥当性と道徳的正当性の結合を主張する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "自然法論",
    "era_start": -400,
    "era_end": null,
    "keywords_en": "natural law,morality",
    "key_researchers": ["Thomas Aquinas", "John Finnis"]
  },
  {
    "name_ja": "法実証主義",
    "name_en": "Legal Positivism",
    "definition": "法の妥当性は、その内容の道徳性ではなく、承認規則、制定手続、社会的事実によって決まるとする立場。法と道徳を概念的に区別し、法体系の構造と権威の成立条件を分析する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "法実証主義",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "legal positivism,separation thesis",
    "key_researchers": ["John Austin", "H. L. A. Hart", "Joseph Raz"]
  },
  {
    "name_ja": "法解釈",
    "name_en": "Legal Interpretation",
    "definition": "憲法、法律、契約、判例などの意味を具体的事件に適用できる形で確定する営み。文理解釈、体系解釈、目的論的解釈、歴史的解釈を組み合わせ、権限分配と正当化の問題を扱う。",
    "subfield": "法学・法哲学",
    "school_of_thought": "解釈法学",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "interpretation,legal reasoning",
    "key_researchers": ["Ronald Dworkin", "Aharon Barak"]
  },
  {
    "name_ja": "法の支配",
    "name_en": "Rule of Law",
    "definition": "権力行使が恣意ではなく、一般的、公開的、安定的、予測可能な法に拘束されるべきだとする原理。人権保障、司法独立、適正手続、行政統制を通じて、政治権力を制限する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "立憲主義",
    "era_start": 1215,
    "era_end": null,
    "keywords_en": "rule of law,constraint",
    "key_researchers": ["A. V. Dicey", "Lon Fuller", "Joseph Raz"]
  },
  {
    "name_ja": "立憲主義",
    "name_en": "Constitutionalism",
    "definition": "憲法によって政治権力を創設し、同時に制限する思想と制度。権力分立、基本権、違憲審査、民主的正統性を組み合わせ、多数決でも侵せない権利と制度的制約を重視する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "立憲主義",
    "era_start": 1700,
    "era_end": null,
    "keywords_en": "constitutionalism,limited government",
    "key_researchers": ["James Madison", "Bruce Ackerman"]
  },
  {
    "name_ja": "権力分立",
    "name_en": "Separation of Powers",
    "definition": "立法、行政、司法を分け、相互抑制と均衡によって権力集中を防ぐ制度原理。現代国家では行政国家化や独立機関の増大により、形式的分離だけでなく機能的統制が問題となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "立憲主義",
    "era_start": 1748,
    "era_end": null,
    "keywords_en": "separation of powers,checks and balances",
    "key_researchers": ["Montesquieu", "James Madison"]
  },
  {
    "name_ja": "違憲審査",
    "name_en": "Judicial Review",
    "definition": "裁判所が法律や行政行為を憲法に照らして審査し、違憲の場合に無効化または適用排除する制度。民主的に選ばれていない裁判官が政治判断を制約する正当性が中心論点となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "憲法理論",
    "era_start": 1803,
    "era_end": null,
    "keywords_en": "judicial review,constitutional courts",
    "key_researchers": ["John Marshall", "Alexander Bickel"]
  },
  {
    "name_ja": "基本権",
    "name_en": "Fundamental Rights",
    "definition": "個人の尊厳、自由、平等、参加、社会的生存を保障する憲法上の権利群。国家からの自由だけでなく、国家による保護義務や私人間効力も含み、衝突する権利の調整が重要となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "権利論",
    "era_start": 1789,
    "era_end": null,
    "keywords_en": "fundamental rights,constitutional rights",
    "key_researchers": ["Robert Alexy", "Ronald Dworkin"]
  },
  {
    "name_ja": "比例原則",
    "name_en": "Proportionality",
    "definition": "国家による権利制約が、目的の正当性、手段の適合性、必要性、利益衡量を満たす場合に限り許されるとする審査枠組み。憲法、人権法、行政法で広く用いられる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "権利論",
    "era_start": 1950,
    "era_end": null,
    "keywords_en": "proportionality,balancing",
    "key_researchers": ["Robert Alexy", "Aharon Barak"]
  },
  {
    "name_ja": "デュー・プロセス",
    "name_en": "Due Process",
    "definition": "生命、自由、財産を奪う国家行為には、公正な手続と一定の実体的正当性が必要だとする原理。告知、聴聞、中立的判断者、理由提示を通じて、恣意的な権力行使を抑制する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "手続的正義論",
    "era_start": 1215,
    "era_end": null,
    "keywords_en": "due process,procedural fairness",
    "key_researchers": ["Jerry Mashaw", "Henry Friendly"]
  },
  {
    "name_ja": "法的権利",
    "name_en": "Legal Rights",
    "definition": "法体系によって承認され、請求、自由、権限、免除などとして構成される利益や地位。権利は単なる利益ではなく、他者の義務や制度的救済と結びつく規範的関係として分析される。",
    "subfield": "法学・法哲学",
    "school_of_thought": "分析法哲学",
    "era_start": 1913,
    "era_end": null,
    "keywords_en": "rights,claim-rights",
    "key_researchers": ["Wesley Hohfeld", "Joseph Raz"]
  },
  {
    "name_ja": "義務論",
    "name_en": "Theory of Legal Duties",
    "definition": "法が個人や組織に課す作為、不作為、注意、忠実、説明などの義務を分析する理論。権利との相関、制裁との関係、道徳的義務との差異を通じて、法的責任の基礎を明らかにする。",
    "subfield": "法学・法哲学",
    "school_of_thought": "分析法哲学",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "duties,obligation",
    "key_researchers": ["John Austin", "H. L. A. Hart"]
  },
  {
    "name_ja": "正義論",
    "name_en": "Theory of Justice",
    "definition": "社会制度、分配、自由、平等、責任、承認をどのような原理で正当化するかを問う理論。法制度は正義の実現手段であり、権利保障、刑罰、福祉、差別是正の基準を提供する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "リベラリズム",
    "era_start": 1971,
    "era_end": null,
    "keywords_en": "justice,fairness",
    "key_researchers": ["John Rawls", "Amartya Sen"]
  },
  {
    "name_ja": "衡平法",
    "name_en": "Equity",
    "definition": "厳格な普通法や制定法の適用が不公平を生む場合に、良心、公正、信頼関係に基づいて救済を与える法原理。差止命令、信託、禁反言などを通じて柔軟な正義を実現する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "英米法学",
    "era_start": 1400,
    "era_end": null,
    "keywords_en": "equity,injunction",
    "key_researchers": ["Frederic Maitland", "Henry Maine"]
  },
  {
    "name_ja": "先例拘束性",
    "name_en": "Stare Decisis",
    "definition": "過去の判例、とくに上級審の判断に将来の裁判所が従うべきだとする原理。法的安定性、予測可能性、平等を支える一方、誤った先例をどのように変更するかが問題となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "英米法学",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "precedent,stare decisis",
    "key_researchers": ["Benjamin Cardozo", "Neil Duxbury"]
  },
  {
    "name_ja": "コモン・ロー",
    "name_en": "Common Law",
    "definition": "裁判所の判例を中心に発展する英米法系の法体系。個別事件の蓄積から原則を抽出し、類推と区別によって法を形成するため、法の発見と創造の境界が常に問題となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "英米法学",
    "era_start": 1100,
    "era_end": null,
    "keywords_en": "common law,case law",
    "key_researchers": ["William Blackstone", "Frederic Maitland"]
  },
  {
    "name_ja": "大陸法",
    "name_en": "Civil Law Tradition",
    "definition": "成文法典、体系的概念、学説による整理を重視する法伝統。ローマ法の継受を背景に、民法典や行政法の体系化を進め、裁判官の役割を法の適用者として位置づける傾向がある。",
    "subfield": "法学・法哲学",
    "school_of_thought": "大陸法学",
    "era_start": 1804,
    "era_end": null,
    "keywords_en": "civil law,codification",
    "key_researchers": ["Friedrich Carl von Savigny", "Rudolf von Jhering"]
  },
  {
    "name_ja": "法典化",
    "name_en": "Codification",
    "definition": "散在する慣習、判例、学説、条例を体系的な成文法典として整理する作業。法の明確性と統一性を高める一方、社会変化への柔軟性や裁判官による補充の余地が問題となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "大陸法学",
    "era_start": 1804,
    "era_end": null,
    "keywords_en": "codification,civil code",
    "key_researchers": ["Jean Portalis", "Friedrich Carl von Savigny"]
  },
  {
    "name_ja": "契約自由の原則",
    "name_en": "Freedom of Contract",
    "definition": "当事者が契約を締結するか、相手方、内容、方式を自由に決められるとする私法上の基本原理。市場経済と個人自治を支えるが、消費者保護、労働法、独占規制により修正される。",
    "subfield": "法学・法哲学",
    "school_of_thought": "古典的自由主義",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "freedom of contract,private autonomy",
    "key_researchers": ["Henry Maine", "Friedrich Hayek"]
  },
  {
    "name_ja": "不法行為責任",
    "name_en": "Tort Liability",
    "definition": "故意または過失により他人の権利や利益を侵害した者に損害賠償などを課す制度。事故予防、損害分配、矯正的正義のいずれを重視するかによって理論構成が変わる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "私法理論",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "torts,liability",
    "key_researchers": ["Guido Calabresi", "Ernest Weinrib"]
  },
  {
    "name_ja": "所有権",
    "name_en": "Property Rights",
    "definition": "物や資源に対する排他的支配、使用、収益、処分を法的に保障する権利。個人の自由と経済的効率を支える一方、公共目的、環境保護、共同体的利用による制約を受ける。",
    "subfield": "法学・法哲学",
    "school_of_thought": "私法理論",
    "era_start": 1700,
    "era_end": null,
    "keywords_en": "property,ownership",
    "key_researchers": ["John Locke", "Harold Demsetz"]
  },
  {
    "name_ja": "信託",
    "name_en": "Trust",
    "definition": "受託者が受益者のために財産を管理し、忠実義務や注意義務を負う法制度。財産管理、資産承継、投資、公益目的に利用され、所有権を形式的権原と実質的利益に分ける点が特徴である。",
    "subfield": "法学・法哲学",
    "school_of_thought": "英米私法",
    "era_start": 1200,
    "era_end": null,
    "keywords_en": "trust,fiduciary",
    "key_researchers": ["Frederic Maitland", "Austin Wakeman Scott"]
  },
  {
    "name_ja": "会社法",
    "name_en": "Corporate Law",
    "definition": "会社の設立、機関、株主、取締役、資本調達、組織再編、責任を規律する法領域。法人格と有限責任により投資を促進するが、経営者支配、利害関係者保護、社会的責任が課題となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "企業法学",
    "era_start": 1850,
    "era_end": null,
    "keywords_en": "corporate law,limited liability",
    "key_researchers": ["Adolf Berle", "Henry Hansmann"]
  },
  {
    "name_ja": "受託者責任",
    "name_en": "Fiduciary Duty",
    "definition": "他者の利益を管理する者が、忠実、注意、利益相反回避、情報開示などを負う義務。取締役、代理人、受託者、専門職に適用され、信頼関係における権力濫用を抑制する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "私法理論",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "fiduciary duty,loyalty",
    "key_researchers": ["Tamar Frankel", "Paul Finn"]
  },
  {
    "name_ja": "刑罰論",
    "name_en": "Theory of Punishment",
    "definition": "国家が犯罪者に苦痛や不利益を科すことをどのように正当化できるかを問う理論。応報、抑止、隔離、改善、修復の目的があり、刑罰の限界と人間の尊厳が中心問題となる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "刑法哲学",
    "era_start": 1764,
    "era_end": null,
    "keywords_en": "punishment,retribution",
    "key_researchers": ["Cesare Beccaria", "H. L. A. Hart"]
  },
  {
    "name_ja": "責任主義",
    "name_en": "Principle of Culpability",
    "definition": "刑罰は行為者に責任がある場合に限って科されるべきだとする原理。結果だけでなく、故意、過失、違法性の意識、期待可能性を考慮し、無責任な者への処罰を禁じる。",
    "subfield": "法学・法哲学",
    "school_of_thought": "刑法理論",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "culpability,criminal responsibility",
    "key_researchers": ["Claus Roxin", "George Fletcher"]
  },
  {
    "name_ja": "罪刑法定主義",
    "name_en": "Legality Principle",
    "definition": "犯罪と刑罰は事前に法律で明確に定められていなければならないとする刑法原理。類推処罰や遡及処罰を禁じ、国家刑罰権の恣意的行使から個人の自由を保護する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "刑法理論",
    "era_start": 1764,
    "era_end": null,
    "keywords_en": "nullum crimen,legality",
    "key_researchers": ["Cesare Beccaria", "Paul Johann Anselm von Feuerbach"]
  },
  {
    "name_ja": "修復的司法",
    "name_en": "Restorative Justice",
    "definition": "犯罪を単なる国家秩序違反ではなく、被害者、加害者、地域社会の関係破壊として捉え、対話、謝罪、賠償、関係修復を重視する司法モデル。刑罰中心主義への代替を提示する。",
    "subfield": "法学・法哲学",
    "school_of_thought": "修復的司法論",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "restorative justice,repair",
    "key_researchers": ["Howard Zehr", "John Braithwaite"]
  },
  {
    "name_ja": "行政裁量",
    "name_en": "Administrative Discretion",
    "definition": "行政機関が法律の枠内で政策判断、専門判断、事実評価を行う余地。現代行政では不可避だが、裁量濫用、理由提示、比例原則、司法審査によって統制される必要がある。",
    "subfield": "法学・法哲学",
    "school_of_thought": "行政法学",
    "era_start": 1900,
    "era_end": null,
    "keywords_en": "administrative discretion,judicial control",
    "key_researchers": ["Kenneth Culp Davis", "Jerry Mashaw"]
  },
  {
    "name_ja": "行政国家",
    "name_en": "Administrative State",
    "definition": "専門的行政機関が規則制定、執行、裁決を広範に担う現代国家の形態。民主的統制、専門性、説明責任、権力分立との緊張があり、規制国家の正統性をめぐる議論を生む。",
    "subfield": "法学・法哲学",
    "school_of_thought": "行政法学",
    "era_start": 1930,
