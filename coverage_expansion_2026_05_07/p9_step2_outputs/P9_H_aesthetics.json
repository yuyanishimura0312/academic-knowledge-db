[
  {
    "name_ja": "カント美学",
    "name_en": "Kantian aesthetics",
    "definition": "カント美学は、美の判断を概念や利害から独立した反省的判断として捉え、主観的でありながら普遍妥当性を要求する点を分析する美学である。自然美、芸術美、趣味、崇高、天才の関係を通じて、近代美学の中心的枠組みを形成した。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "ドイツ観念論",
    "era_start": 1790,
    "era_end": null,
    "keywords_en": "judgment,taste,disinterestedness",
    "key_researchers": ["Immanuel Kant"]
  },
  {
    "name_ja": "崇高論",
    "name_en": "Theory of the sublime",
    "definition": "崇高論は、巨大さ、力、恐怖、限界経験などに直面した際に生じる美とは異なる審美的経験を論じる概念である。バークやカント以降、自然、政治、技術、現代芸術の圧倒的表現を理解するための重要な理論となった。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "近代美学",
    "era_start": 1757,
    "era_end": null,
    "keywords_en": "sublime,terror,magnitude",
    "key_researchers": ["Edmund Burke", "Immanuel Kant"]
  },
  {
    "name_ja": "趣味判断",
    "name_en": "Judgment of taste",
    "definition": "趣味判断は、対象を美しいと判断する際に、概念的認識や実用的利害ではなく快の感情に基づきながら、他者にも同意を求める判断である。主観性と普遍性の緊張を扱うため、美的判断の哲学的分析において中心的な概念である。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "カント美学",
    "era_start": 1790,
    "era_end": null,
    "keywords_en": "taste,aesthetic judgment,universality",
    "key_researchers": ["Immanuel Kant", "David Hume"]
  },
  {
    "name_ja": "感覚の哲学",
    "name_en": "Philosophy of sensation",
    "definition": "感覚の哲学は、視覚、聴覚、触覚、嗅覚、味覚などの感覚経験が美的価値や芸術理解にどのように関与するかを問う領域である。知覚の身体性、感情、注意、媒体経験を分析し、芸術作品だけでなく環境や日常経験の美学にも関わる。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "現象学",
    "era_start": 1900,
    "era_end": null,
    "keywords_en": "sensation,perception,embodiment",
    "key_researchers": ["Maurice Merleau-Ponty", "John Dewey"]
  },
  {
    "name_ja": "日常美学",
    "name_en": "Everyday aesthetics",
    "definition": "日常美学は、芸術作品や自然美だけでなく、住まい、食事、服装、清掃、移動、都市景観などの日常的経験に含まれる美的価値を分析する領域である。生活実践と感覚的評価の結びつきを重視し、美学の対象を大きく拡張した。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "現代美学",
    "era_start": 1990,
    "era_end": null,
    "keywords_en": "everyday aesthetics,ordinary experience,environment",
    "key_researchers": ["Yuriko Saito", "Thomas Leddy"]
  },
  {
    "name_ja": "美的経験",
    "name_en": "Aesthetic experience",
    "definition": "美的経験は、対象を実用的、道徳的、科学的目的から離れて、感覚、感情、想像力、注意の働きによって経験するあり方を指す。芸術鑑賞、自然観賞、日常の感覚的充実を説明する基礎概念であり、その自律性や社会性が議論されてきた。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "プラグマティズム美学",
    "era_start": 1934,
    "era_end": null,
    "keywords_en": "aesthetic experience,attention,feeling",
    "key_researchers": ["John Dewey", "Monroe Beardsley"]
  },
  {
    "name_ja": "美的態度",
    "name_en": "Aesthetic attitude",
    "definition": "美的態度は、対象を所有、使用、道徳判断などの関心から離し、形態、表現、感覚的性質に注意を向ける心的構えを指す。近代美学では芸術鑑賞の条件として論じられたが、後には社会的文脈や実践から切り離しすぎる点も批判された。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "分析美学",
    "era_start": 1912,
    "era_end": null,
    "keywords_en": "aesthetic attitude,disinterest,contemplation",
    "key_researchers": ["Edward Bullough", "Jerome Stolnitz"]
  },
  {
    "name_ja": "無関心性",
    "name_en": "Disinterestedness",
    "definition": "無関心性は、美的判断が対象の所有、欲望、利益、道徳的効用から独立して成立するという考えである。カント美学で重要な位置を占め、趣味判断の純粋性を示す一方、フェミニズム美学や社会的美学からは権力や文脈を隠す概念として批判された。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "近代美学",
    "era_start": 1790,
    "era_end": null,
    "keywords_en": "disinterestedness,taste,autonomy",
    "key_researchers": ["Immanuel Kant", "Jerome Stolnitz"]
  },
  {
    "name_ja": "美的価値",
    "name_en": "Aesthetic value",
    "definition": "美的価値は、対象が美しい、優雅である、力強い、調和している、感動的であるなどと評価される際の価値を指す。芸術的価値、認知的価値、道徳的価値との関係が問題となり、価値の客観性、相対性、多元性をめぐる議論の中心にある。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "価値論",
    "era_start": 1900,
    "era_end": null,
    "keywords_en": "aesthetic value,evaluation,pluralism",
    "key_researchers": ["Monroe Beardsley", "Nick Zangwill"]
  },
  {
    "name_ja": "芸術の定義",
    "name_en": "Definition of art",
    "definition": "芸術の定義は、何が芸術作品であり、何がそうでないのかを区別する条件を問う問題である。模倣、表現、形式、制度、歴史的連関、意図など多様な基準が提案され、前衛芸術やレディメイドの登場以降、分析美学の重要論点となった。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "分析美学",
    "era_start": 1950,
    "era_end": null,
    "keywords_en": "definition of art,artworld,classification",
    "key_researchers": ["Arthur Danto", "George Dickie", "Morris Weitz"]
  },
  {
    "name_ja": "模倣説",
    "name_en": "Mimesis theory",
    "definition": "模倣説は、芸術を現実、行為、人物、自然、理念などの模倣または再現として理解する古典的理論である。プラトンでは真理から遠い写しとして批判され、アリストテレスでは学習と感情浄化をもたらす人間的活動として評価された。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "古代ギリシア哲学",
    "era_start": -400,
    "era_end": null,
    "keywords_en": "mimesis,representation,imitation",
    "key_researchers": ["Plato", "Aristotle"]
  },
  {
    "name_ja": "表現説",
    "name_en": "Expression theory of art",
    "definition": "表現説は、芸術を作者の感情、内的経験、精神内容の表現として捉える理論である。ロマン主義以降に強まり、作品の価値を感情の真正性や伝達力に求めるが、作者心理への還元や形式的特徴の軽視をめぐって批判も受けてきた。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "ロマン主義美学",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "expression,emotion,artist",
    "key_researchers": ["R. G. Collingwood", "Leo Tolstoy", "Benedetto Croce"]
  },
  {
    "name_ja": "形式主義",
    "name_en": "Formalism",
    "definition": "形式主義は、芸術作品の価値や意味を主題、作者、社会的背景よりも、線、色彩、構成、リズム、構造などの形式的性質に求める立場である。近代絵画や音楽の分析に大きな影響を与え、抽象芸術の理論的支柱ともなった。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "モダニズム美学",
    "era_start": 1910,
    "era_end": null,
    "keywords_en": "formalism,form,significant form",
    "key_researchers": ["Clive Bell", "Clement Greenberg"]
  },
  {
    "name_ja": "制度的芸術論",
    "name_en": "Institutional theory of art",
    "definition": "制度的芸術論は、芸術作品であることを、作品が芸術界の制度や慣習の中で芸術として提示され承認されることによって説明する理論である。デュシャン以後の現代芸術を理解するうえで有力だが、制度の範囲や評価基準の説明不足も問題とされる。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "分析美学",
    "era_start": 1964,
    "era_end": null,
    "keywords_en": "institutional theory,artworld,classification",
    "key_researchers": ["George Dickie", "Arthur Danto"]
  },
  {
    "name_ja": "芸術界",
    "name_en": "Artworld",
    "definition": "芸術界は、作品、作家、批評家、鑑賞者、美術館、ギャラリー、理論、歴史的文脈が相互に関係する社会的かつ解釈的な場を指す。ある物が芸術として理解される条件を説明する概念であり、現代芸術の哲学に大きな影響を与えた。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "分析美学",
    "era_start": 1964,
    "era_end": null,
    "keywords_en": "artworld,context,interpretation",
    "key_researchers": ["Arthur Danto", "George Dickie"]
  },
  {
    "name_ja": "芸術の終焉",
    "name_en": "End of art",
    "definition": "芸術の終焉は、芸術制作が消滅するという意味ではなく、芸術が特定の歴史的様式や進歩物語に従って発展する時代が終わったという主張である。ヘーゲルやダントーにおいて、芸術の哲学化、多元化、ポスト歴史的状況を考える概念となった。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "ヘーゲル美学",
    "era_start": 1820,
    "era_end": null,
    "keywords_en": "end of art,history,pluralism",
    "key_researchers": ["G. W. F. Hegel", "Arthur Danto"]
  },
  {
    "name_ja": "天才論",
    "name_en": "Theory of genius",
    "definition": "天才論は、芸術家の創造性を規則に従う技能ではなく、規則を生み出す自然的才能として捉える理論である。カントやロマン主義において重要で、独創性、想像力、霊感の概念を支えたが、個人崇拝や社会的条件の隠蔽としても批判される。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "ロマン主義美学",
    "era_start": 1790,
    "era_end": null,
    "keywords_en": "genius,creativity,originality",
    "key_researchers": ["Immanuel Kant", "Friedrich Schelling"]
  },
  {
    "name_ja": "創造性",
    "name_en": "Creativity",
    "definition": "創造性は、既存の規則や慣習を単に適用するのではなく、新しい形式、意味、経験、価値を生み出す能力や過程を指す。芸術家の個人的才能だけでなく、素材、技術、共同制作、社会制度との相互作用としても分析される。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "現代美学",
    "era_start": 1950,
    "era_end": null,
    "keywords_en": "creativity,innovation,imagination",
    "key_researchers": ["Margaret Boden", "Berys Gaut"]
  },
  {
    "name_ja": "想像力",
    "name_en": "Imagination",
    "definition": "想像力は、現前しないもの、可能なもの、虚構的なもの、感覚的に変形されたものを心的に構成する能力である。美的経験、芸術制作、フィクション理解、比喩、共感に深く関わり、カントから現代分析美学まで幅広く論じられている。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "近代美学",
    "era_start": 1700,
    "era_end": null,
    "keywords_en": "imagination,fiction,possibility",
    "key_researchers": ["Immanuel Kant", "Kendall Walton"]
  },
  {
    "name_ja": "芸術的意図",
    "name_en": "Artistic intention",
    "definition": "芸術的意図は、作者が作品制作や提示において何を意味し、達成し、表現しようとしたかを指す概念である。解釈において作者の意図をどの程度重視すべきかは、意図主義、反意図主義、仮説的意図主義の間で争われている。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "解釈理論",
    "era_start": 1946,
    "era_end": null,
    "keywords_en": "intention,interpretation,author",
    "key_researchers": ["W. K. Wimsatt", "Monroe Beardsley", "Paisley Livingston"]
  },
  {
    "name_ja": "意図の誤謬",
    "name_en": "Intentional fallacy",
    "definition": "意図の誤謬は、作品の意味や価値を作者の意図に還元することを批判する概念である。新批評において提起され、作品を自律した言語的構造として読む態度を支えたが、後には歴史的文脈や制作意図の役割を過小評価する点も議論された。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "新批評",
    "era_start": 1946,
    "era_end": null,
    "keywords_en": "intentional fallacy,author,interpretation",
    "key_researchers": ["W. K. Wimsatt", "Monroe Beardsley"]
  },
  {
    "name_ja": "芸術解釈",
    "name_en": "Interpretation of art",
    "definition": "芸術解釈は、作品が何を意味し、どのように理解されるべきかを、形式、文脈、作者、鑑賞者、歴史、制度などから説明する営みである。複数解釈の妥当性、過剰解釈、意図、証拠、批評実践との関係が主要な論点となる。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "解釈学",
    "era_start": 1900,
    "era_end": null,
    "keywords_en": "interpretation,meaning,criticism",
    "key_researchers": ["Hans-Georg Gadamer", "Arthur Danto"]
  },
  {
    "name_ja": "作品の同一性",
    "name_en": "Identity of artworks",
    "definition": "作品の同一性は、ある芸術作品が何によって同じ作品であり続けるのかを問う問題である。絵画の物質的個体性、音楽作品の演奏可能性、文学作品のテキスト性、複製や修復の扱いなど、媒体ごとに異なる条件が分析される。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "存在論的美学",
    "era_start": 1960,
    "era_end": null,
    "keywords_en": "ontology,artwork identity,type-token",
    "key_researchers": ["Nelson Goodman", "Jerrold Levinson"]
  },
  {
    "name_ja": "芸術作品の存在論",
    "name_en": "Ontology of art",
    "definition": "芸術作品の存在論は、作品が物理的対象、出来事、型、記号構造、実践、制度的対象のいずれとして存在するのかを問う領域である。音楽、演劇、写真、デジタル作品などの違いを通じて、芸術の存在様式を精密に分析する。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "分析美学",
    "era_start": 1968,
    "era_end": null,
    "keywords_en": "ontology,artworks,medium",
    "key_researchers": ["Nelson Goodman", "Amie Thomasson"]
  },
  {
    "name_ja": "オーセンティシティ",
    "name_en": "Authenticity",
    "definition": "オーセンティシティは、芸術作品や演奏、修復、複製が本物であること、または歴史的・表現的に正当であることを指す概念である。作者性、来歴、素材、制作過程、演奏慣習に関わり、美術市場や保存倫理においても重要である。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "芸術存在論",
    "era_start": 1968,
    "era_end": null,
    "keywords_en": "authenticity,original,forgery",
    "key_researchers": ["Nelson Goodman", "Denis Dutton"]
  },
  {
    "name_ja": "贋作問題",
    "name_en": "Problem of forgery",
    "definition": "贋作問題は、見た目や感覚的性質が本物と区別できない作品でも、作者や来歴が偽られていれば美的・芸術的価値が変わるのかを問う問題である。知覚可能な性質だけで価値が決まるのか、歴史的事実が評価に関与するのかを明らかにする。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "分析美学",
    "era_start": 1968,
    "era_end": null,
    "keywords_en": "forgery,authenticity,history",
    "key_researchers": ["Nelson Goodman", "Denis Dutton"]
  },
  {
    "name_ja": "芸術媒体",
    "name_en": "Artistic medium",
    "definition": "芸術媒体は、作品が制作され、提示され、経験されるための物質、技術、記号体系、感覚的条件を指す。絵画、彫刻、映画、写真、音楽、デジタルメディアなどでは媒体固有の可能性と制約が異なり、表現や解釈に影響を与える。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "メディア美学",
    "era_start": 1900,
    "era_end": null,
    "keywords_en": "medium,materiality,media aesthetics",
    "key_researchers": ["Clement Greenberg", "Rosalind Krauss"]
  },
  {
    "name_ja": "媒体固有性",
    "name_en": "Medium specificity",
    "definition": "媒体固有性は、各芸術媒体には独自の性質、制約、表現可能性があり、優れた作品はそれを自覚的に活用するという考えである。モダニズム美術や映画理論で重要視されたが、複合メディアやインスタレーション芸術の発展により再検討された。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "モダニズム美学",
    "era_start": 1940,
    "era_end": null,
    "keywords_en": "medium specificity,modernism,materiality",
    "key_researchers": ["Clement Greenberg", "Rosalind Krauss"]
  },
  {
    "name_ja": "芸術と道徳",
    "name_en": "Art and morality",
    "definition": "芸術と道徳は、作品の倫理的欠陥や美徳が芸術的価値に影響するかを問う論点である。道徳主義、自律主義、倫理的批評の立場があり、差別表現、暴力描写、作者の行為、観客への影響をめぐる現代的議論にも関わる。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "倫理的批評",
    "era_start": 1980,
    "era_end": null,
    "keywords_en": "ethicism,morality,art criticism",
    "key_researchers": ["Noel Carroll", "Berys Gaut", "Martha Nussbaum"]
  },
  {
    "name_ja": "美的自律性",
    "name_en": "Aesthetic autonomy",
    "definition": "美的自律性は、芸術や美的価値が道徳、政治、宗教、経済、実用性から独立した固有の領域を持つという考えである。近代芸術観を支えた一方、批判理論やフェミニズム美学からは社会的条件を隠すイデオロギーとして批判されている。",
    "subfield": "美学・芸術哲学",
    "school_of_thought": "モダニズム美学",
    "era_start": 1800,
    "era_end": null,
    "keywords_en": "autonomy,aestheticism,modernism",
    "key_researchers": ["Immanuel Kant", "Theodor W. Adorno"]
  },
  {
    "name_ja": "芸術の社会性",
    "name_en": "Sociality of art",
