[
  {
    "name_ja": "6G通信",
    "name_en": "6G Communications",
    "definition": "6G通信は、2030年前後の実用化を想定する次世代移動通信で、テラヘルツ帯、AIネイティブ制御、超高信頼低遅延、センシングと通信の統合、衛星や非地上系ネットワークとの融合を通じ、産業、交通、医療、拡張現実を支える基盤技術である。",
    "subfield": "情報通信工学",
    "school_of_thought": "次世代移動通信",
    "era_start": 2020,
    "era_end": null,
    "keywords_en": "6G,terahertz,AI-native networks,ISAC",
    "key_researchers": ["Theodore S. Rappaport", "Gerhard Fettweis"]
  },
  {
    "name_ja": "サテライトインターネット",
    "name_en": "Satellite Internet",
    "definition": "サテライトインターネットは、地上基地局だけでは届きにくい地域へ衛星回線でインターネット接続を提供する方式である。静止衛星、中軌道衛星、低軌道衛星を用い、災害時通信、海上航空通信、遠隔地教育、広域IoTなどを支える重要なアクセス技術である。",
    "subfield": "情報通信工学",
    "school_of_thought": "宇宙通信工学",
    "era_start": 1960,
    "era_end": null,
    "keywords_en": "satellite internet,LEO,GEO,broadband",
    "key_researchers": ["Arthur C. Clarke", "John R. Pierce"]
  },
  {
    "name_ja": "光通信",
    "name_en": "Optical Communication",
    "definition": "光通信は、光ファイバや自由空間光を用いて情報を伝送する通信技術であり、低損失、高帯域、電磁雑音への耐性を特徴とする。海底ケーブル、都市間バックボーン、データセンター相互接続、家庭向けFTTHを支える現代通信網の中核である。",
    "subfield": "情報通信工学",
    "school_of_thought": "光波通信工学",
    "era_start": 1966,
    "era_end": null,
    "keywords_en": "optical fiber,photonics,WDM,FTTH",
    "key_researchers": ["Charles K. Kao", "Robert D. Maurer"]
  },
  {
    "name_ja": "メッシュネットワーク",
    "name_en": "Mesh Network",
    "definition": "メッシュネットワークは、各ノードが中継機能を持ち、複数経路で相互接続されるネットワーク構成である。単一障害点を減らし、自己修復性や柔軟な拡張性を実現できるため、無線LAN、センサネットワーク、災害時通信、地域ネットワークで利用される。",
    "subfield": "情報通信工学",
    "school_of_thought": "分散ネットワーク",
    "era_start": 1970,
    "era_end": null,
    "keywords_en": "mesh networking,self-healing,routing,ad hoc",
    "key_researchers": ["David B. Johnson", "Charles E. Perkins"]
  },
  {
    "name_ja": "5G NR",
    "name_en": "5G New Radio",
    "definition": "5G NRは、3GPPが標準化した第5世代移動通信の無線アクセス方式で、柔軟なサブキャリア間隔、ビームフォーミング、ミリ波、低遅延通信、大規模MIMOを特徴とする。高速大容量通信だけでなく、産業IoTや自動運転支援を想定した設計である。",
    "subfield": "情報通信工学",
    "school_of_thought": "セルラー通信標準",
    "era_start": 2018,
    "era_end": null,
    "keywords_en": "5G NR,3GPP,mmWave,massive MIMO",
    "key_researchers": ["Erik Dahlman", "Stefan Parkvall"]
  },
  {
    "name_ja": "シャノンの通信路容量",
    "name_en": "Shannon Channel Capacity",
    "definition": "シャノンの通信路容量は、雑音のある通信路で任意に小さい誤り率を達成できる最大情報伝送速度を示す理論限界である。帯域幅、信号電力、雑音電力の関係を定式化し、符号化、変調、無線設計、光通信の性能評価に基準を与えた。",
    "subfield": "情報通信工学",
    "school_of_thought": "情報理論",
    "era_start": 1948,
    "era_end": null,
    "keywords_en": "channel capacity,information theory,SNR,Shannon limit",
    "key_researchers": ["Claude E. Shannon"]
  },
  {
    "name_ja": "誤り訂正符号",
    "name_en": "Error-Correcting Codes",
    "definition": "誤り訂正符号は、伝送や記録の過程で生じるビット誤りを検出し、冗長情報を使って元の情報を復元する技術である。無線通信、光ディスク、深宇宙通信、半導体メモリで不可欠であり、通信路容量に近づくための中心的手段である。",
    "subfield": "情報通信工学",
    "school_of_thought": "符号理論",
    "era_start": 1948,
    "era_end": null,
    "keywords_en": "error correction,coding theory,FEC,redundancy",
    "key_researchers": ["Richard W. Hamming", "Irving S. Reed"]
  },
  {
    "name_ja": "畳み込み符号",
    "name_en": "Convolutional Codes",
    "definition": "畳み込み符号は、入力ビット列を過去の状態に依存するシフトレジスタ構造で符号化する誤り訂正方式である。ビタビ復号と組み合わせることで実用的な訂正性能を示し、衛星通信、移動通信、デジタル放送などで長く利用された。",
    "subfield": "情報通信工学",
    "school_of_thought": "符号理論",
    "era_start": 1955,
    "era_end": null,
    "keywords_en": "convolutional codes,Viterbi decoding,FEC,trellis",
    "key_researchers": ["Peter Elias", "Andrew Viterbi"]
  },
  {
    "name_ja": "ターボ符号",
    "name_en": "Turbo Codes",
    "definition": "ターボ符号は、複数の畳み込み符号とインタリーバを組み合わせ、反復復号によってシャノン限界に近い性能を実現した誤り訂正符号である。3G移動通信や衛星通信で大きな影響を持ち、現代の反復復号技術の普及を促した。",
    "subfield": "情報通信工学",
    "school_of_thought": "反復符号理論",
    "era_start": 1993,
    "era_end": null,
    "keywords_en": "turbo codes,iterative decoding,interleaver,Shannon limit",
    "key_researchers": ["Claude Berrou", "Alain Glavieux"]
  },
  {
    "name_ja": "LDPC符号",
    "name_en": "Low-Density Parity-Check Codes",
    "definition": "LDPC符号は、疎なパリティ検査行列に基づく誤り訂正符号で、信念伝搬復号により高い訂正性能を得る。衛星通信、Wi-Fi、5G NR、光通信で採用され、長符号長で通信路容量に近い性能を実現できる代表的な符号である。",
    "subfield": "情報通信工学",
    "school_of_thought": "疎グラフ符号理論",
    "era_start": 1962,
    "era_end": null,
    "keywords_en": "LDPC,belief propagation,parity-check,sparse graph",
    "key_researchers": ["Robert G. Gallager", "David J. C. MacKay"]
  },
  {
    "name_ja": "ポーラ符号",
    "name_en": "Polar Codes",
    "definition": "ポーラ符号は、通信路分極という現象を利用して、良い仮想通信路に情報ビットを割り当てる誤り訂正符号である。理論的に対称二元離散無記憶通信路の容量達成が示され、5G NRの制御チャネル符号として採用された。",
    "subfield": "情報通信工学",
    "school_of_thought": "通信路分極理論",
    "era_start": 2008,
    "era_end": null,
    "keywords_en": "polar codes,channel polarization,successive cancellation,5G",
    "key_researchers": ["Erdal Arikan"]
  },
  {
