    "key_researchers": ["Stuart Hall", "Raymond Williams", "Richard Hoggart"]
  },
  {
    "name_ja": "ポストコロニアル批評",
    "name_en": "Postcolonial Criticism",
    "definition": "植民地主義と帝国主義が知識、言語、主体、文学、歴史記述に残した影響を批判的に検討する理論。西洋中心主義、他者表象、従属的主体の声、混淆性などを通じて、近代世界の不平等な権力構造を分析する。",
    "subfield": "文化研究・批判理論",
    "school_of_thought": "ポストコロニアル理論",
    "era_start": 1978,
    "era_end": null,
    "keywords_en": "colonialism,subaltern,hybridity",
    "key_researchers": ["Edward Said", "Gayatri Chakravorty Spivak", "Homi K. Bhabha"]
  },
  {
    "name_ja": "クィア理論",
    "name_en": "Queer Theory",
    "definition": "性別、性的指向、親密性、身体、家族規範を固定的な自然属性ではなく、制度や言説によって構成されるものとして批判する理論。異性愛規範や二元的ジェンダーを問い直し、逸脱や流動性を政治的・分析的資源として扱う。",
    "subfield": "文化研究・批判理論",
    "school_of_thought": "クィア理論",
    "era_start": 1990,
    "era_end": null,
    "keywords_en": "queer,heteronormativity,performativity",
    "key_researchers": ["Judith Butler", "Eve Kosofsky Sedgwick", "Michael Warner"]
  },
  {
    "name_ja": "デジタル文化研究",
    "name_en": "Digital Culture Studies",
    "definition": "インターネット、プラットフォーム、アルゴリズム、ゲーム、SNS、データ化された日常生活を文化的・政治的現象として研究する領域。技術を中立的道具ではなく、権力、労働、参加、監視、アイデンティティを再編する媒介として分析する。",
    "subfield": "文化研究・批判理論",
    "school_of_thought": "デジタル・メディア研究",
