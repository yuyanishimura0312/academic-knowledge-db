    "era_end": null,
    "keywords_en": "digital media,platforms,algorithmic culture",
    "key_researchers": ["Lev Manovich", "Tiziana Terranova", "José van Dijck"]
  },
  {
    "name_ja": "情動理論",
    "name_en": "Affect Theory",
    "definition": "感情を個人の内面状態だけでなく、身体、環境、メディア、集団、政治の間を循環する強度や関係性として捉える理論。言語化される以前の感覚や雰囲気が、主体形成、公共性、権力、記憶に及ぼす作用を分析する。",
    "subfield": "文化研究・批判理論",
    "school_of_thought": "情動論的転回",
    "era_start": 1995,
    "era_end": null,
    "keywords_en": "affect,emotion,embodiment",
    "key_researchers": ["Brian Massumi", "Sara Ahmed", "Eve Kosofsky Sedgwick"]
  },
  {
    "name_ja": "ヘゲモニー",
    "name_en": "Hegemony",
    "definition": "支配階級が強制だけでなく同意、常識、教育、メディア、文化制度を通じて社会的主導権を維持する仕組みを指す概念。文化研究では、支配的意味が受容者によって交渉され、抵抗され、再編される過程を説明するために用いられる。",
    "subfield": "文化研究・批判理論",
    "school_of_thought": "西欧マルクス主義",
    "era_start": 1930,
    "era_end": null,
    "keywords_en": "hegemony,consent,common sense",
    "key_researchers": ["Antonio Gramsci", "Stuart Hall", "Chantal Mouffe"]
  },
  {
    "name_ja": "イデオロギー批判",
    "name_en": "Ideology Critique",
    "definition": "社会において自明視される価値、規範、表象、知識が、いかに特定の権力関係や階級利益を隠蔽し正当化するかを明らかにする批判方法。文化テクストを単なる反映ではなく、主体を形成し現実認識を組織する装置として読む。",
    "subfield": "文化研究・批判理論",
    "school_of_thought": "マルクス主義批評",
    "era_start": 1846,
    "era_end": null,
