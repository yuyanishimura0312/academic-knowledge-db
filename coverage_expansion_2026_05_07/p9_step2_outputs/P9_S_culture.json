    "subfield": "文化研究・批判理論",
    "school_of_thought": "ドゥルーズ＝ガタリ派",
    "era_start": 1980,
    "era_end": null,
    "keywords_en": "nomadology,deterritorialization,becoming",
    "key_researchers": ["Gilles Deleuze", "Félix Guattari", "Rosi Braidotti"]
