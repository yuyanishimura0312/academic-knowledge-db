[
  {
    "name_ja": "カルチュラル・スタディーズ",
    "name_en": "Cultural Studies",
    "definition": "日常生活、メディア、階級、人種、ジェンダー、サブカルチャーなどを、権力関係と意味生成の場として分析する学際的研究領域。高級文化と大衆文化の区別を相対化し、文化を社会的闘争やアイデンティティ形成の実践として捉える。",
    "subfield": "文化研究・批判理論",
    "school_of_thought": "バーミンガム学派",
