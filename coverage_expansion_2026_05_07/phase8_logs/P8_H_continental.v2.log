    "key_researchers": ["グレアム・ハーマン", "リーヴァイ・ブライアント"]
  },
  {
    "name_ja": "思弁的実在論",
    "name_en": "Speculative Realism",
    "definition": "人間と世界の相関だけを哲学の限界とする立場を批判し、人間不在の実在、物質、偶然性、対象を思考しようとする潮流。現象学やポスト構造主義の反実在論的傾向への応答として登場した。",
    "subfield": "大陸哲学・現象学",
    "school_of_thought": "思弁的実在論",
    "era_start": 2007,
    "era_end": null,
