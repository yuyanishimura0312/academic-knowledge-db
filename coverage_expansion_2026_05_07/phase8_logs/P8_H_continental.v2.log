    "era_start": 1995,
    "era_end": null,
    "keywords_en": "bare life,sovereignty,exception",
    "key_researchers": ["ジョルジョ・アガンベン"]
  },
  {
    "name_ja": "例外状態",
    "name_en": "State of Exception",
    "definition": "危機を理由に通常の法秩序が停止されるが、その停止自体が法的・政治的権力によって管理される状態。非常時の一時的措置に見えながら、近代政治では恒常的統治技術となる危険を示す概念である。",
    "subfield": "大陸哲学・現象学",
