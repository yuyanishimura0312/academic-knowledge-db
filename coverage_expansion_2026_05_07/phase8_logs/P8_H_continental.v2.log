    "key_researchers": ["ミシェル・フーコー"]
  },
  {
    "name_ja": "統治性",
    "name_en": "Governmentality",
    "definition": "国家による命令だけでなく、統計、行政、教育、市場、自己管理を通じて人々の行為可能性を導く権力の様式。自由な主体を前提しながら、その自由を計算し組織する近代的統治の合理性を分析する。",
    "subfield": "大陸哲学・現象学",
    "school_of_thought": "ポスト構造主義",
    "era_start": 1978,
    "era_end": null,
    "keywords_en": "governmentality,liberalism,conduct",
    "key_researchers": ["ミシェル・フーコー"]
  },
  {
    "name_ja": "パノプティコン",
