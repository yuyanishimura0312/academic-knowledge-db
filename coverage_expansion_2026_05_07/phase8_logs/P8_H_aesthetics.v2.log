    "era_start": 1750,
    "era_end": null,
    "keywords_en": "imagination,fiction",
    "key_researchers": ["Immanuel Kant", "Kendall Walton"]
  },
  {
    "name_ja": "ごっこ遊び理論",
    "name_en": "Make-believe theory",
    "definition": "虚構作品の鑑賞を、観客が小道具に導かれて想像のゲームに参加することとして説明する理論である。絵画、文学、演劇などの表象が、何を想像すべきかを規定する仕組みを分析する。",
    "subfield": "美学・芸術哲学",
