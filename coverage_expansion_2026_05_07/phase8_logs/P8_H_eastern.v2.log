    "keywords_en": "Avicenna,essence-existence",
    "key_researchers": ["イブン・シーナー", "ディミトリ・グタス"]
  },
  {
    "name_ja": "照明哲学",
    "name_en": "Illuminationism",
    "definition": "スフラワルディーに始まるイスラーム哲学の潮流で、光の階層を通じて存在と認識を説明する。アリストテレス哲学を批判的に受け継ぎつつ、直観的知、神秘体験、古代イラン的象徴を統合した独自の形而上学である。",
    "subfield": "東洋・非西洋哲学",
    "school_of_thought": "照明学派",
    "era_start": 1180,
    "era_end": null,
    "keywords_en": "Illuminationism,Suhrawardi",
    "key_researchers": ["スフラワルディー", "ヘンリー・コービン"]
  },
  {
