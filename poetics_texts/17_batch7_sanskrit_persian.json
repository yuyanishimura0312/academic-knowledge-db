{"version":"phase6-batch7","texts":[
{"id":"pt_text_rigveda_3_62_10","title_original":"ऋग्वेद ३.६२.१०","title_ja":"リグ・ヴェーダ 3.62.10 ガーヤトリー","author_name_display":"Vishvamitra","era_year":-1300,"era_period":"ヴェーダ期","culture_region":"サンスクリット","language_original":"san","form_genre":"讃歌","length_lines":3,"full_text_or_excerpt":"तत्सवितुर्वरेण्यं भर्गो देवस्य धीमहि।\nधियो यो नः प्रचोदयात्॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/gretil/corpustei/transformations/html/sa_RV.htm","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_rigveda_10_90","title_original":"ऋग्वेद १०.९०","title_ja":"リグ・ヴェーダ 10.90 プルシャ・スークタ","author_name_display":"（伝）","era_year":-1100,"era_period":"ヴェーダ期","culture_region":"サンスクリット","language_original":"san","form_genre":"讃歌","length_lines":2,"full_text_or_excerpt":"सहस्रशीर्षा पुरुषः सहस्राक्षः सहस्रपात्।\nस भूमिं विश्वतो वृत्वात्यतिष्ठद्दशाङ्गुलम्॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_rigveda_10_121","title_original":"ऋग्वेद १०.१२१","title_ja":"リグ・ヴェーダ 10.121 ヒラニヤガルバ","author_name_display":"（伝）","era_year":-1100,"era_period":"ヴェーダ期","culture_region":"サンスクリット","language_original":"san","form_genre":"讃歌","length_lines":2,"full_text_or_excerpt":"हिरण्यगर्भः समवर्तताग्रे भूतस्य जातः पतिरेक आसीत्।\nस दाधार पृथिवीं द्यामुतेमां कस्मै देवाय हविषा विधेम॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_rigveda_1_32","title_original":"ऋग्वेद १.३२","title_ja":"リグ・ヴェーダ 1.32 インドラ・ヴリトラ討伐","author_name_display":"Hiranyastupa","era_year":-1300,"era_period":"ヴェーダ期","culture_region":"サンスクリット","language_original":"san","form_genre":"讃歌","length_lines":2,"full_text_or_excerpt":"इन्द्रस्य नु वीर्याणि प्र वोचं यानि चकार प्रथमानि वज्री।","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_isha_upanishad","title_original":"ईशोपनिषद् १","title_ja":"イシャ・ウパニシャッド 第1詩節","author_name_display":"（伝）","era_year":-700,"era_period":"後期ヴェーダ","culture_region":"サンスクリット","language_original":"san","form_genre":"哲学詩","length_lines":3,"full_text_or_excerpt":"ईशा वास्यमिदं सर्वं यत्किञ्च जगत्यां जगत्।\nतेन त्यक्तेन भुञ्जीथा मा गृधः कस्यस्विद्धनम्॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_katha_upanishad","title_original":"कठोपनिषद् १.३.१४","title_ja":"カタ・ウパニシャッド 1.3.14","author_name_display":"（伝）","era_year":-500,"era_period":"後期ヴェーダ","culture_region":"サンスクリット","language_original":"san","form_genre":"哲学詩","length_lines":2,"full_text_or_excerpt":"उत्तिष्ठत जाग्रत प्राप्य वरान्निबोधत।\nक्षुरस्य धारा निशिता दुरत्यया दुर्गं पथस्तत्कवयो वदन्ति॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_mundaka_upanishad","title_original":"मुण्डकोपनिषद् ३.१.१","title_ja":"ムンダカ・ウパニシャッド 3.1.1（二羽の鳥）","author_name_display":"（伝）","era_year":-500,"era_period":"後期ヴェーダ","culture_region":"サンスクリット","language_original":"san","form_genre":"哲学詩","length_lines":2,"full_text_or_excerpt":"द्वा सुपर्णा सयुजा सखाया समानं वृक्षं परिषस्वजाते।\nतयोरन्यः पिप्पलं स्वाद्वत्त्यनश्नन्नन्यो अभिचाकशीति॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_brihadaranyaka_1","title_original":"बृहदारण्यकोपनिषद् १.३.२८","title_ja":"ブリハッド・アーラニヤカ 1.3.28（光への祈り）","author_name_display":"（伝）","era_year":-700,"era_period":"後期ヴェーダ","culture_region":"サンスクリット","language_original":"san","form_genre":"哲学詩","length_lines":3,"full_text_or_excerpt":"असतो मा सद्गमय।\nतमसो मा ज्योतिर्गमय।\nमृत्योर्मा अमृतं गमय॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_bhagavadgita_2_22","title_original":"भगवद्गीता २.२२","title_ja":"バガヴァッド・ギーター 2.22","author_name_display":"（伝）Vyasa","era_year":-200,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"哲学詩","length_lines":2,"full_text_or_excerpt":"वासांसि जीर्णानि यथा विहाय नवानि गृह्णाति नरोऽपराणि।\nतथा शरीराणि विहाय जीर्णान्यन्यानि संयाति नवानि देही॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_bhagavadgita_4_7","title_original":"भगवद्गीता ४.७","title_ja":"バガヴァッド・ギーター 4.7","author_name_display":"（伝）Vyasa","era_year":-200,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"哲学詩","length_lines":2,"full_text_or_excerpt":"यदा यदा हि धर्मस्य ग्लानिर्भवति भारत।\nअभ्युत्थानमधर्मस्य तदात्मानं सृजाम्यहम्॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_bhagavadgita_11_32","title_original":"भगवद्गीता ११.३२","title_ja":"バガヴァッド・ギーター 11.32（時の姿）","author_name_display":"（伝）Vyasa","era_year":-200,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"哲学詩","length_lines":3,"full_text_or_excerpt":"कालोऽस्मि लोकक्षयकृत्प्रवृद्धो लोकान्समाहर्तुमिह प्रवृत्तः।\nऋतेऽपि त्वां न भविष्यन्ति सर्वे ये वस्थिताः प्रत्यनीकेषु योधाः॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_bhagavadgita_18_66","title_original":"भगवद्गीता १८.६६","title_ja":"バガヴァッド・ギーター 18.66 シャラナーガティ","author_name_display":"（伝）Vyasa","era_year":-200,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"哲学詩","length_lines":2,"full_text_or_excerpt":"सर्वधर्मान्परित्यज्य मामेकं शरणं व्रज।\nअहं त्वा सर्वपापेभ्यो मोक्षयिष्यामि मा शुचः॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_mahabharata_yudhishthira","title_original":"महाभारत・वनपर्व","title_ja":"マハーバーラタ 森林篇 ヤクシャ問答","author_name_display":"Vyasa","era_year":-300,"era_period":"古典","culture_region":"サンスクリット","language_original":"san","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"अहन्यहनि भूतानि गच्छन्तीह यमालयम्।\nशेषाः स्थावरमिच्छन्ति किमाश्चर्यमतः परम्॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_ramayana_bala_1","title_original":"रामायण・बालकाण्ड १.१.१","title_ja":"ラーマーヤナ バラカーンダ 1.1.1","author_name_display":"Valmiki","era_year":-200,"era_period":"古典","culture_region":"サンスクリット","language_original":"san","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"तपःस्वाध्यायनिरतं तपस्वी वाग्विदां वरम्।\nनारदं परिपप्रच्छ वाल्मीकिर्मुनिपुङ्गवम्॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_kalidasa_ritusam","title_original":"कालिदास, ऋतुसंहार","title_ja":"カーリダーサ『リトゥサンハーラ（季節集）』","author_name_display":"Kalidasa","era_year":400,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"季節詩","length_lines":2,"full_text_or_excerpt":"प्रचण्डसूर्यः स्पृहणीयचन्द्रमाः सदावगाह्यप्रथितोदकाशयः।","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_kalidasa_vikram","title_original":"कालिदास, विक्रमोर्वशी","title_ja":"カーリダーサ『ヴィクラモールヴァシー』","author_name_display":"Kalidasa","era_year":410,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"詩劇","length_lines":2,"full_text_or_excerpt":"वेदेषु यज्ञेषु तपःसु चैव दानेषु यश्चेन्द्रियविग्रहेषु","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":2},
{"id":"pt_text_bhartrhari_shringara","title_original":"भर्तृहरि, शृङ्गारशतक","title_ja":"バルトリハリ『シュリンガーラ・シャタカ』","author_name_display":"Bhartrhari","era_year":500,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"恋愛百頌","length_lines":2,"full_text_or_excerpt":"शम्भुस्वयम्भुहरयो हरिणेक्षणानां येनाक्रियन्त सततं गृहकुम्भदासाः","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_bhartrhari_vairagya","title_original":"भर्तृहरि, वैराग्यशतक","title_ja":"バルトリハリ『ヴァイラーギャ・シャタカ（離欲百頌）』","author_name_display":"Bhartrhari","era_year":500,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"離欲百頌","length_lines":2,"full_text_or_excerpt":"भोगा न भुक्ता वयमेव भुक्ता तपो न तप्तं वयमेव तप्ताः।","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_jayadeva_3","title_original":"जयदेव, गीतगोविन्द III","title_ja":"ジャヤデーヴァ『ギータ・ゴーヴィンダ』第3歌","author_name_display":"Jayadeva","era_year":1180,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"歌唱叙情詩","length_lines":2,"full_text_or_excerpt":"मामियं चलिता विलोक्य वृतं वधूनिचयेन सा।","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_ashvaghosa_buddha","title_original":"अश्वघोष, बुद्धचरित","title_ja":"アシュヴァゴーシャ『ブッダチャリタ』","author_name_display":"Ashvaghosa","era_year":150,"era_period":"古典初期","culture_region":"サンスクリット","language_original":"san","form_genre":"仏教叙事詩","length_lines":2,"full_text_or_excerpt":"तस्योर्जयन्ती वसुधाधिपस्य प्राकाशते सर्वजगद्धिताय।","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_hala_gathasapt","title_original":"हाल, गाथासप्तशती","title_ja":"ハーラ『ガーター・サプタシャティー』","author_name_display":"Hala","era_year":200,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"民衆抒情詩","length_lines":2,"full_text_or_excerpt":"पसिअ पासि एअं पासि पासि महु पाणसरिसं वि।","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":2},
{"id":"pt_text_magha_shishu","title_original":"माघ, शिशुपालवध","title_ja":"マーガ『シシュパーラヴァダ』","author_name_display":"Magha","era_year":700,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"श्रियः पतिः श्रीमति शासितुं जगज्जगन्निवासो वसुदेवसद्मनि।","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":2},
{"id":"pt_text_bharavi_kirat","title_original":"भारवि, किरातार्जुनीय","title_ja":"バーラヴィ『キラータールジュニーヤ』","author_name_display":"Bharavi","era_year":600,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"श्रियः कुरूणामधिपस्य पालनीं प्रजासु वृत्तिं यमयुङ्क्त वेदितुम्।","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":2},
{"id":"pt_text_dhammapada_5","title_original":"धम्मपद ५","title_ja":"法句経 5偈","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"na hi verena verāni, sammantīdha kudācanaṃ;\naverena ca sammanti, esa dhammo sanantano","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":1},
{"id":"pt_text_dhammapada_183","title_original":"धम्मपद १८३","title_ja":"法句経 183（七仏通戒偈）","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":3,"full_text_or_excerpt":"sabbapāpassa akaraṇaṃ, kusalassa upasampadā;\nsacittapariyodapanaṃ, etaṃ buddhāna sāsanaṃ.","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":1},
{"id":"pt_text_dhammapada_100","title_original":"धम्मपद १००","title_ja":"法句経 100","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":3,"full_text_or_excerpt":"sahassamapi ce vācā, anatthapadasaṃhitā;\nekaṃ atthapadaṃ seyyo, yaṃ sutvā upasammati","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_suttanipata_metta","title_original":"सुत्तनिपात・मेत्तसुत्त","title_ja":"スッタニパータ メッタ・スッタ（慈経）","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":3,"full_text_or_excerpt":"sukhino vā khemino hontu, sabbe sattā bhavantu sukhitattā","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":1},
{"id":"pt_text_kanzan_3","title_original":"寒山詩「我心如秋月」","title_ja":"寒山詩「我心如秋月」","author_name_display":"寒山","era_year":750,"era_period":"唐","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"五言古詩・禅偈","length_lines":4,"full_text_or_excerpt":"我心如秋月，碧潭清皎潔。\n無物堪比倫，教我如何說。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/wiki/寒山詩","source_archive":"維基文庫 / CBETA","canonical_tier":1},
{"id":"pt_text_huineng_gyose","title_original":"慧能・菩提偈","title_ja":"慧能 菩提偈","author_name_display":"慧能","era_year":700,"era_period":"唐","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"禅偈","length_lines":4,"full_text_or_excerpt":"菩提本無樹，明鏡亦非臺。\n本來無一物，何處惹塵埃。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/wiki/六祖壇經","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_dogen_yuyu","title_original":"道元『正法眼蔵』山水経","title_ja":"道元「山水経」冒頭","author_name_display":"道元","era_year":1240,"era_period":"鎌倉","culture_region":"仏典詩偈","language_original":"jpn","form_genre":"禅文","length_lines":2,"full_text_or_excerpt":"而今の山水は、古佛の道現成なり。","public_domain_status":"PD-original","source_url":"https://www.aozora.gr.jp/cards/001329/","source_archive":"青空文庫","canonical_tier":2},
{"id":"pt_text_hafez_ghazal_165","title_original":"حافظ، غزل ۱۶۵","title_ja":"ハーフィズ ガザル第165番","author_name_display":"Hafez","era_year":1370,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"ガザル","length_lines":2,"full_text_or_excerpt":"دوش رفتم به در میکده خواب آلوده\nخرقه تر دامن و سجاده شراب آلوده","public_domain_status":"PD-original","source_url":"https://ganjoor.net/hafez/ghazal/sh165","source_archive":"Ganjoor","canonical_tier":2},
{"id":"pt_text_hafez_ghazal_178","title_original":"حافظ، غزل ۱۷۸","title_ja":"ハーフィズ ガザル第178番","author_name_display":"Hafez","era_year":1370,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"ガザル","length_lines":2,"full_text_or_excerpt":"سال‌ها دل طلب جام جم از ما می‌کرد\nو آن‌چه خود داشت ز بیگانه تمنا می‌کرد","public_domain_status":"PD-original","source_url":"https://ganjoor.net/hafez/ghazal/sh178","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_hafez_ghazal_240","title_original":"حافظ، غزل ۲۴۰","title_ja":"ハーフィズ ガザル第240番（鳥籠の鳥）","author_name_display":"Hafez","era_year":1370,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"ガザル","length_lines":2,"full_text_or_excerpt":"چرا نه در پی عزم دیار خود باشم\nچرا نه خاک سر کوی یار خود باشم","public_domain_status":"PD-original","source_url":"https://ganjoor.net/hafez/ghazal/sh240","source_archive":"Ganjoor","canonical_tier":2},
{"id":"pt_text_rumi_ney","title_original":"مولوی، نی‌نامه","title_ja":"ルーミー『マスナヴィー』第1巻冒頭「葦笛の歌」","author_name_display":"Rumi","era_year":1264,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"マスナヴィー","length_lines":2,"full_text_or_excerpt":"بشنو این نی چون شکایت می‌کند\nاز جدایی‌ها حکایت می‌کند","public_domain_status":"PD-original","source_url":"https://ganjoor.net/moulavi/masnavi/daftar1/sh1","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_rumi_d_shams_2","title_original":"مولوی، دیوان شمس ۲","title_ja":"ルーミー『ディーヴァーン・シャムス』ガザル","author_name_display":"Rumi","era_year":1260,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"ガザル","length_lines":2,"full_text_or_excerpt":"ما ز بالاییم و بالا می‌رویم\nما ز دریاییم و دریا می‌رویم","public_domain_status":"PD-original","source_url":"https://ganjoor.net/moulavi/shams","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_attar_seven_valleys","title_original":"عطار، هفت وادی","title_ja":"アッタール『七つの谷』","author_name_display":"Attar","era_year":1177,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"マスナヴィー","length_lines":2,"full_text_or_excerpt":"گفت ما را هفت وادی در ره است\nچون گذشتی هفت وادی درگه است","public_domain_status":"PD-original","source_url":"https://ganjoor.net/attar/mantegh","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_nezami_layla","title_original":"نظامی، لیلی و مجنون","title_ja":"ニザーミー『ライラとマジュヌーン』","author_name_display":"Nezami","era_year":1188,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"マスナヴィー","length_lines":2,"full_text_or_excerpt":"در نام نکوی نام‌داران\nگنجی است گرامی شکل‌داران","public_domain_status":"PD-original","source_url":"https://ganjoor.net/nezami/5ganj/leyli-majnoon","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_nezami_haft","title_original":"نظامی، هفت پیکر","title_ja":"ニザーミー『七人の美姫』","author_name_display":"Nezami","era_year":1197,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"マスナヴィー","length_lines":2,"full_text_or_excerpt":"ای جهان دیده بود خویش از تو\nهیچ بودی نبوده پیش از تو","public_domain_status":"PD-original","source_url":"https://ganjoor.net/nezami/5ganj/7peykar","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_ferdowsi_rostam","title_original":"فردوسی، شاهنامه - رستم و سهراب","title_ja":"フェルドウスィー『シャー・ナーメ』ロスタムとソフラブ","author_name_display":"Ferdowsi","era_year":1010,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"چو سهراب شیراوژن از مادر آمد\nز افراسیاب آن خبر شد فراز","public_domain_status":"PD-original","source_url":"https://ganjoor.net/ferdousi/shahname","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_ferdowsi_kayumarth","title_original":"فردوسی، شاهنامه - کیومرث","title_ja":"フェルドウスィー『シャー・ナーメ』ケユーマルス","author_name_display":"Ferdowsi","era_year":1010,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"سخن گوی دهقان چنین کرد یاد\nکه پس از خداوند روز و نژاد","public_domain_status":"PD-original","source_url":"https://ganjoor.net/ferdousi/shahname","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_imru_qais_full","title_original":"معلقة امرئ القيس - تتمة","title_ja":"イムル・アル＝カイスのムアッラカ（続）","author_name_display":"Imru' al-Qais","era_year":540,"era_period":"Pre-Islamic Arabic","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"カスィーダ","length_lines":2,"full_text_or_excerpt":"تَري بَعَرَ الأَرءامِ في عَرَصاتِها\nوَقيعانِها كَأَنَّهُ حَبُّ فُلفُلِ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_antara","title_original":"معلقة عنترة","title_ja":"アンタラのムアッラカ","author_name_display":"Antara ibn Shaddad","era_year":600,"era_period":"Pre-Islamic Arabic","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"カスィーダ","length_lines":2,"full_text_or_excerpt":"هَلْ غَادَرَ الشُّعَرَاءُ مِنْ مُتَرَدَّمِ\nأَمْ هَلْ عَرَفْتَ الدَّارَ بَعْدَ تَوَهُّمِ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_harith","title_original":"معلقة الحارث","title_ja":"ハーリス・イブン・ヒッリザのムアッラカ","author_name_display":"Harith ibn Hilliza","era_year":580,"era_period":"Pre-Islamic Arabic","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"カスィーダ","length_lines":2,"full_text_or_excerpt":"آذنتنا ببينها أسماءُ\nرُبَّ ثاوٍ يُمَلُّ منه الثواءُ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_jarir","title_original":"جرير، الفرزدق نقائض","title_ja":"ジャリール 詩「ナカイド」","author_name_display":"Jarir","era_year":700,"era_period":"Umayyad","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"風刺詩","length_lines":2,"full_text_or_excerpt":"إِنَّ العُيُونَ الَّتِي في طَرفِها حَوَرٌ\nقَتَلْنَنا ثُمَّ لَمْ يُحيِينَ قَتلانا","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_abu_tammam","title_original":"أبو تمام","title_ja":"アブー・タンマーム","author_name_display":"Abu Tammam","era_year":840,"era_period":"Abbasid","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"カスィーダ","length_lines":2,"full_text_or_excerpt":"السَّيفُ أَصدَقُ أَنباءً مِنَ الكُتُبِ\nفي حَدِّهِ الحَدُّ بَينَ الجِدِّ وَاللَعِبِ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_al_buhturi","title_original":"البحتري","title_ja":"アル＝ブフトゥリー","author_name_display":"Al-Buhturi","era_year":860,"era_period":"Abbasid","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"カスィーダ","length_lines":2,"full_text_or_excerpt":"صُنْتُ نَفْسِي عَمَّا يُدَنِّسُ نَفْسي\nوَتَرَفَّعتُ عَن جَدا كُلِّ جِبسِ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":2},
{"id":"pt_text_al_maarri","title_original":"المعرّي، اللزوميات","title_ja":"アブー・アル＝マアッリー『ルズーミーヤート』","author_name_display":"Abu al-Ala al-Maarri","era_year":1050,"era_period":"Abbasid","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"カスィーダ","length_lines":2,"full_text_or_excerpt":"تَعَبٌ كُلُّها الحَياةُ فَما أَعجَبُ إِلّا مِنْ راغِبٍ في إِزدِيادِ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_rabia_adawiya","title_original":"رابعة العدوية","title_ja":"ラービア・アル＝アダウィーヤ","author_name_display":"Rabia al-Adawiyya","era_year":780,"era_period":"Sufi","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"スーフィー詩","length_lines":2,"full_text_or_excerpt":"أُحِبُّكَ حُبَّينِ حُبَّ الهَوى\nوَحُبًّا لِأَنَّكَ أَهْلٌ لِذاكا","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_ibn_arabi_taj","title_original":"ابن عربي - من الترجمان","title_ja":"イブン・アラビー『欲求の翻訳者』別篇","author_name_display":"Ibn Arabi","era_year":1215,"era_period":"アンダルシア","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"スーフィー詩","length_lines":2,"full_text_or_excerpt":"يا ربعَ سلمى عسى\nترجعَ ليلٌ مضى","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":2},
{"id":"pt_text_ibn_zaydun_2","title_original":"ابن زيدون","title_ja":"イブン・ザイドゥーン（短詩）","author_name_display":"Ibn Zaydun","era_year":1060,"era_period":"アンダルシア","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"短詩","length_lines":2,"full_text_or_excerpt":"وداعاً يا حبيبي\nوَداعَ المُتَفَنِّنينَ في الوَداعِ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":2},
{"id":"pt_text_busiri_burda","title_original":"البوصيري، البردة","title_ja":"アル＝ブースィーリー『ブルダ（外套詩）』","author_name_display":"Al-Busiri","era_year":1280,"era_period":"Mamluk","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"頌詩","length_lines":2,"full_text_or_excerpt":"أَمِنْ تَذَكُّرِ جِيرَانٍ بِذِي سَلَمِ\nمَزَجْتَ دَمْعًا جَرَى مِنْ مُقْلَةٍ بِدَمِ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_ibn_farid_khamr","title_original":"ابن الفارض، الخمرية","title_ja":"イブン・アル＝ファーリド『ハムリーヤ（酒の頌）』","author_name_display":"Ibn al-Farid","era_year":1235,"era_period":"Sufi","culture_region":"アラビア・ペルシア","language_original":"ara","form_genre":"スーフィー詩","length_lines":2,"full_text_or_excerpt":"شَرِبْنا عَلى ذِكْرِ الحَبيبِ مُدامَةً\nسَكِرْنا بِها مِنْ قَبلِ أَنْ يُخلَقَ الكَرْمُ","public_domain_status":"PD-original","source_url":"https://ar.wikisource.org/","source_archive":"Wikisource ar","canonical_tier":1},
{"id":"pt_text_jami_yusuf_2","title_original":"جامی، یوسف و زلیخا 2","title_ja":"ジャーミー『ユーセフとズライハー』別パート","author_name_display":"Jami","era_year":1485,"era_period":"Persian classical","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"マスナヴィー","length_lines":2,"full_text_or_excerpt":"به یاد آورم آن روز و آن دیار\nکه از یاد ندارم لحظه‌ای بیدار","public_domain_status":"PD-original","source_url":"https://ganjoor.net/jami","source_archive":"Ganjoor","canonical_tier":2},
{"id":"pt_text_amir_khusrow","title_original":"امیرخسرو دهلوی","title_ja":"アミール・ホスロー・デヘルヴィー","author_name_display":"Amir Khusrow","era_year":1320,"era_period":"Indian Persian","culture_region":"アラビア・ペルシア","language_original":"fas","form_genre":"ガザル","length_lines":2,"full_text_or_excerpt":"شبان وصل را چه قدر و چه آن خوش\nچو روزی هجر شد دل از زمان خوش","public_domain_status":"PD-original","source_url":"https://ganjoor.net/khosro","source_archive":"Ganjoor","canonical_tier":1},
{"id":"pt_text_kabir_doha_1","title_original":"कबीर - दोहा","title_ja":"カビール ドーハ第1","author_name_display":"Kabir","era_year":1480,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"ドーハ","length_lines":2,"full_text_or_excerpt":"बूरा जो देखन मैं चला, बूरा न मिलिया कोय।\nजो दिल खोजा आपना, मुझसे बूरा न कोय॥","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_tulsi_ramcharitmanas","title_original":"तुलसीदास, रामचरितमानस","title_ja":"トゥルシーダース『ラームチャリトマーナス』冒頭","author_name_display":"Tulsidas","era_year":1574,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"वर्णानामर्थसङ्घानां रसानां छन्दसामपि।\nमङ्गलानां च कर्त्तारौ वन्दे वाणीविनायकौ॥","public_domain_status":"PD-original","source_url":"https://sa.wikisource.org/","source_archive":"Wikisource sa","canonical_tier":1},
{"id":"pt_text_mira_bhajan","title_original":"मीराबाई - भजन","title_ja":"ミーラーバーイー バジャン","author_name_display":"Mirabai","era_year":1547,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"バクティ詩","length_lines":2,"full_text_or_excerpt":"पायो जी मैंने राम रतन धन पायो।\nवस्तु अमोलिक दी म्हारे सतगुरु, किरपा करि अपणायो॥","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_tirukkural_1","title_original":"திருக்குறள் - 1","title_ja":"ティルックラル 第1番","author_name_display":"Thiruvalluvar","era_year":300,"era_period":"古典タミル","culture_region":"サンスクリット","language_original":"tam","form_genre":"格言詩","length_lines":2,"full_text_or_excerpt":"அகர முதல எழுத்தெல்லாம் ஆதி\nபகவன் முதற்றே உலகு","public_domain_status":"PD-original","source_url":"https://ta.wikisource.org/","source_archive":"Wikisource ta","canonical_tier":1},
{"id":"pt_text_tagore_1","title_original":"Tagore Gitanjali #1","title_ja":"タゴール『ギーターンジャリ』第1詩","author_name_display":"Rabindranath Tagore","era_year":1910,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"আমার এ গান ছেড়েছে তার সকল অলংকার,\nতোমার কাছে রাখে নি আর সাজের অহংকার।","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/7164/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_35","title_original":"Tagore Gitanjali #35","title_ja":"タゴール『ギーターンジャリ』第35詩","author_name_display":"Rabindranath Tagore","era_year":1910,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"Where the mind is without fear and the head is held high;\nWhere knowledge is free;\nWhere the world has not been broken up into fragments by narrow domestic walls","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/7164/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_dario_sonatina","title_original":"Rubén Darío, Sonatina","title_ja":"ルベン・ダリオ「ソナチネ」","author_name_display":"Rubén Darío","era_year":1896,"era_period":"近代ラテンアメリカ","culture_region":"20-21世紀グローバル","language_original":"es","form_genre":"アレクサンドル","length_lines":4,"full_text_or_excerpt":"La princesa está triste... ¿Qué tendrá la princesa?\nLos suspiros se escapan de su boca de fresa,\nque ha perdido la risa, que ha perdido el color.\nLa princesa está pálida en su silla de oro","public_domain_status":"PD-original","source_url":"https://es.wikisource.org/wiki/Sonatina_(Dar%C3%ADo)","source_archive":"Wikisource es","canonical_tier":1},
{"id":"pt_text_dario_lo_fatal","title_original":"Rubén Darío, Lo fatal","title_ja":"ルベン・ダリオ「宿命」","author_name_display":"Rubén Darío","era_year":1905,"era_period":"近代ラテンアメリカ","culture_region":"20-21世紀グローバル","language_original":"es","form_genre":"ソネット","length_lines":4,"full_text_or_excerpt":"Dichoso el árbol que es apenas sensitivo,\ny más la piedra dura, porque ésta ya no siente,\npues no hay dolor más grande que el dolor de ser vivo,\nni mayor pesadumbre que la vida consciente","public_domain_status":"PD-original","source_url":"https://es.wikisource.org/wiki/Lo_fatal","source_archive":"Wikisource es","canonical_tier":1},
{"id":"pt_text_marti_versos","title_original":"Martí, Versos sencillos I","title_ja":"ホセ・マルティ『素直な詩』I","author_name_display":"José Martí","era_year":1891,"era_period":"近代ラテンアメリカ","culture_region":"20-21世紀グローバル","language_original":"es","form_genre":"抒情詩","length_lines":4,"full_text_or_excerpt":"Yo soy un hombre sincero\nDe donde crece la palma,\nY antes de morirme quiero\nEchar mis versos del alma","public_domain_status":"PD-original","source_url":"https://es.wikisource.org/wiki/Versos_sencillos","source_archive":"Wikisource es","canonical_tier":1},
{"id":"pt_text_lugones_luna","title_original":"Lugones, Luna llena","title_ja":"ルゴーネス「満月」","author_name_display":"Leopoldo Lugones","era_year":1909,"era_period":"近代ラテンアメリカ","culture_region":"20-21世紀グローバル","language_original":"es","form_genre":"抒情詩","length_lines":3,"full_text_or_excerpt":"Salve, oh luna sublime, hierático presagio\nde silencio en el campo y de oro en el celaje","public_domain_status":"PD-original","source_url":"https://es.wikisource.org/","source_archive":"Wikisource es","canonical_tier":2},
{"id":"pt_text_silva_nocturno","title_original":"Silva, Nocturno III","title_ja":"ホセ・アスンシオン・シルバ「夜想曲III」","author_name_display":"José Asunción Silva","era_year":1894,"era_period":"近代ラテンアメリカ","culture_region":"20-21世紀グローバル","language_original":"es","form_genre":"夜想詩","length_lines":3,"full_text_or_excerpt":"Una noche,\nuna noche toda llena de perfumes, de murmullos y de música de élas","public_domain_status":"PD-original","source_url":"https://es.wikisource.org/wiki/Nocturno","source_archive":"Wikisource es","canonical_tier":1},
{"id":"pt_text_xu_zhimo_zaibie","title_original":"徐志摩・再別康橋","title_ja":"徐志摩 再別康橋","author_name_display":"徐志摩","era_year":1928,"era_period":"民国","culture_region":"20-21世紀グローバル","language_original":"zho","form_genre":"自由詩","length_lines":4,"full_text_or_excerpt":"輕輕的我走了，正如我輕輕的來；\n我輕輕的招手，作別西天的雲彩。\n那河畔的金柳，是夕陽中的新娘；\n波光裡的豔影，在我的心頭蕩漾。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/wiki/再別康橋","source_archive":"維基文庫","canonical_tier":1},
{"id":"pt_text_dai_wangshu_yuxiang","title_original":"戴望舒・雨巷","title_ja":"戴望舒 雨巷","author_name_display":"戴望舒","era_year":1928,"era_period":"民国","culture_region":"20-21世紀グローバル","language_original":"zho","form_genre":"自由詩","length_lines":4,"full_text_or_excerpt":"撐著油紙傘，獨自\n彷徨在悠長、悠長\n又寂寥的雨巷，\n我希望逢著","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/","source_archive":"維基文庫","canonical_tier":1},
{"id":"pt_text_wen_yiduo_sishui","title_original":"聞一多・死水","title_ja":"聞一多 死水","author_name_display":"聞一多","era_year":1925,"era_period":"民国","culture_region":"20-21世紀グローバル","language_original":"zho","form_genre":"自由詩","length_lines":4,"full_text_or_excerpt":"這是一溝絕望的死水，\n清風吹不起半點漪淪。\n不如多扔些破銅爛鐵，\n爽性潑你的剩菜殘羹。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/","source_archive":"維基文庫","canonical_tier":1},
{"id":"pt_text_kim_sowol_chodonghwa","title_original":"김소월・초혼","title_ja":"金素月 招魂","author_name_display":"Kim Sowol","era_year":1925,"era_period":"日帝下韓国","culture_region":"東アジア","language_original":"kor","form_genre":"近代詩","length_lines":4,"full_text_or_excerpt":"산산이 부서진 이름이여!\n허공중에 헤어진 이름이여!\n불러도 주인 없는 이름이여!\n부르다가 내가 죽을 이름이여!","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_han_yongun_silence","title_original":"한용운・님의 침묵","title_ja":"韓龍雲「君の沈黙」","author_name_display":"Han Yongun","era_year":1926,"era_period":"日帝下韓国","culture_region":"東アジア","language_original":"kor","form_genre":"自由詩","length_lines":4,"full_text_or_excerpt":"님은 갔습니다. 아아, 사랑하는 나의 님은 갔습니다.\n푸른 산빛을 깨치고 단풍나무 숲을 향하여 난 작은 길을 걸어서, 차마 떨치고 갔습니다.","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yi_yuksa_jeoljeong","title_original":"이육사・절정","title_ja":"李陸史 絶頂","author_name_display":"Yi Yuksa","era_year":1940,"era_period":"日帝下韓国","culture_region":"東アジア","language_original":"kor","form_genre":"自由詩","length_lines":4,"full_text_or_excerpt":"매운 계절의 채찍에 갈겨\n마침내 북방으로 휩쓸려오다.\n하늘도 그만 지쳐 끝난 고원\n서리빨 칼날진 그우에 서다.","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_jeong_chol_kwandong","title_original":"정철・관동별곡","title_ja":"鄭澈 関東別曲","author_name_display":"Jeong Cheol","era_year":1580,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"歌辞","length_lines":3,"full_text_or_excerpt":"강호에 병이 깊어 죽림에 누었더니\n관동 팔백 리에 방면을 맡디시니","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yun_seondo_eobu","title_original":"윤선도・어부사시사","title_ja":"尹善道 漁父四時詞「春」","author_name_display":"Yun Seondo","era_year":1651,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"앞 바다에 안개 걷히고 뒷 산에 해 비친다\n배 띄워라 배 띄워라\n밤 물은 거의 들고 낮 물이 밀려 온다","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_hwang_jini_2","title_original":"황진이・상사몽","title_ja":"黄真伊「相思夢」","author_name_display":"Hwang Jini","era_year":1545,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"꿈이 길이 있다고 한다면\n임의 집 창 앞 길이 자갈길이 되었으리","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_jeong_mongju_dansim","title_original":"정몽주・단심가","title_ja":"鄭夢周 丹心歌","author_name_display":"Jeong Mongju","era_year":1390,"era_period":"高麗末","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"이 몸이 죽고 죽어 일백 번 고쳐 죽어\n백골이 진토되어 넋이라도 있고 없고\n임 향한 일편단심이야 가실 줄이 있으랴","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_nguyen_du_kieu_2","title_original":"Truyện Kiều - 出会い","title_ja":"阮攸『金雲翹伝』金重との出会い","author_name_display":"Nguyễn Du","era_year":1820,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"叙事詩","length_lines":4,"full_text_or_excerpt":"Hỏi tên, rằng: \"Mã Giám Sinh\",\nHỏi quê, rằng: \"Huyện Lâm Thanh, cũng gần\".\nQuá niên trạc ngoại tứ tuần,\nMày râu nhẵn nhụi, áo quần bảnh bao.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/wiki/Truy%E1%BB%87n_Ki%E1%BB%81u","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_ho_xuan_huong_deo","title_original":"Hồ Xuân Hương - Đèo Ba Dội","title_ja":"胡春香「三段の峠」","author_name_display":"Hồ Xuân Hương","era_year":1810,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"七言絶句","length_lines":4,"full_text_or_excerpt":"Một đèo, một đèo, lại một đèo,\nKhen ai khéo tạc cảnh cheo leo.\nCửa son đỏ loét tùm hum nóc,\nHòn đá xanh rì lún phún rêu.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_ba_huyen_thanh_quan","title_original":"Bà Huyện Thanh Quan - Qua Đèo Ngang","title_ja":"バー・フエン・タイン・クアン「ンガン峠を越えて」","author_name_display":"Bà Huyện Thanh Quan","era_year":1830,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"七言律詩","length_lines":4,"full_text_or_excerpt":"Bước tới đèo Ngang, bóng xế tà,\nCỏ cây chen đá, lá chen hoa.\nLom khom dưới núi tiều vài chú,\nLác đác bên sông chợ mấy nhà.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_nezahualcoyotl_canto","title_original":"Nezahualcóyotl - Canto","title_ja":"ネサワルコヨトル「カント・トリステ」","author_name_display":"Nezahualcóyotl","era_year":1460,"era_period":"前コロンブス・メキシコ","culture_region":"先住民・口承","language_original":"nci","form_genre":"アステカ・カント","length_lines":4,"full_text_or_excerpt":"Amo el canto del cenzontle,\npájaro de cuatrocientas voces.\nAmo el color del jade\ny el enervante perfume de las flores","public_domain_status":"PD-original","source_url":"https://es.wikisource.org/","source_archive":"Wikisource es (PD訳)","canonical_tier":2},
{"id":"pt_text_popol_vuh_creation","title_original":"Popol Vuh - Creación","title_ja":"ポポル・ヴフ 創世（PD訳抜粋）","author_name_display":"（マヤ・キチェ伝承）","era_year":1554,"era_period":"前コロンブス〜植民期","culture_region":"先住民・口承","language_original":"quc","form_genre":"創世神話詩","length_lines":4,"full_text_or_excerpt":"Esta es la relación de cómo todo estaba en suspenso,\ntodo en calma, en silencio;\ntodo inmóvil, callado,\ny vacía la extensión del cielo","public_domain_status":"PD-original","source_url":"https://es.wikisource.org/wiki/Popol_Vuh","source_archive":"Wikisource es","canonical_tier":1},
{"id":"pt_text_navajo_blessingway","title_original":"Navajo Blessingway","title_ja":"ナバホ「祝福の道」","author_name_display":"（ナバホ口承）","era_year":1930,"era_period":"近代記録","culture_region":"先住民・口承","language_original":"nv","form_genre":"祈祷詩","length_lines":4,"full_text_or_excerpt":"In beauty I walk\nWith beauty before me I walk\nWith beauty behind me I walk\nWith beauty above me I walk","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_kumulipo","title_original":"Kumulipo (creation chant)","title_ja":"クムリポ ハワイ創世讃歌","author_name_display":"（ハワイ伝承）","era_year":1700,"era_period":"前接触期","culture_region":"先住民・口承","language_original":"haw","form_genre":"創世讃歌","length_lines":4,"full_text_or_excerpt":"O ke au i kahuli wela ka honua\nO ke au i kahuli lole ka lani\nO ke au i kuka'iaka ka la","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/pac/lku/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_aloha_oe","title_original":"Aloha 'Oe","title_ja":"リリウオカラニ「アロハ・オエ」","author_name_display":"Liliʻuokalani","era_year":1878,"era_period":"近代ハワイ","culture_region":"先住民・口承","language_original":"haw","form_genre":"メレ","length_lines":4,"full_text_or_excerpt":"Aloha ʻoe, aloha ʻoe\nE ke onaona noho i ka lipo\nOne fond embrace,\nA hoʻi aʻe au","public_domain_status":"PD-original","source_url":"https://en.wikisource.org/","source_archive":"Wikisource en","canonical_tier":1},
{"id":"pt_text_ainu_yukar_2","title_original":"アイヌ・ユーカラ「シロカニペ」","title_ja":"アイヌ・ユーカラ「銀の滴降る降るまわりに」（知里幸恵訳）","author_name_display":"知里幸恵 編訳","era_year":1922,"era_period":"近代記録","culture_region":"先住民・口承","language_original":"ain","form_genre":"叙事詩","length_lines":3,"full_text_or_excerpt":"銀の滴降る降るまわりに、金の滴降る降るまわりに、という歌を私は歌いながら","public_domain_status":"PD-original","source_url":"https://www.aozora.gr.jp/cards/000113/","source_archive":"青空文庫","canonical_tier":1},
{"id":"pt_text_pyramid_text_217","title_original":"Pyramid Texts §217","title_ja":"ピラミッド・テクスト 217","author_name_display":"（古代エジプト）","era_year":-2300,"era_period":"古王国","culture_region":"アフリカ","language_original":"egy","form_genre":"宗教詩","length_lines":3,"full_text_or_excerpt":"Awake! O sleeper, O dweller in the West, O Osiris, lord of the Two Lands","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/egy/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_hymn_aten","title_original":"Hymn to the Aten","title_ja":"アテン讃歌","author_name_display":"Akhenaten","era_year":-1340,"era_period":"新王国","culture_region":"アフリカ","language_original":"egy","form_genre":"讃歌","length_lines":4,"full_text_or_excerpt":"Splendid you rise in the horizon of heaven,\nO living Aten, who initiates life!\nWhen you rise from the eastern horizon,\nYou fill every land with your beauty.","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_ancient_love_papyrus","title_original":"Papyrus Harris 500","title_ja":"古代エジプト恋愛詩 ハリス・パピルス500","author_name_display":"（古代エジプト）","era_year":-1300,"era_period":"新王国","culture_region":"アフリカ","language_original":"egy","form_genre":"恋愛詩","length_lines":4,"full_text_or_excerpt":"My beloved is unique, without peer,\nMore beautiful than any other.\nLook, she is like the star goddess rising\nAt the start of a happy new year.","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_sundiata_opening","title_original":"Sundiata Epic - Opening","title_ja":"スンジャタ叙事詩 冒頭","author_name_display":"（マンディング口承）","era_year":1230,"era_period":"中世マリ","culture_region":"アフリカ","language_original":"mnk","form_genre":"叙事詩","length_lines":4,"full_text_or_excerpt":"Listen to the words of the griot,\nFor I will tell you of Sundiata,\nThe son of Sogolon,\nThe lion who walks on a single foot.","public_domain_status":"PD-original","source_url":"https://en.wikipedia.org/wiki/Epic_of_Sundiata","source_archive":"oral tradition (PD訳)","canonical_tier":1},
{"id":"pt_text_apoo_invocation","title_original":"Asante Apoo song","title_ja":"アシャンティ・アポー歌","author_name_display":"（アシャンティ口承）","era_year":1900,"era_period":"近代記録","culture_region":"アフリカ","language_original":"ak","form_genre":"祭儀歌","length_lines":3,"full_text_or_excerpt":"We have come to dance the apoo\nThat the chiefs of old danced\nWe sing the songs that were forbidden","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":3}
]}
