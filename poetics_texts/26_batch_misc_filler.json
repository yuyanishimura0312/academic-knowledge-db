{"id":"pt_text_dharmapada_5","title_original":"धम्मपद ५","title_ja":"法句経 5偈","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"na hi verena verāni, sammantīdha kudācanaṃ;\naverena ca sammanti, esa dhammo sanantano","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":1},
{"id":"pt_text_dharmapada_60","title_original":"धम्मपद ६०","title_ja":"法句経 60偈","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"dīghā jāgarato ratti, dīghaṃ santassa yojanaṃ;\ndīgho bālānaṃ saṃsāro, saddhammaṃ avijānataṃ","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":1},
{"id":"pt_text_dharmapada_63","title_original":"धम्मपद ६३","title_ja":"法句経 63偈","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"yo bālo maññati bālyaṃ, paṇḍito vāpi tena so;\nbālo ca paṇḍitamānī, sa ve 'bālo'ti vuccati","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_dharmapada_103","title_original":"धम्मपद १०३","title_ja":"法句経 103偈","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"yo sahassaṃ sahassena, saṅgāme mānuse jine;\nekañca jeyyamattānaṃ, sa ve saṅgāmajuttamo","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_dharmapada_197","title_original":"धम्मपद १९७","title_ja":"法句経 197偈","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"susukhaṃ vata jīvāma, verinesu averino;\nverinesu manussesu, viharāma averino","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_dharmapada_200","title_original":"धम्मपद २००","title_ja":"法句経 200偈","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"susukhaṃ vata jīvāma, yesaṃ no natthi kiñcanaṃ;\npītibhakkhā bhavissāma, devā ābhassarā yathā","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_dharmapada_286","title_original":"धम्मपद २८६","title_ja":"法句経 286偈","author_name_display":"（仏典）","era_year":-300,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"idha vassaṃ vasissāmi, idha hemantagimhisu;\niti bālo vicinteti, antarāyaṃ na bujjhati","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_theragatha_5","title_original":"Theragāthā 5","title_ja":"テーラガーター（長老偈）第5","author_name_display":"（伝・上座部）","era_year":-200,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":3,"full_text_or_excerpt":"abhippayam dukkhe vata\nasmim loke patitthitam\nidha pajjati patthano","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_theragatha_25","title_original":"Theragāthā 25","title_ja":"テーラガーター 第25","author_name_display":"（伝・上座部）","era_year":-200,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"vimokkho me anuttaro, na 'ham aññaṃ pavattayī","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":3},
{"id":"pt_text_theragatha_55","title_original":"Theragāthā 55","title_ja":"テーラガーター 第55","author_name_display":"Vakkali Thera","era_year":-200,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":3,"full_text_or_excerpt":"yo dhammaṃ passati, so maṃ passati\nyo maṃ passati, so dhammaṃ passati","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_therigatha_5","title_original":"Therīgāthā 5","title_ja":"テーリーガーター 第5","author_name_display":"（伝・上座部尼）","era_year":-200,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":2,"full_text_or_excerpt":"sukhaṃ supāhi therike, katvā coḷena pāvuriṃ;\nupasanto hi te rāgo, sukkhā ḍākasamuggakā","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":2},
{"id":"pt_text_therigatha_27","title_original":"Therīgāthā 27","title_ja":"テーリーガーター 第27","author_name_display":"（伝・上座部尼）","era_year":-200,"era_period":"原始仏教","culture_region":"仏典詩偈","language_original":"pli","form_genre":"ガーター","length_lines":3,"full_text_or_excerpt":"vatthena sūkararūpena","public_domain_status":"PD-original","source_url":"https://www.tipitaka.org/","source_archive":"Tipitaka.org","canonical_tier":3},
{"id":"pt_text_kanzan_6","title_original":"寒山詩「閑乘三輪車」","title_ja":"寒山詩「閑乘三輪車」","author_name_display":"寒山","era_year":750,"era_period":"唐","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"五言古詩・禅偈","length_lines":4,"full_text_or_excerpt":"閑乘三輪車，跡到岩頭路。\n聞君笑我貪，自到無常處。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/wiki/寒山詩","source_archive":"維基文庫 / CBETA","canonical_tier":2},
{"id":"pt_text_kanzan_7","title_original":"寒山詩「丹丘迥聳臥」","title_ja":"寒山詩「丹丘迥聳臥」","author_name_display":"寒山","era_year":750,"era_period":"唐","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"五言古詩・禅偈","length_lines":4,"full_text_or_excerpt":"丹丘迥聳臥，月落無人到。\n獨坐冬青下，誦經不能曉。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/wiki/寒山詩","source_archive":"維基文庫 / CBETA","canonical_tier":3},
{"id":"pt_text_huineng_full","title_original":"慧能・菩提偈","title_ja":"慧能 菩提偈（応無所住）","author_name_display":"慧能","era_year":700,"era_period":"唐","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"禅偈","length_lines":4,"full_text_or_excerpt":"菩提本無樹，明鏡亦非臺。\n本來無一物，何處惹塵埃。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_shenxiu_full","title_original":"神秀・偈","title_ja":"神秀 偈（時時勤拂拭）","author_name_display":"神秀","era_year":680,"era_period":"唐","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"禅偈","length_lines":4,"full_text_or_excerpt":"身是菩提樹，心如明鏡臺。\n時時勤拂拭，勿使惹塵埃。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_yanhing_zheng","title_original":"永嘉玄覺・證道歌","title_ja":"永嘉玄覚 証道歌（一切有為法）","author_name_display":"永嘉玄覚","era_year":700,"era_period":"唐","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"禅偈","length_lines":4,"full_text_or_excerpt":"君不見、絕學無為閑道人，\n不除妄想不求真。\n無明實性即佛性，幻化空身即法身。","public_domain_status":"PD-original","source_url":"https://zh.wikisource.org/wiki/證道歌","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_dogen_aritoki","title_original":"道元『正法眼蔵』有時","title_ja":"道元「有時」（時即有・有即時）","author_name_display":"道元","era_year":1240,"era_period":"鎌倉","culture_region":"仏典詩偈","language_original":"jpn","form_genre":"禅文","length_lines":3,"full_text_or_excerpt":"いはゆる有時は、時すでにこれ有なり、有はみな時なり。\n丈六金身これ時なり、時なるがゆゑに時の荘厳光明あり","public_domain_status":"PD-original","source_url":"https://www.aozora.gr.jp/cards/001329/","source_archive":"青空文庫","canonical_tier":1},
{"id":"pt_text_ippen_yugyo","title_original":"一遍上人語録偈","title_ja":"一遍上人語録「念仏のあとも先もなし」","author_name_display":"一遍","era_year":1287,"era_period":"鎌倉","culture_region":"仏典詩偈","language_original":"jpn","form_genre":"和讃","length_lines":4,"full_text_or_excerpt":"念仏のあとも先もなし\nただ南無阿弥陀仏ばかり\n生死涅槃を一念に\n一念とは捨てる念","public_domain_status":"PD-original","source_url":"https://www.aozora.gr.jp/","source_archive":"青空文庫","canonical_tier":2},
{"id":"pt_text_shinran_kyogyo","title_original":"親鸞『教行信証』和讃","title_ja":"親鸞 教行信証 和讃","author_name_display":"親鸞","era_year":1247,"era_period":"鎌倉","culture_region":"仏典詩偈","language_original":"jpn","form_genre":"和讃","length_lines":3,"full_text_or_excerpt":"如来浄華の聖衆は\n正覚の華より化生せり\n衆生の願楽ことごとく","public_domain_status":"PD-original","source_url":"https://www.aozora.gr.jp/","source_archive":"青空文庫","canonical_tier":2},
{"id":"pt_text_takuan_kasiraki","title_original":"沢庵 不動智神妙録","title_ja":"沢庵『不動智神妙録』","author_name_display":"沢庵宗彭","era_year":1632,"era_period":"近世","culture_region":"仏典詩偈","language_original":"jpn","form_genre":"禅偈","length_lines":3,"full_text_or_excerpt":"心はとどめざるを心の至極とせり\n心とどまればとらわれとなり\n心無心ならば無辺の智慧","public_domain_status":"PD-original","source_url":"https://www.aozora.gr.jp/","source_archive":"青空文庫","canonical_tier":2},
{"id":"pt_text_basho_zen_haiku_2","title_original":"芭蕉「秋深き」","title_ja":"芭蕉「秋深き隣は何をする人ぞ」","author_name_display":"松尾芭蕉","era_year":1694,"era_period":"近世","culture_region":"仏典詩偈","language_original":"jpn","form_genre":"俳諧","length_lines":1,"full_text_or_excerpt":"秋深き 隣は何を する人ぞ","public_domain_status":"PD-original","source_url":"https://www.aozora.gr.jp/cards/000146/","source_archive":"青空文庫","canonical_tier":1},
{"id":"pt_text_ryokan_temari","title_original":"良寛「霞立つ」","title_ja":"良寛「春日に手まりつく」","author_name_display":"良寛","era_year":1825,"era_period":"近世","culture_region":"仏典詩偈","language_original":"jpn","form_genre":"和歌","length_lines":5,"full_text_or_excerpt":"霞立つ 永き春日を 子供らと\n手まりつきつつ この日暮らしつ","public_domain_status":"PD-original","source_url":"https://www.aozora.gr.jp/index_pages/person146.html","source_archive":"青空文庫","canonical_tier":1},
{"id":"pt_text_hakuin_full","title_original":"白隠・坐禅和讃","title_ja":"白隠『坐禅和讃』全","author_name_display":"白隠慧鶴","era_year":1750,"era_period":"近世","culture_region":"仏典詩偈","language_original":"jpn","form_genre":"和讃","length_lines":4,"full_text_or_excerpt":"衆生本来仏なり\n水と氷の如くにて\n水を離れて氷なく\n衆生の外に仏なし","public_domain_status":"PD-original","source_url":"https://ja.wikisource.org/wiki/坐禅和讃","source_archive":"Wikisource ja","canonical_tier":1},
{"id":"pt_text_milarepa_song","title_original":"Milarepa Songs (PD)","title_ja":"ミラレパ歌（PD訳）","author_name_display":"Milarepa","era_year":1110,"era_period":"中世チベット","culture_region":"仏典詩偈","language_original":"bo","form_genre":"金剛歌","length_lines":3,"full_text_or_excerpt":"In the cave of solitude, alone\nI sing the song of inner heat\nMy body warms with mystical fire","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_shantideva","title_original":"शान्तिदेव - बोधिचर्यावतार","title_ja":"シャーンティデーヴァ『入菩提行論』","author_name_display":"Shantideva","era_year":700,"era_period":"中世インド仏教","culture_region":"仏典詩偈","language_original":"san","form_genre":"哲学詩","length_lines":3,"full_text_or_excerpt":"बोधिसत्त्वसमुद्भूतपुण्यानामात्मनात्मनः\nयावदाकाशं तिष्ठेत प्राणि","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_lotus_avalokit","title_original":"妙法蓮華経 観世音菩薩普門品","title_ja":"妙法蓮華経 観世音菩薩普門品 偈","author_name_display":"（伝・鳩摩羅什訳）","era_year":406,"era_period":"後秦","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"偈頌","length_lines":4,"full_text_or_excerpt":"世尊妙相具，我今重問彼。\n佛子何因緣，名為觀世音。","public_domain_status":"PD-original","source_url":"https://www.cbeta.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_lotus_eternal","title_original":"妙法蓮華経 如来寿量品","title_ja":"妙法蓮華経 如来寿量品 偈","author_name_display":"（伝・鳩摩羅什訳）","era_year":406,"era_period":"後秦","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"偈頌","length_lines":4,"full_text_or_excerpt":"自我得佛來，所經諸劫數。\n無量百千萬，億載阿僧祇。","public_domain_status":"PD-original","source_url":"https://www.cbeta.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_diamond_sutra","title_original":"金剛般若波羅蜜経 偈","title_ja":"金剛般若経「四句偈」","author_name_display":"（伝・鳩摩羅什訳）","era_year":403,"era_period":"後秦","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"偈頌","length_lines":4,"full_text_or_excerpt":"一切有為法，如夢幻泡影。\n如露亦如電，應作如是觀。","public_domain_status":"PD-original","source_url":"https://www.cbeta.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_heart_sutra","title_original":"般若心経","title_ja":"般若心経 全文","author_name_display":"（伝・玄奘訳）","era_year":649,"era_period":"唐","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"経典","length_lines":4,"full_text_or_excerpt":"觀自在菩薩。行深般若波羅蜜多時。照見五蘊皆空。度一切苦厄。\n舍利子。色不異空。空不異色。色即是空。空即是色。","public_domain_status":"PD-original","source_url":"https://www.cbeta.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_amida_kyo","title_original":"阿弥陀経 偈","title_ja":"阿弥陀経 偈","author_name_display":"（伝・鳩摩羅什訳）","era_year":402,"era_period":"後秦","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"経典","length_lines":3,"full_text_or_excerpt":"舍利弗。彼土何故名為極樂。其國眾生。無有眾苦。但受諸樂。故名極樂。","public_domain_status":"PD-original","source_url":"https://www.cbeta.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_huayan_dasong","title_original":"華厳経 入法界品偈","title_ja":"華厳経 入法界品 善財童子讃","author_name_display":"（伝・大乗仏典）","era_year":420,"era_period":"南北朝","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"偈頌","length_lines":4,"full_text_or_excerpt":"一切佛剎微塵中，皆有如來身。\n善財童子普見之，向諸佛眾敬禮。","public_domain_status":"PD-original","source_url":"https://www.cbeta.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_yuima","title_original":"維摩経 仏国品 偈","title_ja":"維摩経 仏国品「不二法門」","author_name_display":"（伝・鳩摩羅什訳）","era_year":406,"era_period":"後秦","culture_region":"仏典詩偈","language_original":"lzh","form_genre":"経典","length_lines":3,"full_text_or_excerpt":"心淨則國土淨。\n色不異空，空不異色。\n諸法空相，不生不滅。","public_domain_status":"PD-original","source_url":"https://www.cbeta.org/","source_archive":"CBETA","canonical_tier":1},
{"id":"pt_text_yokai_aborig_2","title_original":"Aboriginal Songline","title_ja":"アボリジニ・ソングライン","author_name_display":"（アボリジニ口承）","era_year":1900,"era_period":"近代記録","culture_region":"先住民・口承","language_original":"english","form_genre":"創世詩","length_lines":3,"full_text_or_excerpt":"Long ago in Dreaming time, the Rainbow Serpent\nMoved across the empty land\nShaping rivers and mountains with her body","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_navajo_blessing","title_original":"Navajo Blessingway Long Form","title_ja":"ナバホ「祝福の道」長歌","author_name_display":"（ナバホ口承）","era_year":1880,"era_period":"近代記録","culture_region":"先住民・口承","language_original":"nv","form_genre":"祈祷詩","length_lines":4,"full_text_or_excerpt":"With beauty before me, I walk\nWith beauty behind me, I walk\nWith beauty above me, I walk\nWith beauty below me, I walk","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_pueblo_corn","title_original":"Pueblo Corn Dance Song","title_ja":"プエブロ・コーン・ダンス歌","author_name_display":"（プエブロ口承）","era_year":1900,"era_period":"近代記録","culture_region":"先住民・口承","language_original":"english","form_genre":"祭祀歌","length_lines":3,"full_text_or_excerpt":"Now we plant the corn\nNow we sing for rain\nThe spirits dance with us today","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_chant_rain","title_original":"Hopi Rain Chant","title_ja":"ホピ雨乞い歌","author_name_display":"（ホピ口承）","era_year":1900,"era_period":"近代記録","culture_region":"先住民・口承","language_original":"hop","form_genre":"祈祷詩","length_lines":3,"full_text_or_excerpt":"Cloud-people, come to us\nFrom the four directions of the sky\nWith the gentle rain","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_yokai_inuit_2","title_original":"Inuit Magic Words","title_ja":"イヌイット魔法の言葉","author_name_display":"（イヌイット口承）","era_year":1900,"era_period":"近代記録","culture_region":"先住民・口承","language_original":"iu","form_genre":"魔法詩","length_lines":3,"full_text_or_excerpt":"In the very earliest time,\nWhen both people and animals lived on earth,\nA person could become an animal if he wanted to","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_inuit_dawn","title_original":"Inuit Magic Song","title_ja":"イヌイット呪歌","author_name_display":"（イヌイット口承）","era_year":1900,"era_period":"近代記録","culture_region":"先住民・口承","language_original":"iu","form_genre":"呪歌","length_lines":3,"full_text_or_excerpt":"And the great voice of the wind speaks\nThe ice cracks, the seal calls\nWe wait, watching, alone","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_zulu_song","title_original":"Zulu Song","title_ja":"ズール歌「私たちは進む」","author_name_display":"（ズール口承）","era_year":1900,"era_period":"近代記録","culture_region":"アフリカ","language_original":"zul","form_genre":"民謡","length_lines":3,"full_text_or_excerpt":"Siyahamba ekukhanyeni kwenkos'\nSiyahamba ekukhanyeni kwenkos'\nWe are marching in the light of God","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_zambian_lullaby","title_original":"Bemba Lullaby","title_ja":"ベンバ子守唄","author_name_display":"（ベンバ口承）","era_year":1900,"era_period":"近代記録","culture_region":"アフリカ","language_original":"bem","form_genre":"子守唄","length_lines":3,"full_text_or_excerpt":"Sleep, my little one, sleep now\nThe stars are watching over you\nThe ancestors will guard your dreams","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":3},
{"id":"pt_text_egyptian_aten_full","title_original":"Hymn to Aten Long Form","title_ja":"アテン讃歌（長文版）","author_name_display":"Akhenaten","era_year":-1340,"era_period":"新王国","culture_region":"アフリカ","language_original":"egy","form_genre":"讃歌","length_lines":4,"full_text_or_excerpt":"Splendid you rise on heaven's horizon\nO living Aten, who lives forever\nWhen you rise from the eastern horizon\nYou fill every land with your beauty","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_pyramid_unas","title_original":"Pyramid Texts of Unas","title_ja":"ウナス王ピラミッド・テクスト","author_name_display":"（古代エジプト）","era_year":-2350,"era_period":"古王国","culture_region":"アフリカ","language_original":"egy","form_genre":"宗教詩","length_lines":3,"full_text_or_excerpt":"Unas is loosed, the King is loosed\nThe King flies away from you, O men\nHe rises to the gods","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_egyptian_book_dead_complete","title_original":"Book of the Dead - Negative Confession","title_ja":"死者の書 「否定告白」全文","author_name_display":"（古代エジプト）","era_year":-1500,"era_period":"新王国","culture_region":"アフリカ","language_original":"egy","form_genre":"宗教詩","length_lines":4,"full_text_or_excerpt":"I have not done evil to mankind.\nI have not abused cattle.\nI have not committed crimes against god.\nI have not blasphemed against god.","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_egyptian_eloquent","title_original":"Tale of Eloquent Peasant","title_ja":"古代エジプト『雄弁な農夫の物語』","author_name_display":"（古代エジプト）","era_year":-2000,"era_period":"中王国","culture_region":"アフリカ","language_original":"egy","form_genre":"教訓詩","length_lines":3,"full_text_or_excerpt":"Speak the truth, do justice\nFor truth is great and lasting\nIts strength is unbroken","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":1},
{"id":"pt_text_oba_oba_oriki","title_original":"Yoruba Oriki Oba Oba","title_ja":"ヨルバ・オリキ「王の中の王」","author_name_display":"（ヨルバ口承）","era_year":1900,"era_period":"近代記録","culture_region":"アフリカ","language_original":"yo","form_genre":"宗教詩","length_lines":3,"full_text_or_excerpt":"Oba kabiyesi! Olufunmi! Olufunmi!\nOlú gbogbo ayé\nOba bi orisha","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_ifa_obara","title_original":"Yoruba Ifa - Eji Ogbe","title_ja":"ヨルバ・イファ「エジ・オグベ」","author_name_display":"（ヨルバ口承）","era_year":1900,"era_period":"近代記録","culture_region":"アフリカ","language_original":"yo","form_genre":"占い詩","length_lines":3,"full_text_or_excerpt":"Eji Ogbe, the foundation of all\nWho came down from the sky\nWho danced with the orisha","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_dahomey_oracle","title_original":"Dahomey Oracle Verses","title_ja":"ダホメー神託詩","author_name_display":"（ダホメー口承）","era_year":1700,"era_period":"中世ダホメー","culture_region":"アフリカ","language_original":"fon","form_genre":"占い詩","length_lines":3,"full_text_or_excerpt":"The serpent that bites the tail\nThe sky that meets the earth\nMawu speaks to her child","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":3},
{"id":"pt_text_swahili_zaidi","title_original":"Swahili Utenzi wa Tambuka 2","title_ja":"スワヒリ叙事詩『タンブカ』第2","author_name_display":"Bwana Mwengo","era_year":1728,"era_period":"近世スワヒリ","culture_region":"アフリカ","language_original":"sw","form_genre":"叙事詩","length_lines":3,"full_text_or_excerpt":"Wakajiri kwa mbele\nMaridhawa hao\nWakaja katika upinde","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2},
{"id":"pt_text_haitian_voodoo","title_original":"Haitian Vodou Song","title_ja":"ハイチ・ヴードゥー歌","author_name_display":"（ハイチ口承）","era_year":1900,"era_period":"近代記録","culture_region":"アフリカ","language_original":"ht","form_genre":"宗教歌","length_lines":3,"full_text_or_excerpt":"Papa Legba, ouvri pòt-la pou mwen\nAlfa Sé sé Légba\nOuvri pòt-la pou m' kapab pase","public_domain_status":"PD-original","source_url":"https://www.sacred-texts.com/","source_archive":"Sacred Texts","canonical_tier":2}
]}
