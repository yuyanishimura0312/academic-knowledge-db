{"id":"pt_text_gottfried_tristan","title_original":"Gottfried, Tristan","title_ja":"ゴットフリート『トリスタン』","author_name_display":"Gottfried von Strassburg","era_year":1210,"era_period":"中世ドイツ","culture_region":"中世ヨーロッパ","language_original":"gmh","form_genre":"ロマンス","length_lines":2,"full_text_or_excerpt":"Tristrant muoz suchen sin lant","public_domain_status":"PD-original","source_url":"https://de.wikisource.org/","source_archive":"Wikisource de","canonical_tier":1},
