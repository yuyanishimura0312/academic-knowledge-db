{"id":"pt_text_szymborska_no","title_original":"Szymborska, Nic dwa razy","title_ja":"シンボルスカ「二度はない」","author_name_display":"Wisława Szymborska","era_year":1957,"era_period":"ポーランド・モダン","culture_region":"20-21世紀グローバル","language_original":"pl","form_genre":"自由詩","length_lines":3,"full_text_or_excerpt":"Nic dwa razy się nie zdarza\ni nie zdarzy. Z tej przyczyny\nzrodziliśmy się bez wprawy","public_domain_status":"fair-use-excerpt","source_url":"https://pl.wikisource.org/","source_archive":"批評対象範囲","canonical_tier":1},
