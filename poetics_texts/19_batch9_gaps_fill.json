{"id":"pt_text_surdas_bhaja","title_original":"सूरदास - भज","title_ja":"スールダース バジャン","author_name_display":"Surdas","era_year":1565,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"バジャン","length_lines":2,"full_text_or_excerpt":"मैया मोरी मैं नहीं माखन खायो।\nख्याल परे ये सखा सबै मिलि","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":2},
