{"version":"phase7-bengali","texts":[
{"id":"pt_text_tagore_g11","title_original":"Gitanjali #11","title_ja":"タゴール『ギーターンジャリ』第11詩","author_name_display":"Rabindranath Tagore","era_year":1910,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"Leave this chanting and singing and telling of beads! Whom dost thou worship in this lonely dark corner of a temple with doors all shut?","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/7164/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_g50","title_original":"Gitanjali #50","title_ja":"タゴール『ギーターンジャリ』第50詩","author_name_display":"Rabindranath Tagore","era_year":1910,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"I had gone a-begging from door to door in the village path, when thy golden chariot appeared in the distance like a gorgeous dream","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/7164/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_g64","title_original":"Gitanjali #64","title_ja":"タゴール『ギーターンジャリ』第64詩","author_name_display":"Rabindranath Tagore","era_year":1910,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":2,"full_text_or_excerpt":"On the slope of the desolate river among tall grasses I asked her, 'Maiden, where do you go shading your lamp with your mantle?'","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/7164/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_g78","title_original":"Gitanjali #78","title_ja":"タゴール『ギーターンジャリ』第78詩","author_name_display":"Rabindranath Tagore","era_year":1910,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"When the creation was new and all the stars shone in their first splendour, the gods held their assembly in the sky","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/7164/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_g100","title_original":"Gitanjali #100","title_ja":"タゴール『ギーターンジャリ』第100詩","author_name_display":"Rabindranath Tagore","era_year":1910,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"I dive down into the depth of the ocean of forms, hoping to gain the perfect pearl of the formless","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/7164/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_fruit","title_original":"Tagore, Fruit-Gathering #6","title_ja":"タゴール『収穫』第6詩","author_name_display":"Rabindranath Tagore","era_year":1916,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"O Fire, my brother, I sing victory to you. You are the bright red image of fearful freedom","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6524/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_crescent","title_original":"Tagore, The Crescent Moon - The Home","title_ja":"タゴール『新月』「我が家」","author_name_display":"Rabindranath Tagore","era_year":1913,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":2,"full_text_or_excerpt":"I paced alone on the road across the field while the sunset was hiding its last gold like a miser","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6519/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_gardener_3","title_original":"Tagore, The Gardener #3","title_ja":"タゴール『園丁』第3詩","author_name_display":"Rabindranath Tagore","era_year":1913,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":2,"full_text_or_excerpt":"In the morning I cast my net into the sea. I dragged up from the dark abyss things of strange aspect and strange beauty","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6686/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_gardener_30","title_original":"Tagore, The Gardener #30","title_ja":"タゴール『園丁』第30詩","author_name_display":"Rabindranath Tagore","era_year":1913,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":2,"full_text_or_excerpt":"You are the evening cloud floating in the sky of my dreams. I paint you and fashion you ever with my love longings","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6686/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_stray_3","title_original":"Tagore, Stray Birds #3","title_ja":"タゴール『迷える鳥たち』第3","author_name_display":"Rabindranath Tagore","era_year":1916,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"アフォリズム詩","length_lines":2,"full_text_or_excerpt":"The world puts off its mask of vastness to its lover. It becomes small as one song, as one kiss of the eternal","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6524/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_stray_42","title_original":"Tagore, Stray Birds #42","title_ja":"タゴール『迷える鳥たち』第42","author_name_display":"Rabindranath Tagore","era_year":1916,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"アフォリズム詩","length_lines":2,"full_text_or_excerpt":"You smiled and talked to me of nothing and I felt that for this I had been waiting long","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6524/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_stray_82","title_original":"Tagore, Stray Birds #82","title_ja":"タゴール『迷える鳥たち』第82","author_name_display":"Rabindranath Tagore","era_year":1916,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"アフォリズム詩","length_lines":2,"full_text_or_excerpt":"Let life be beautiful like summer flowers and death like autumn leaves","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6524/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_stray_137","title_original":"Tagore, Stray Birds #137","title_ja":"タゴール『迷える鳥たち』第137","author_name_display":"Rabindranath Tagore","era_year":1916,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"アフォリズム詩","length_lines":2,"full_text_or_excerpt":"The water in a vessel is sparkling; the water in the sea is dark. The small truth has words that are clear; the great truth has great silence","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6524/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_lover_15","title_original":"Tagore, Lover's Gift #15","title_ja":"タゴール『恋人の贈り物』第15","author_name_display":"Rabindranath Tagore","era_year":1918,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"Beloved, my heart longs night and day for the meeting with you—for the meeting that is like all-devouring death","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/6520/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_tagore_song_offerings_43","title_original":"Tagore, Song Offerings #43","title_ja":"タゴール『歌の捧げ物』第43","author_name_display":"Rabindranath Tagore","era_year":1912,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"en","form_genre":"散文詩","length_lines":2,"full_text_or_excerpt":"The day was when I did not keep myself in readiness for thee; and entering my heart unbidden even as one of the common crowd","public_domain_status":"PD-original","source_url":"https://www.gutenberg.org/files/7164/","source_archive":"Project Gutenberg","canonical_tier":1},
{"id":"pt_text_chandidas_radha","title_original":"Chandidas, Sahaja","title_ja":"チャンディダース「サハジャ歌」","author_name_display":"Chandidas","era_year":1380,"era_period":"中世ベンガル","culture_region":"サンスクリット","language_original":"ben","form_genre":"バクティ詩","length_lines":2,"full_text_or_excerpt":"সবার উপরে মানুষ সত্য, তাহার উপরে নাই।","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_vidyapati_radha","title_original":"Vidyapati, Padavali","title_ja":"ヴィディヤーパティ「ラーダー・パダヴァリー」","author_name_display":"Vidyapati","era_year":1410,"era_period":"中世ベンガル","culture_region":"サンスクリット","language_original":"ben","form_genre":"バクティ詩","length_lines":2,"full_text_or_excerpt":"আজি রজনী হাম, ভাগে পোহায়লুঁ\nপেখলুঁ পিয়া মুখ চান্দা","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_jayadeva_8","title_original":"Jayadeva, Gita Govinda canto 8","title_ja":"ジャヤデーヴァ『ギータ・ゴーヴィンダ』第8歌","author_name_display":"Jayadeva","era_year":1180,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"歌唱叙情詩","length_lines":2,"full_text_or_excerpt":"रजनिजनितगुरुजागररागकषायितमलसनिमेषम्","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_jayadeva_12","title_original":"Jayadeva, Gita Govinda canto 12","title_ja":"ジャヤデーヴァ『ギータ・ゴーヴィンダ』第12歌（最終）","author_name_display":"Jayadeva","era_year":1180,"era_period":"古典サンスクリット","culture_region":"サンスクリット","language_original":"san","form_genre":"歌唱叙情詩","length_lines":2,"full_text_or_excerpt":"रतिसुखसारे गतमभिसारे मदनमनोहरवेशम्","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_chaitanya_4","title_original":"Chaitanya, Shikshashtaka 4","title_ja":"チャイタンニャ シクシャシュタカ 4","author_name_display":"Chaitanya","era_year":1530,"era_period":"中世ベンガル","culture_region":"サンスクリット","language_original":"san","form_genre":"バクティ詩","length_lines":2,"full_text_or_excerpt":"न धनं न जनं न सुन्दरीं कवितां वा जगदीश कामये।\nमम जन्मनि जन्मनीश्वरे भवताद्भक्तिरहैतुकी त्वयि॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_chaitanya_8","title_original":"Chaitanya, Shikshashtaka 8","title_ja":"チャイタンニャ シクシャシュタカ 8（最終）","author_name_display":"Chaitanya","era_year":1530,"era_period":"中世ベンガル","culture_region":"サンスクリット","language_original":"san","form_genre":"バクティ詩","length_lines":3,"full_text_or_excerpt":"आश्लिष्य वा पादरतां पिनष्टु मामदर्शनान्मर्महतां करोतु वा।\nयथा तथा वा विदधातु लम्पटो मत्प्राणनाथस्तु स एव नापरः॥","public_domain_status":"PD-original","source_url":"http://gretil.sub.uni-goettingen.de/","source_archive":"GRETIL","canonical_tier":1},
{"id":"pt_text_michael_madhusudan","title_original":"Michael Madhusudan Dutt, Meghnadbadh Kavya","title_ja":"マイケル・マドゥスダン・ダット『メグナードヴァダ・カーヴィヤ』","author_name_display":"Michael Madhusudan Dutt","era_year":1861,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"叙事詩","length_lines":3,"full_text_or_excerpt":"সম্মুখ সমরে পড়ি, বীর-চূড়ামণি\nবীরবাহু, চলি যবে গেলা যমপুরে","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_jibanananda_banalata","title_original":"Jibanananda Das, Banalata Sen","title_ja":"ジボナノンド・ダース「バナラタ・セン」","author_name_display":"Jibanananda Das","era_year":1942,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"自由詩","length_lines":3,"full_text_or_excerpt":"হাজার বছর ধরে আমি পথ হাঁটিতেছি পৃথিবীর পথে,\nসিংহল সমুদ্র থেকে নিশীথের অন্ধকারে মালয় সাগরে","public_domain_status":"fair-use-excerpt","source_url":"https://bn.wikisource.org/","source_archive":"批評対象範囲","canonical_tier":1},
{"id":"pt_text_kazi_nazrul_bidrohi","title_original":"Nazrul, Bidrohi","title_ja":"ナズルル・イスラム「反逆者」","author_name_display":"Kazi Nazrul Islam","era_year":1922,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"自由詩","length_lines":3,"full_text_or_excerpt":"বল বীর—\nবল উন্নত মম শির!\nশির নেহারি' আমারি, নত-শির ওই শিখর হিমাদ্রির!","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_rammohun_atma","title_original":"Rammohun Roy, Atmamoksha","title_ja":"ラーム・モーハン・ローイ「アートマー解脱の歌」","author_name_display":"Rammohun Roy","era_year":1820,"era_period":"近代ベンガル","culture_region":"サンスクリット","language_original":"ben","form_genre":"宗教詩","length_lines":2,"full_text_or_excerpt":"ব্রহ্মের নাম জপ মানুষ ভাই,\nএ ছাড়া পার পাবার আর কোনো উপায় নাই","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":2},
{"id":"pt_text_kabir_sakhi_1","title_original":"कबीर - साखी 1","title_ja":"カビール サーキー第1","author_name_display":"Kabir","era_year":1480,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"ドーハ","length_lines":2,"full_text_or_excerpt":"पोथी पढि पढि जग मुआ पंडित भया न कोय।\nढाई आखर प्रेम का पढे सो पंडित होय॥","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_kabir_sakhi_2","title_original":"कबीर - साखी 2","title_ja":"カビール サーキー第2","author_name_display":"Kabir","era_year":1480,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"ドーハ","length_lines":2,"full_text_or_excerpt":"माटी कहे कुम्हार से तू क्या रौंदे मोय।\nइक दिन ऐसा आयेगा मैं रौंदूंगी तोय॥","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_kabir_sakhi_3","title_original":"कबीर - साखी 3","title_ja":"カビール サーキー第3（虚偽の世）","author_name_display":"Kabir","era_year":1480,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"ドーハ","length_lines":2,"full_text_or_excerpt":"जिन ढूंढा तिन पाइयाँ, गहरे पानी पैठ।\nमैं बपुरा बूडन डरा, रहा किनारे बैठ॥","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_mira_payo","title_original":"मीराबाई - पायो","title_ja":"ミーラーバーイー「パヨ・ジー」","author_name_display":"Mirabai","era_year":1547,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"バクティ詩","length_lines":2,"full_text_or_excerpt":"पायोजी मैंने राम रतन धन पायो।\nवस्तु अमोलक दी म्हारे सतगुरु, किरपा करि अपणायो","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_surdas_braj","title_original":"सूरदास - व्रज","title_ja":"スールダース「ブラジ・バクティ」","author_name_display":"Surdas","era_year":1565,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"バクティ詩","length_lines":2,"full_text_or_excerpt":"मैं नहीं माखन खायो,\nख्याल परे ये सखा सबै मिलि मेरे मुख लपटायो","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_tulsi_hanuman","title_original":"तुलसीदास - हनुमान चालीसा","title_ja":"トゥルシーダース『ハヌマーン・チャーリーサー』冒頭","author_name_display":"Tulsidas","era_year":1580,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"讃歌","length_lines":2,"full_text_or_excerpt":"श्रीगुरु चरन सरोज रज, निज मनु मुकुरु सुधारि।\nबरनउँ रघुबर बिमल जसु, जो दायकु फल चारि॥","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_tulsi_ayodhya","title_original":"तुलसीदास - रामचरितमानस अयोध्याकाण्ड","title_ja":"トゥルシーダース『ラームチャリトマーナス』アヨーディヤー篇","author_name_display":"Tulsidas","era_year":1574,"era_period":"中世インド","culture_region":"サンスクリット","language_original":"san","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"यह सुधि पाइ हृदय हनुमाना। हरषे जोहारि गुरुहि गुहाना॥","public_domain_status":"PD-original","source_url":"https://hi.wikisource.org/","source_archive":"Wikisource hi","canonical_tier":1},
{"id":"pt_text_tukaram_abhang_1","title_original":"तुकाराम - अभंग 1","title_ja":"トゥカーラーム アバング第1","author_name_display":"Tukaram","era_year":1640,"era_period":"中世マラーティー","culture_region":"サンスクリット","language_original":"san","form_genre":"アバング","length_lines":2,"full_text_or_excerpt":"वृक्षवल्ली आम्हां सोयरीं वनचरें।\nपक्षीही सुस्वरें आळविती॥","public_domain_status":"PD-original","source_url":"https://mr.wikisource.org/","source_archive":"Wikisource mr","canonical_tier":1},
{"id":"pt_text_tukaram_abhang_2","title_original":"तुकाराम - अभंग 2","title_ja":"トゥカーラーム アバング第2","author_name_display":"Tukaram","era_year":1640,"era_period":"中世マラーティー","culture_region":"サンスクリット","language_original":"san","form_genre":"アバング","length_lines":2,"full_text_or_excerpt":"जे का रंजले गांजले। त्यासी म्हणे जो आपुले॥","public_domain_status":"PD-original","source_url":"https://mr.wikisource.org/","source_archive":"Wikisource mr","canonical_tier":1},
{"id":"pt_text_eknath_bhagvat","title_original":"एकनाथ - एकनाथी भागवत","title_ja":"エクナート『エクナーティー・バーガヴァト』","author_name_display":"Eknath","era_year":1573,"era_period":"中世マラーティー","culture_region":"サンスクリット","language_original":"san","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"नातरी प्रकट सकळ शास्त्रसार।\nश्रीहरीचें चरित्र अनादि॥","public_domain_status":"PD-original","source_url":"https://mr.wikisource.org/","source_archive":"Wikisource mr","canonical_tier":2},
{"id":"pt_text_lalla_kashmiri","title_original":"लल्ला - वाख","title_ja":"ラッラー（カシミーリ）「ヴァーク」","author_name_display":"Lal Ded","era_year":1380,"era_period":"中世カシミール","culture_region":"サンスクリット","language_original":"san","form_genre":"vakh","length_lines":2,"full_text_or_excerpt":"शिवा छुय थळि थळि रोइशिश\nमो जान हिँदु ता मुसलमान","public_domain_status":"PD-original","source_url":"https://en.wikisource.org/","source_archive":"Wikisource","canonical_tier":1},
{"id":"pt_text_namdev_abhang","title_original":"नामदेव - अभंग","title_ja":"ナームデーヴ アバング","author_name_display":"Namdev","era_year":1320,"era_period":"中世マラーティー","culture_region":"サンスクリット","language_original":"san","form_genre":"アバング","length_lines":2,"full_text_or_excerpt":"विठ्ठलावरी आहे माझा भाव।\nनेणे दुजा देव विठूविण॥","public_domain_status":"PD-original","source_url":"https://mr.wikisource.org/","source_archive":"Wikisource mr","canonical_tier":2},
{"id":"pt_text_dnyaneshwar_jnana","title_original":"ज्ञानेश्वर - ज्ञानेश्वरी","title_ja":"ジュニャーネーシュヴァル『ジュニャーネーシュヴァリー』冒頭","author_name_display":"Dnyaneshwar","era_year":1290,"era_period":"中世マラーティー","culture_region":"サンスクリット","language_original":"san","form_genre":"叙事詩","length_lines":2,"full_text_or_excerpt":"ओम् नमोजी आद्या। वेदप्रतिपाद्या।\nजय जय स्वसंवेद्या। आत्मरूपा॥","public_domain_status":"PD-original","source_url":"https://mr.wikisource.org/","source_archive":"Wikisource mr","canonical_tier":1},
{"id":"pt_text_andal_thiruppavai","title_original":"ஆண்டாள் - திருப்பாவை","title_ja":"アーンダール『ティルッパーヴァイ』第1","author_name_display":"Andal","era_year":850,"era_period":"中世タミル","culture_region":"サンスクリット","language_original":"tam","form_genre":"バクティ詩","length_lines":2,"full_text_or_excerpt":"மார்கழித் திங்கள் மதி நிறைந்த நன்னாளால்","public_domain_status":"PD-original","source_url":"https://ta.wikisource.org/","source_archive":"Wikisource ta","canonical_tier":1},
{"id":"pt_text_thiruvalluvar_inbam","title_original":"திருக்குறள் - இன்பத்துப்பால்","title_ja":"ティルックラル「インバム篇」（恋）","author_name_display":"Thiruvalluvar","era_year":300,"era_period":"古典タミル","culture_region":"サンスクリット","language_original":"tam","form_genre":"格言詩","length_lines":2,"full_text_or_excerpt":"அன்பிற்கும் உண்டோ அடைக்குந்தாழ் ஆர்வலர்\nபுன்கணீர் பூசல் தரும்","public_domain_status":"PD-original","source_url":"https://ta.wikisource.org/","source_archive":"Wikisource ta","canonical_tier":1},
{"id":"pt_text_kannadasan_modern","title_original":"बंगाली - रवींद्र संगीत","title_ja":"ロビンドロ・サンギート「アマール・ショナル・バングラ」","author_name_display":"Rabindranath Tagore","era_year":1905,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"歌曲","length_lines":3,"full_text_or_excerpt":"আমার সোনার বাংলা, আমি তোমায় ভালোবাসি।\nচিরদিন তোমার আকাশ, তোমার বাতাস","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_tagore_song_jana","title_original":"Tagore, Jana Gana Mana","title_ja":"タゴール「ジャナ・ガナ・マナ」（インド国歌）","author_name_display":"Rabindranath Tagore","era_year":1911,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"愛国歌","length_lines":3,"full_text_or_excerpt":"জনগণমন-অধিনায়ক জয় হে\nভারতভাগ্যবিধাতা","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_tagore_amar_shonar","title_original":"Tagore, Bidhata's Hand","title_ja":"タゴール「我は生まれ来たれり」","author_name_display":"Rabindranath Tagore","era_year":1907,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"歌曲","length_lines":2,"full_text_or_excerpt":"আকাশ ভরা সূর্য তারা, বিশ্ব ভরা প্রাণ\nতাহারি মাঝে আমি পেয়েছি মোর স্থান","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_tagore_song_keep","title_original":"Tagore, Where Mind is Without Fear (Bengali)","title_ja":"タゴール「恐れなき心」（ベンガル原文）","author_name_display":"Rabindranath Tagore","era_year":1910,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"自由詩","length_lines":3,"full_text_or_excerpt":"যেথায় চিত্ত ভয়শূন্য, যেথায় শির অবনত নয়\nযেথায় জ্ঞান মুক্ত","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_tagore_chinno","title_original":"Tagore, Chinno Patra","title_ja":"タゴール『途切れた手紙』","author_name_display":"Rabindranath Tagore","era_year":1912,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"散文詩","length_lines":3,"full_text_or_excerpt":"আমি যাবো তোমার পথে, যে পথে তুমি আছ\nযে পথে আমি ছিলাম","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":2},
{"id":"pt_text_basinte_balaka","title_original":"Tagore, Balaka","title_ja":"タゴール『鶴』表題詩","author_name_display":"Rabindranath Tagore","era_year":1916,"era_period":"近代ベンガル","culture_region":"20-21世紀グローバル","language_original":"ben","form_genre":"自由詩","length_lines":3,"full_text_or_excerpt":"হে অজ্ঞাত! তোমার ডাক শুনে চলেছি\nএগিয়ে যাই অজানার পানে","public_domain_status":"PD-original","source_url":"https://bn.wikisource.org/","source_archive":"Wikisource bn","canonical_tier":1},
{"id":"pt_text_iqbal_shikwa","title_original":"Iqbal, Shikwa","title_ja":"イクバール『嘆願』","author_name_display":"Muhammad Iqbal","era_year":1909,"era_period":"近代ウルドゥー","culture_region":"20-21世紀グローバル","language_original":"ar","form_genre":"頌歌","length_lines":3,"full_text_or_excerpt":"کیوں زیاں کار بنوں، سود فراموش رہوں\nفکر فردا نہ کروں، محو غم دوش رہوں","public_domain_status":"PD-original","source_url":"https://ur.wikisource.org/","source_archive":"Wikisource ur","canonical_tier":1},
{"id":"pt_text_ghalib_diwan_1","title_original":"غالب - دیوان غزل ۱","title_ja":"ガーリブ ガザル第1","author_name_display":"Mirza Ghalib","era_year":1855,"era_period":"近代ウルドゥー","culture_region":"アラビア・ペルシア","language_original":"ar","form_genre":"ガザル","length_lines":2,"full_text_or_excerpt":"نقش فریادی ہے کس کی شوخیِ تحریر کا\nکاغذی ہے پیرہن ہر پیکرِ تصویر کا","public_domain_status":"PD-original","source_url":"https://ur.wikisource.org/","source_archive":"Wikisource ur","canonical_tier":1},
{"id":"pt_text_ghalib_naqsh","title_original":"غالب - دل ناداں تجھے ہوا کیا ہے","title_ja":"ガーリブ「無知なる心よ」","author_name_display":"Mirza Ghalib","era_year":1855,"era_period":"近代ウルドゥー","culture_region":"アラビア・ペルシア","language_original":"ar","form_genre":"ガザル","length_lines":2,"full_text_or_excerpt":"دل ناداں تجھے ہوا کیا ہے\nآخر اس درد کی دوا کیا ہے","public_domain_status":"PD-original","source_url":"https://ur.wikisource.org/","source_archive":"Wikisource ur","canonical_tier":1},
{"id":"pt_text_meer_taqi_meer","title_original":"میر تقی میر - دیوان","title_ja":"ミール・タキー・ミール ガザル","author_name_display":"Mir Taqi Mir","era_year":1810,"era_period":"近代ウルドゥー","culture_region":"アラビア・ペルシア","language_original":"ar","form_genre":"ガザル","length_lines":2,"full_text_or_excerpt":"ہستی اپنی حباب کی سی ہے\nیہ نمائش سراب کی سی ہے","public_domain_status":"PD-original","source_url":"https://ur.wikisource.org/","source_archive":"Wikisource ur","canonical_tier":1}
]}
