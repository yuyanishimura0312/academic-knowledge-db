{"version":"phase7-vn-kr","texts":[
{"id":"pt_text_kieu_2","title_original":"Truyện Kiều - 春来","title_ja":"阮攸『金雲翹伝』春","author_name_display":"Nguyễn Du","era_year":1820,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"叙事詩","length_lines":4,"full_text_or_excerpt":"Trăm năm trong cõi người ta,\nChữ tài chữ mệnh khéo là ghét nhau.\nTrải qua một cuộc bể dâu,\nNhững điều trông thấy mà đau đớn lòng.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/wiki/Truy%E1%BB%87n_Ki%E1%BB%81u","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_kieu_meeting","title_original":"Truyện Kiều - 邂逅","title_ja":"阮攸『金雲翹伝』金重との出会い","author_name_display":"Nguyễn Du","era_year":1820,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"叙事詩","length_lines":4,"full_text_or_excerpt":"Cỏ non xanh tận chân trời,\nCành lê trắng điểm một vài bông hoa.\nThanh minh trong tiết tháng ba,\nLễ là tảo mộ, hội là đạp thanh.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/wiki/Truy%E1%BB%87n_Ki%E1%BB%81u","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_kieu_dream","title_original":"Truyện Kiều - 夢","title_ja":"阮攸『金雲翹伝』夢の中の予兆","author_name_display":"Nguyễn Du","era_year":1820,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"叙事詩","length_lines":4,"full_text_or_excerpt":"Đầu tường lửa lựu lập lòe đơm bông\nDưới hoa đã thấy có chàng đứng trông\nTrách rằng khoái khẩu mà ta\nMắng thân mà nỡ phụ tình bấy lâu","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/wiki/Truy%E1%BB%87n_Ki%E1%BB%81u","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_kieu_river","title_original":"Truyện Kiều - 河","title_ja":"阮攸『金雲翹伝』錢塘江","author_name_display":"Nguyễn Du","era_year":1820,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"叙事詩","length_lines":4,"full_text_or_excerpt":"Chiếc thuyền vô định trên sông\nGiữa dòng nước ròng quẩn quanh\nDừng tay, biết nói chăng anh\nNghĩ thân tự thẹn với mình bấy lâu","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/wiki/Truy%E1%BB%87n_Ki%E1%BB%81u","source_archive":"Wikisource vi","canonical_tier":2},
{"id":"pt_text_kieu_separation","title_original":"Truyện Kiều - 別れ","title_ja":"阮攸『金雲翹伝』別離","author_name_display":"Nguyễn Du","era_year":1820,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"叙事詩","length_lines":4,"full_text_or_excerpt":"Người đâu gặp gỡ làm chi,\nTrăm năm biết có duyên gì hay không?\nNgười về chiếc bóng năm canh,\nKẻ đi muôn dặm một mình xa xôi.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/wiki/Truy%E1%BB%87n_Ki%E1%BB%81u","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_xuanhuong_quan","title_original":"Hồ Xuân Hương - Quả Mít","title_ja":"胡春香「ジャックフルーツ」","author_name_display":"Hồ Xuân Hương","era_year":1810,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"七言絶句","length_lines":4,"full_text_or_excerpt":"Thân em như quả mít trên cây,\nDa nó xù xì, múi nó dày.\nQuân tử có thương thì đóng cọc,\nXin đừng mân mó, nhựa ra tay.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_xuanhuong_oc","title_original":"Hồ Xuân Hương - Ốc nhồi","title_ja":"胡春香「タニシ」","author_name_display":"Hồ Xuân Hương","era_year":1810,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"七言絶句","length_lines":4,"full_text_or_excerpt":"Bác mẹ sinh ra phận ốc nhồi\nĐêm ngày lăn lóc đám cỏ hôi\nQuân tử có thương thời bóc yếm\nXin đừng ngó ngoáy lỗ trôn tôi","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_xuanhuong_widow","title_original":"Hồ Xuân Hương - 寡婦","title_ja":"胡春香「寡婦の歌」","author_name_display":"Hồ Xuân Hương","era_year":1810,"era_period":"ベトナム阮朝","culture_region":"東アジア","language_original":"vie","form_genre":"七言絶句","length_lines":4,"full_text_or_excerpt":"Bố cu lổm ngổm bò trên bụng\nThằng bé hu hơ khóc dưới hông\nTất tả những là thu với vén\nVội vàng nào những bống cùng bông","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":2},
{"id":"pt_text_chinh_phu_ngam","title_original":"Đoàn Thị Điểm - Chinh phụ ngâm","title_ja":"段氏点『征婦吟曲』冒頭","author_name_display":"Đoàn Thị Điểm","era_year":1750,"era_period":"ベトナム後黎期","culture_region":"東アジア","language_original":"vie","form_genre":"双七六八","length_lines":4,"full_text_or_excerpt":"Thuở trời đất nổi cơn gió bụi,\nKhách má hồng nhiều nỗi truân chuyên.\nXanh kia thăm thẳm tầng trên,\nVì ai gây dựng cho nên nỗi này","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_nguyen_trai_quoc","title_original":"Nguyễn Trãi - Quốc Âm Thi Tập","title_ja":"阮廌『国音詩集』","author_name_display":"Nguyễn Trãi","era_year":1437,"era_period":"ベトナム後黎初期","culture_region":"東アジア","language_original":"vie","form_genre":"七言古詩","length_lines":4,"full_text_or_excerpt":"Ao thu lạnh lẽo nước trong veo,\nMột chiếc thuyền câu bé tẻo teo.\nSóng biếc theo làn hơi gợn tí,\nLá vàng trước gió khẽ đưa vèo.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_nguyen_binh_khiem","title_original":"Nguyễn Bỉnh Khiêm - Bạch Vân","title_ja":"阮秉謙『白雲国語詩集』","author_name_display":"Nguyễn Bỉnh Khiêm","era_year":1570,"era_period":"ベトナム後黎期","culture_region":"東アジア","language_original":"vie","form_genre":"七言絶句","length_lines":4,"full_text_or_excerpt":"Một mai một cuốc một cần câu\nThơ thẩn dầu ai vui thú nào\nTa dại ta tìm nơi vắng vẻ\nNgười khôn người đến chốn lao xao","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_tan_da_qiu","title_original":"Tản Đà - Thề Non Nước","title_ja":"タン・ダー「山と水の誓い」","author_name_display":"Tản Đà","era_year":1920,"era_period":"近代ベトナム","culture_region":"東アジア","language_original":"vie","form_genre":"自由詩","length_lines":4,"full_text_or_excerpt":"Nước non nặng một lời thề,\nNước đi đi mãi không về cùng non.\nNhớ lời nguyện nước thề non,\nNước đi chưa lại non còn đứng trông.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_nguyen_khuyen_thu","title_original":"Nguyễn Khuyến - Thu Vịnh","title_ja":"阮勧「秋詠」","author_name_display":"Nguyễn Khuyến","era_year":1890,"era_period":"近代ベトナム","culture_region":"東アジア","language_original":"vie","form_genre":"七言律詩","length_lines":4,"full_text_or_excerpt":"Trời thu xanh ngắt mấy tầng cao,\nCần trúc lơ phơ gió hắt hiu.\nNước biếc trông như tầng khói phủ,\nSong thưa để mặc bóng trăng vào.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_nguyen_khuyen_friends","title_original":"Nguyễn Khuyến - Bạn Đến Chơi Nhà","title_ja":"阮勧「友、家に来たり遊ぶ」","author_name_display":"Nguyễn Khuyến","era_year":1885,"era_period":"近代ベトナム","culture_region":"東アジア","language_original":"vie","form_genre":"七言律詩","length_lines":4,"full_text_or_excerpt":"Đã bấy lâu nay, bác tới nhà,\nTrẻ thời đi vắng, chợ thời xa.\nAo sâu nước cả, khôn chài cá,\nVườn rộng rào thưa, khó đuổi gà.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_tu_xuong_song","title_original":"Trần Tế Xương - Sông Lấp","title_ja":"陳済昌「埋もれた川」","author_name_display":"Trần Tế Xương","era_year":1900,"era_period":"近代ベトナム","culture_region":"東アジア","language_original":"vie","form_genre":"七言絶句","length_lines":4,"full_text_or_excerpt":"Sông kia rày đã nên đồng,\nChỗ làm nhà cửa, chỗ trồng ngô khoai.\nVẳng nghe tiếng ếch bên tai,\nGiật mình còn tưởng tiếng ai gọi đò.","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":1},
{"id":"pt_text_phan_boi_chau_battle","title_original":"Phan Bội Châu - 海外血書","title_ja":"潘佩珠『海外血書』詩節","author_name_display":"Phan Bội Châu","era_year":1907,"era_period":"近代ベトナム","culture_region":"東アジア","language_original":"vie","form_genre":"漢詩","length_lines":3,"full_text_or_excerpt":"Sống làm chi tủi nhục như giun,\nChết đi cũng phải chết cho đáng kiếp người","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":2},
{"id":"pt_text_le_quy_don_classic","title_original":"Lê Quý Đôn - Quế đường thi tập","title_ja":"黎貴惇『桂堂詩集』","author_name_display":"Lê Quý Đôn","era_year":1770,"era_period":"ベトナム後黎期","culture_region":"東アジア","language_original":"lzh","form_genre":"漢詩","length_lines":3,"full_text_or_excerpt":"行行重行行，與君生別離。\n相去萬餘里，各在天一涯。","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":2},
{"id":"pt_text_cao_ba_quat","title_original":"Cao Bá Quát - 水仙","title_ja":"高伯适「水仙花賦」","author_name_display":"Cao Bá Quát","era_year":1850,"era_period":"近代ベトナム","culture_region":"東アジア","language_original":"vie","form_genre":"賦","length_lines":3,"full_text_or_excerpt":"Trăm năm trong nỗi đoạn trường,\nVăn chương phú quý đôi đường khôn cân","public_domain_status":"PD-original","source_url":"https://vi.wikisource.org/","source_archive":"Wikisource vi","canonical_tier":2},
{"id":"pt_text_hyangga_choyongga","title_original":"處容歌","title_ja":"処容歌（郷歌）","author_name_display":"處容（ハンドゥル）","era_year":879,"era_period":"統一新羅","culture_region":"東アジア","language_original":"kor","form_genre":"郷歌","length_lines":4,"full_text_or_excerpt":"東京明期月良 夜入伊遊行如可\n入良沙寢矣見昆 脚烏伊四是良羅","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_hyangga_jemangmae","title_original":"祭亡妹歌","title_ja":"祭亡妹歌（郷歌）","author_name_display":"月明師","era_year":760,"era_period":"統一新羅","culture_region":"東アジア","language_original":"kor","form_genre":"郷歌","length_lines":4,"full_text_or_excerpt":"生死路隱 此矣有阿米次肹伊遣\n吾隱去內如辭叱都 毛如云遣去內尼叱古","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_korea_dongdong","title_original":"動動 (高麗歌謡)","title_ja":"動動（高麗歌謡）","author_name_display":"（高麗歌謡）","era_year":1200,"era_period":"高麗","culture_region":"東アジア","language_original":"kor","form_genre":"高麗歌謡","length_lines":4,"full_text_or_excerpt":"덕(德)으란 곰배예 받잡고, 복(福)으란 림배예 받잡고\n덕이여 복이라 호놀, 나아라 오소이다 아으 동동(動動)다리","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_korea_chongsang","title_original":"靑山別曲","title_ja":"青山別曲（高麗歌謡）","author_name_display":"（高麗歌謡）","era_year":1200,"era_period":"高麗","culture_region":"東アジア","language_original":"kor","form_genre":"高麗歌謡","length_lines":4,"full_text_or_excerpt":"살어리 살어리랏다 청산(靑山)에 살어리랏다\n멀위랑 다래랑 먹고 청산에 살어리랏다","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_korea_jeongseop","title_original":"鄭瓜亭 (鄭瓜亭曲)","title_ja":"鄭瓜亭曲（高麗歌謡）","author_name_display":"鄭瓜亭（鄭叙）","era_year":1170,"era_period":"高麗","culture_region":"東アジア","language_original":"kor","form_genre":"高麗歌謡","length_lines":3,"full_text_or_excerpt":"내 님을 그리수와 우니다니\n산접동새 난 이슷하요이다\n아니시며 거츠르신달 아으","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_korea_seogyeong","title_original":"西京別曲","title_ja":"西京別曲（高麗歌謡）","author_name_display":"（高麗歌謡）","era_year":1200,"era_period":"高麗","culture_region":"東アジア","language_original":"kor","form_genre":"高麗歌謡","length_lines":3,"full_text_or_excerpt":"서경(西京)이 아즐가 서경이 셔울히 마르는\n닷곤 데 아즐가 닷곤 데 쇼셩경 고요마른","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yi_bang_won","title_original":"이방원 - 何如歌","title_ja":"李芳遠「何如歌」（時調）","author_name_display":"Yi Bang-won","era_year":1390,"era_period":"高麗末","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"이런들 어떠하리 저런들 어떠하리\n만수산(萬壽山) 드렁칡이 얽혀진들 어떠하리\n우리도 이같이 얽혀져 백 년까지 누리리라","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_seol_kyon","title_original":"성삼문 - 死六臣 충절","title_ja":"成三問「忠節時調」","author_name_display":"Seong Sammun","era_year":1456,"era_period":"朝鮮初期","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"이 몸이 죽어가서 무엇이 될꼬 하니\n봉래산 제일봉에 낙락장송 되었다가\n백설이 만건곤할 제 독야청청 하리라","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_korea_hwang_ching","title_original":"황진이 - 청산리","title_ja":"黄真伊「青山裏碧渓水」","author_name_display":"Hwang Jini","era_year":1545,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"청산리 벽계수야 수이 감을 자랑마라\n일도 창해하면 다시 오기 어려워라\n명월이 만공산하니 쉬어 간들 어떠리","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yi_hwang_dosan","title_original":"이황 - 陶山十二曲","title_ja":"李退渓『陶山十二曲』","author_name_display":"Yi Hwang","era_year":1565,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"連時調","length_lines":3,"full_text_or_excerpt":"이런들 어떠하며 저런들 어떠하료\n초야우생이 이렇다 어떠하료\n하물며 천석고황을 고쳐 무엇하료","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yi_yi_kosan","title_original":"이이 - 高山九曲歌","title_ja":"李珥『高山九曲歌』","author_name_display":"Yi I","era_year":1578,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"連時調","length_lines":3,"full_text_or_excerpt":"고산 구곡담을 사람이 모르더니\n주모복거하니 벗님네 다 오신다\n어즈버 무이를 상상하고 학주자를 하리라","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yun_seondo_eobu_summer","title_original":"윤선도 - 漁父四時詞 夏","title_ja":"尹善道『漁父四時詞・夏』","author_name_display":"Yun Seondo","era_year":1651,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"連時調","length_lines":3,"full_text_or_excerpt":"궂은비 멈추고 시냇물이 맑아 온다\n배 띄워라 배 띄워라\n낚싯대를 둘러메니 깊은 흥을 어이하리","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yun_seondo_eobu_autumn","title_original":"윤선도 - 漁父四時詞 秋","title_ja":"尹善道『漁父四時詞・秋』","author_name_display":"Yun Seondo","era_year":1651,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"連時調","length_lines":3,"full_text_or_excerpt":"수국에 가을이 드니 고기마다 살져 있다\n닻 들어라 닻 들어라\n만경징파에 슬카지 용여하자","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yun_seondo_eobu_winter","title_original":"윤선도 - 漁父四時詞 冬","title_ja":"尹善道『漁父四時詞・冬』","author_name_display":"Yun Seondo","era_year":1651,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"連時調","length_lines":3,"full_text_or_excerpt":"간밤에 눈 갠 후에 경물(景物)이 다르도다\n배 저어라 배 저어라\n앞에는 만경유리(萬頃琉璃) 뒤에는 천첩옥산(千疊玉山)","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_jeong_chol_song_jiang","title_original":"정철 - 思美人曲","title_ja":"鄭澈『思美人曲』","author_name_display":"Jeong Cheol","era_year":1585,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"歌辞","length_lines":3,"full_text_or_excerpt":"이 몸 삼기실 제 임을 조차 삼기시니\n한생 연분이며 하늘 모를 일이런가\n나 하나 졈어 있고 임 하나 날 괴시니","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_jeong_chol_chusin","title_original":"정철 - 續美人曲","title_ja":"鄭澈『続美人曲』","author_name_display":"Jeong Cheol","era_year":1588,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"歌辞","length_lines":3,"full_text_or_excerpt":"데 가는 뎌 각시 본 듯도 한져이고\n천상 백옥경을 어찌하야 이별하고\n해 다 져믄 날에 눌을 보러 가시는고","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_pak_inro_no","title_original":"박인로 - 蘆溪集 太平詞","title_ja":"朴仁老『蘆渓集・太平詞』","author_name_display":"Pak Inro","era_year":1610,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"歌辞","length_lines":3,"full_text_or_excerpt":"인심(人心)이 풍속(風俗) 되니 잔(殘)인 풍속이로다\n태평성대(太平聖代)는 어찌 이리 적막(寂寞)고\n태평일월(太平日月)이 만세(萬世)에 이어지소서","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":2},
{"id":"pt_text_heo_nan","title_original":"허난설헌 - 빈녀가","title_ja":"許蘭雪軒「貧女吟」","author_name_display":"Heo Nanseolheon","era_year":1580,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"漢詩","length_lines":3,"full_text_or_excerpt":"豈無容色姿，工針復工織。\n少小長寒門，良媒不相識。","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_choe_chiwon_qiwen","title_original":"최치원 - 秋夜雨中","title_ja":"崔致遠「秋夜雨中」","author_name_display":"Choe Chiwon","era_year":880,"era_period":"統一新羅","culture_region":"東アジア","language_original":"kor","form_genre":"漢詩","length_lines":4,"full_text_or_excerpt":"秋風唯苦吟，世路少知音。\n窓外三更雨，燈前萬里心。","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_kim_sowol_chodong","title_original":"김소월 - 진달래꽃","title_ja":"金素月「躑躅花」","author_name_display":"Kim Sowol","era_year":1925,"era_period":"日帝下韓国","culture_region":"東アジア","language_original":"kor","form_genre":"近代詩","length_lines":4,"full_text_or_excerpt":"나 보기가 역겨워\n가실 때에는\n말없이 고이 보내 드리오리다\n영변에 약산\n진달래꽃","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_kim_sowol_giverose","title_original":"김소월 - 산유화","title_ja":"金素月「山有花」","author_name_display":"Kim Sowol","era_year":1925,"era_period":"日帝下韓国","culture_region":"東アジア","language_original":"kor","form_genre":"近代詩","length_lines":4,"full_text_or_excerpt":"산에는 꽃 피네\n꽃이 피네\n갈 봄 여름 없이\n꽃이 피네","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yun_dongju_chuang","title_original":"윤동주 - 서시","title_ja":"尹東柱「序詩」","author_name_display":"Yun Dongju","era_year":1941,"era_period":"日帝下韓国","culture_region":"東アジア","language_original":"kor","form_genre":"近代詩","length_lines":4,"full_text_or_excerpt":"죽는 날까지 하늘을 우러러\n한 점 부끄럼이 없기를,\n잎새에 이는 바람에도\n나는 괴로워했다.","public_domain_status":"fair-use-excerpt","source_url":"https://ko.wikisource.org/","source_archive":"批評対象範囲","canonical_tier":1},
{"id":"pt_text_yi_yuksa_top","title_original":"이육사 - 청포도","title_ja":"李陸史「青葡萄」","author_name_display":"Yi Yuksa","era_year":1939,"era_period":"日帝下韓国","culture_region":"東アジア","language_original":"kor","form_genre":"近代詩","length_lines":4,"full_text_or_excerpt":"내 고장 칠월은\n청포도가 익어 가는 시절\n이 마을 전설이 주절이주절이 열리고\n먼 데 하늘이 꿈꾸며 알알이 들어와 박혀","public_domain_status":"fair-use-excerpt","source_url":"https://ko.wikisource.org/","source_archive":"批評対象範囲","canonical_tier":1},
{"id":"pt_text_han_yongun_silence_2","title_original":"한용운 - 알 수 없어요","title_ja":"韓龍雲「私には分からない」","author_name_display":"Han Yongun","era_year":1926,"era_period":"日帝下韓国","culture_region":"東アジア","language_original":"kor","form_genre":"自由詩","length_lines":3,"full_text_or_excerpt":"바람도 없는 공중에 수직의 파문을 내며 고요히 떨어지는 오동잎은 누구의 발자취입니까","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_im_je_pukhan","title_original":"임제 - 패강가","title_ja":"林悌「浿江歌」","author_name_display":"Im Je","era_year":1583,"era_period":"朝鮮中期","culture_region":"東アジア","language_original":"kor","form_genre":"漢詩","length_lines":4,"full_text_or_excerpt":"오월 패강에 봄빛이 어렸으니\n버들 그늘 어찌 이리 짙은가\n천 리에 푸르른 풀빛만 있어\n뻐꾸기 울음만 끊임없네","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":2},
{"id":"pt_text_an_minyeong","title_original":"안민영 - 매화사","title_ja":"安玟英『梅花詞』","author_name_display":"An Minyeong","era_year":1880,"era_period":"朝鮮末期","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"매화 옛 등걸에 봄철이 돌아오니\n옛 피던 가지에 피염즉도 하다마는\n춘설이 난분분(亂紛紛)하니 필동말동 하여라","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_korean_seven_song","title_original":"무명씨 - 평시조","title_ja":"無名氏「平時調」（朝鮮）","author_name_display":"無名氏","era_year":1700,"era_period":"朝鮮後期","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"천만리 머나먼 길에 고운 임 여의옵고\n내 마음 둘 데 없어 냇가에 앉았으니\n저 물도 내 안 같아서 울어 밤길 예놋다","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":2},
{"id":"pt_text_kim_chondaek","title_original":"김천택 - 청구영언","title_ja":"金天澤『青丘永言』選","author_name_display":"Kim Cheontaek","era_year":1728,"era_period":"朝鮮後期","culture_region":"東アジア","language_original":"kor","form_genre":"時調","length_lines":3,"full_text_or_excerpt":"꿈에 다니는 길이 자취곳 나량이면\n님의 집 창 밖이 석로(石路)라도 닳으련만\n꿈길이 자취 없으니 그를 슬퍼하노라","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":2},
{"id":"pt_text_korean_pansori","title_original":"춘향가 - 사랑가","title_ja":"『春香歌』「愛歌」","author_name_display":"パンソリ","era_year":1850,"era_period":"朝鮮後期","culture_region":"東アジア","language_original":"kor","form_genre":"パンソリ","length_lines":3,"full_text_or_excerpt":"사랑 사랑 내 사랑이야\n어허둥둥 내 사랑이지\n어찌 이리도 어여쁜가","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_kim_si_seup_geum","title_original":"김시습 - 매월당집","title_ja":"金時習『梅月堂集』","author_name_display":"Kim Si-seup","era_year":1480,"era_period":"朝鮮初期","culture_region":"東アジア","language_original":"kor","form_genre":"漢詩","length_lines":4,"full_text_or_excerpt":"風雨蕭蕭夜獨吟，孤燈耿耿照愁心。\n殘年不奈離家久，鬢髮如霜兩鬢深。","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":1},
{"id":"pt_text_yi_seunghu","title_original":"이승휴 - 帝王韻紀","title_ja":"李承休『帝王韻紀』","author_name_display":"Yi Seung-hyu","era_year":1287,"era_period":"高麗末","culture_region":"東アジア","language_original":"kor","form_genre":"史詩","length_lines":3,"full_text_or_excerpt":"遼東別有一乾坤，斗與中朝區以分。\n洪濤萬頃圍三面，於北有陸連如線。","public_domain_status":"PD-original","source_url":"https://ko.wikisource.org/","source_archive":"Wikisource ko","canonical_tier":2}
]}
