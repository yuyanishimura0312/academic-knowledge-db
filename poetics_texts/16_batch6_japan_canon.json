{"id":"pt_text_manyo_sakimori","title_original":"万葉集・防人歌","title_ja":"防人歌「父母が頭かき撫で」","author_name_display":"丈部稲麻呂","era_year":755,"era_period":"上代","culture_region":"日本古典","language_original":"ojp","form_genre":"短歌・防人歌","length_lines":5,"full_text_or_excerpt":"父母が 頭かき撫で 幸くあれて\n言ひし言葉ぜ 忘れかねつる","public_domain_status":"PD-original","source_url":"https://ja.wikisource.org/wiki/萬葉集","source_archive":"Wikisource ja","canonical_tier":1},
