      "concept_links": [{"concept_id": "cp_catharsis", "link_type": "例証", "discussion_locus": "Aristotle Poetics 6"}]
    },
    {
      "id": "pt_text_sophocles_oedipus_1186",
      "title_original": "Οἰδίπους Τύραννος 1186-1196",
      "title_ja": "ソフォクレス『オイディプス王』終幕合唱",
      "title_en": "Sophocles Oedipus Tyrannus closing chorus",
      "author_name_display": "Sophocles",
      "era_year": -429,
      "era_period": "古代ギリシャ・classical",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "grc",
      "form_genre": "悲劇合唱歌",
      "length_lines": 11,
      "full_text_or_excerpt": "ἰὼ γενεαὶ βροτῶν, / ὡς ὑμᾶς ἴσα καὶ τὸ μη- / δὲν ζώσας ἐναριθμῶ. ...",
