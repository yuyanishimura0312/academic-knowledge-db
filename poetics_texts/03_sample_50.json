  "texts": [
    {
      "id": "pt_text_homer_iliad_001",
      "title_original": "Ἰλιάς α 1-7",
      "title_ja": "イーリアス 第1巻 冒頭",
      "title_en": "Iliad Book 1 opening",
      "author_name_display": "Homer",
      "era_year": -750,
      "era_period": "古代ギリシャ・archaic",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "grc",
      "form_genre": "叙事詩",
      "meter_prosody": "ダクテュロス・ヘクサメトロス",
      "length_lines": 7,
      "full_text_or_excerpt": "μῆνιν ἄειδε θεὰ Πηληϊάδεω Ἀχιλῆος\nοὐλομένην, ἣ μυρί᾽ Ἀχαιοῖς ἄλγε᾽ ἔθηκε,\nπολλὰς δ᾽ ἰφθίμους ψυχὰς Ἄϊδι προΐαψεν\nἡρώων, αὐτοὺς δὲ ἑλώρια τεῦχε κύνεσσιν\nοἰωνοῖσί τε πᾶσι, Διὸς δ᾽ ἐτελείετο βουλή,\nἐξ οὗ δὴ τὰ πρῶτα διαστήτην ἐρίσαντε\nἈτρεΐδης τε ἄναξ ἀνδρῶν καὶ δῖος Ἀχιλλεύς.",
      "excerpt_note": "冒頭7行（プロエミウム）",
      "public_domain_status": "PD-original",
      "source_url": "http://www.perseus.tufts.edu/hopper/text?doc=Hom.+Il.+1.1",
      "source_archive": "Perseus Digital Library",
      "license": "CC-BY-SA-3.0",
      "canonical_tier": 1,
      "translations": [
        {"language": "jpn", "translator_name": "（参考訳）", "translation_text": "歌え、女神よ、ペレウスの子アキレウスの怒りを／そのもたらす破滅は、アカイア勢に数知れぬ苦しみを与え／英雄たちの強き魂をハデスへ送り、彼らの屍を犬と／鳥どもの餌食となした。かくしてゼウスの計画は成就した――／アトレウスの子なる人々の王と神なるアキレウスとが／いさかい、対立し合ったその時から。", "translation_type": "literal"}
      ],
      "concept_links": [
        {"concept_id": "cp_mimesis", "link_type": "分析対象", "discussion_locus": "Aristotle Poetics 2-3"},
        {"concept_id": "cp_epic_tragedy", "link_type": "分析対象", "discussion_locus": "Aristotle Poetics 23-26"}
      ],
      "motifs": [{"motif_label": "怒り", "motif_category": "感情"}, {"motif_label": "英雄", "motif_category": "神話"}, {"motif_label": "戦争", "motif_category": "戦争"}]
    },
    {
      "id": "pt_text_homer_odyssey_001",
      "title_original": "Ὀδύσσεια α 1-10",
      "title_ja": "オデュッセイア 第1巻 冒頭",
      "title_en": "Odyssey Book 1 opening",
      "author_name_display": "Homer",
      "era_year": -720,
      "era_period": "古代ギリシャ・archaic",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "grc",
      "form_genre": "叙事詩",
      "meter_prosody": "ダクテュロス・ヘクサメトロス",
      "length_lines": 10,
      "full_text_or_excerpt": "ἄνδρα μοι ἔννεπε, μοῦσα, πολύτροπον, ὃς μάλα πολλὰ\nπλάγχθη, ἐπεὶ Τροίης ἱερὸν πτολίεθρον ἔπερσεν·\nπολλῶν δ᾽ ἀνθρώπων ἴδεν ἄστεα καὶ νόον ἔγνω,\nπολλὰ δ᾽ ὅ γ᾽ ἐν πόντῳ πάθεν ἄλγεα ὃν κατὰ θυμόν,\nἀρνύμενος ἥν τε ψυχὴν καὶ νόστον ἑταίρων.",
      "excerpt_note": "冒頭5行",
      "public_domain_status": "PD-original",
      "source_url": "http://www.perseus.tufts.edu/hopper/text?doc=Hom.+Od.+1.1",
      "source_archive": "Perseus Digital Library",
      "canonical_tier": 1,
      "concept_links": [{"concept_id": "cp_mimesis", "link_type": "分析対象", "discussion_locus": "Aristotle Poetics 4"}],
      "motifs": [{"motif_label": "旅", "motif_category": "旅"}, {"motif_label": "帰郷", "motif_category": "旅"}]
    },
    {
      "id": "pt_text_sappho_31",
      "title_original": "φαίνεταί μοι κῆνος ἴσος θέοισιν",
      "title_ja": "サッフォー断片31",
      "title_en": "Sappho fragment 31",
      "author_name_display": "Sappho",
      "era_year": -600,
      "era_period": "古代ギリシャ・archaic",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "grc",
      "form_genre": "抒情詩",
      "meter_prosody": "サッポー詩体",
      "length_lines": 16,
      "full_text_or_excerpt": "φαίνεταί μοι κῆνος ἴσος θέοισιν\nἔμμεν᾽ ὤνηρ, ὄττις ἐνάντιός τοι\nἰσδάνει καὶ πλάσιον ἆδυ φωνεί-\n  σας ὐπακούει\n\nκαὶ γελαίσας ἰμέροεν, τό μ᾽ ἦ μὰν\nκαρδίαν ἐν στήθεσιν ἐπτόαισεν...",
      "excerpt_note": "冒頭2連（5節中の2節）",
      "public_domain_status": "PD-original",
      "source_url": "https://www.perseus.tufts.edu/hopper/text?doc=Perseus%3Atext%3A2008.01.0479",
      "source_archive": "Perseus Digital Library",
      "canonical_tier": 1,
      "concept_links": [
        {"concept_id": "cp_hypsos", "link_type": "例証", "discussion_locus": "Longinus On the Sublime 10"}
      ],
      "motifs": [{"motif_label": "嫉妬", "motif_category": "感情"}, {"motif_label": "愛", "motif_category": "愛"}]
    },
    {
      "id": "pt_text_pindar_olympian1",
      "title_original": "ἄριστον μὲν ὕδωρ",
      "title_ja": "ピンダロス『オリュンピア祝勝歌』第1歌冒頭",
      "title_en": "Pindar Olympian 1 opening",
      "author_name_display": "Pindar",
      "era_year": -476,
      "era_period": "古代ギリシャ・classical",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "grc",
      "form_genre": "祝勝歌（エピニキオン）",
      "meter_prosody": "ピンダロス三部構造（ストロペー・アンチストロペー・エポドス）",
      "length_lines": 8,
      "full_text_or_excerpt": "ἄριστον μὲν ὕδωρ, ὁ δὲ χρυσὸς αἰθόμενον πῦρ\nἅτε διαπρέπει νυκτὶ μεγάνορος ἔξοχα πλούτου·",
      "excerpt_note": "冒頭2行",
      "public_domain_status": "PD-original",
      "source_url": "http://www.perseus.tufts.edu/hopper/text?doc=Pind.+O.+1",
      "source_archive": "Perseus Digital Library",
      "canonical_tier": 1,
      "concept_links": [{"concept_id": "cp_hypsos", "link_type": "例証", "discussion_locus": "Longinus 33-35"}]
    },
    {
      "id": "pt_text_aeschylus_agamemnon_chorus",
      "title_original": "Ἀγαμέμνων: στ. 160-183",
      "title_ja": "アイスキュロス『アガメムノン』ゼウス賛歌（合唱歌）",
      "title_en": "Aeschylus Agamemnon Hymn to Zeus",
      "author_name_display": "Aeschylus",
      "era_year": -458,
      "era_period": "古代ギリシャ・classical",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "grc",
      "form_genre": "悲劇合唱歌",
      "length_lines": 23,
      "full_text_or_excerpt": "Ζεύς, ὅστις ποτ᾽ ἐστίν, εἰ τόδ᾽ αὐ-\nτῷ φίλον κεκλημένῳ, / τοῦτό νιν προσεννέπω. ...",
      "excerpt_note": "ゼウス賛歌部冒頭",
      "public_domain_status": "PD-original",
      "source_url": "http://www.perseus.tufts.edu/hopper/text?doc=Aesch.+Ag.+160",
