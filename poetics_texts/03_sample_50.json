    {
      "id": "pt_text_catullus_5",
      "title_original": "Vivamus, mea Lesbia, atque amemus",
      "title_ja": "カトゥルス第5歌",
      "title_en": "Catullus 5",
      "author_name_display": "Catullus",
      "era_year": -55,
      "era_period": "Late Republic Rome",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "lat",
      "form_genre": "抒情詩（ヘンデカシラブス）",
      "meter_prosody": "ファラエケウス十一音節",
      "length_lines": 13,
      "full_text_or_excerpt": "Vivamus, mea Lesbia, atque amemus,\nrumoresque senum severiorum\nomnes unius aestimemus assis...\nda mi basia mille, deinde centum,\ndein mille altera, dein secunda centum...",
      "excerpt_note": "冒頭3行＋接吻句",
      "public_domain_status": "PD-original",
      "source_url": "https://www.thelatinlibrary.com/catullus.shtml#5",
      "source_archive": "The Latin Library",
      "canonical_tier": 1,
      "motifs": [{"motif_label": "愛", "motif_category": "愛"}, {"motif_label": "刹那", "motif_category": "時間"}]
    },
    {
      "id": "pt_text_virgil_aeneid_001",
      "title_original": "Arma virumque cano",
      "title_ja": "ウェルギリウス『アエネーイス』第1巻冒頭",
      "title_en": "Virgil Aeneid Book 1 opening",
      "author_name_display": "Virgil",
      "era_year": -19,
      "era_period": "Augustan Rome",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "lat",
      "form_genre": "叙事詩",
      "meter_prosody": "ダクテュロス・ヘクサメトロス",
      "length_lines": 11,
      "full_text_or_excerpt": "Arma virumque cano, Troiae qui primus ab oris\nItaliam, fato profugus, Laviniaque venit\nlitora, multum ille et terris iactatus et alto\nvi superum saevae memorem Iunonis ob iram...",
      "excerpt_note": "冒頭4行",
      "public_domain_status": "PD-original",
      "source_url": "https://www.thelatinlibrary.com/vergil/aen1.shtml",
      "source_archive": "The Latin Library",
      "canonical_tier": 1,
      "concept_links": [{"concept_id": "cp_epic_tragedy", "link_type": "分析対象"}]
    },
    {
      "id": "pt_text_horace_carmen_1_11",
      "title_original": "Tu ne quaesieris (Carmen 1.11)",
      "title_ja": "ホラティウス『カルミナ』第1巻第11歌（カルペ・ディエム）",
      "title_en": "Horace Odes 1.11 'Carpe Diem'",
      "author_name_display": "Horace",
      "era_year": -23,
      "era_period": "Augustan Rome",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "lat",
      "form_genre": "頌歌",
      "meter_prosody": "アスクレピアデス第五詩体",
      "length_lines": 8,
      "full_text_or_excerpt": "Tu ne quaesieris, scire nefas, quem mihi, quem tibi\nfinem di dederint, Leuconoe, nec Babylonios\ntemptaris numeros...\ndum loquimur, fugerit invida\naetas: carpe diem, quam minimum credula postero.",
      "public_domain_status": "PD-original",
      "source_url": "https://www.thelatinlibrary.com/horace/carm1.shtml",
      "source_archive": "The Latin Library",
      "canonical_tier": 1,
      "motifs": [{"motif_label": "刹那", "motif_category": "時間"}, {"motif_label": "死", "motif_category": "死"}]
    },
    {
      "id": "pt_text_ovid_metamorphoses_001",
      "title_original": "In nova fert animus",
      "title_ja": "オウィディウス『変身物語』第1巻冒頭",
      "title_en": "Ovid Metamorphoses 1.1-4",
      "author_name_display": "Ovid",
      "era_year": 8,
      "era_period": "Augustan Rome",
      "culture_region": "古代ギリシャ・ローマ",
      "language_original": "lat",
      "form_genre": "叙事詩（変身譚）",
      "meter_prosody": "ヘクサメトロス",
      "length_lines": 4,
      "full_text_or_excerpt": "In nova fert animus mutatas dicere formas\ncorpora; di, coeptis (nam vos mutastis et illas)\nadspirate meis primaque ab origine mundi\nad mea perpetuum deducite tempora carmen.",
      "public_domain_status": "PD-original",
      "source_url": "https://www.thelatinlibrary.com/ovid/ovid.met1.shtml",
      "source_archive": "The Latin Library",
      "canonical_tier": 1
    },

    {
      "id": "pt_text_shijing_guanju",
      "title_original": "詩經・周南・關雎",
      "title_ja": "詩経 周南 関雎",
      "title_en": "Shijing 'Guan ju'",
      "author_name_display": "詩経編者（伝・孔子編纂）",
      "era_year": -700,
      "era_period": "先秦",
      "culture_region": "中国古典",
      "language_original": "lzh",
      "form_genre": "四言詩（風）",
      "length_lines": 20,
      "full_text_or_excerpt": "關關雎鳩，在河之洲。\n窈窕淑女，君子好逑。\n參差荇菜，左右流之。\n窈窕淑女，寤寐求之。",
      "excerpt_note": "冒頭2章",
      "public_domain_status": "PD-original",
      "source_url": "https://zh.wikisource.org/wiki/詩經/關雎",
      "source_archive": "維基文庫",
      "canonical_tier": 1,
      "motifs": [{"motif_label": "求愛", "motif_category": "愛"}, {"motif_label": "自然", "motif_category": "自然"}]
    },
    {
      "id": "pt_text_chuci_lisao",
      "title_original": "楚辭・離騷",
      "title_ja": "楚辞 離騒（冒頭）",
      "title_en": "Chuci 'Li Sao' opening",
      "author_name_display": "屈原",
      "era_year": -300,
      "era_period": "先秦",
      "culture_region": "中国古典",
      "language_original": "lzh",
      "form_genre": "騒体",
      "length_lines": 8,
      "full_text_or_excerpt": "帝高陽之苗裔兮，朕皇考曰伯庸。\n攝提貞於孟陬兮，惟庚寅吾以降。\n皇覽揆余初度兮，肇錫余以嘉名。",
      "excerpt_note": "冒頭3聯",
      "public_domain_status": "PD-original",
      "source_url": "https://zh.wikisource.org/wiki/楚辭/離騷",
      "source_archive": "維基文庫",
      "canonical_tier": 1
    },
    {
      "id": "pt_text_gushi_19_1",
      "title_original": "古詩十九首・其一",
      "title_ja": "古詩十九首 其一「行行重行行」",
      "title_en": "Nineteen Old Poems #1",
      "author_name_display": "佚名（漢代）",
      "era_year": 100,
      "era_period": "後漢",
      "culture_region": "中国古典",
      "language_original": "lzh",
      "form_genre": "五言古詩",
      "length_lines": 16,
      "full_text_or_excerpt": "行行重行行，與君生別離。\n相去萬餘里，各在天一涯。\n道路阻且長，會面安可知？",
      "public_domain_status": "PD-original",
      "source_url": "https://zh.wikisource.org/wiki/古詩十九首",
      "source_archive": "維基文庫",
      "canonical_tier": 1
    },
    {
      "id": "pt_text_taoyuanming_drinking_5",
      "title_original": "陶淵明・飲酒・其五",
      "title_ja": "陶淵明 飲酒 其五（結廬在人境）",
      "title_en": "Tao Yuanming 'Drinking Wine' #5",
      "author_name_display": "陶淵明",
      "era_year": 410,
      "era_period": "東晋",
      "culture_region": "中国古典",
      "language_original": "lzh",
      "form_genre": "五言古詩",
      "length_lines": 10,
      "full_text_or_excerpt": "結廬在人境，而無車馬喧。\n問君何能爾？心遠地自偏。\n採菊東籬下，悠然見南山。\n山氣日夕佳，飛鳥相與還。\n此中有真意，欲辨已忘言。",
      "public_domain_status": "PD-original",
      "source_url": "https://zh.wikisource.org/wiki/飲酒_(陶淵明)",
      "source_archive": "維基文庫",
      "canonical_tier": 1,
      "motifs": [{"motif_label": "隠遁", "motif_category": "自然"}, {"motif_label": "酒", "motif_category": "日常"}]
    },
    {
      "id": "pt_text_libai_jingyesi",
      "title_original": "李白・靜夜思",
      "title_ja": "李白 静夜思",
      "title_en": "Li Bai 'Quiet Night Thought'",
      "author_name_display": "李白",
      "era_year": 750,
      "era_period": "盛唐",
      "culture_region": "中国古典",
      "language_original": "lzh",
      "form_genre": "五言絶句",
      "length_lines": 4,
      "full_text_or_excerpt": "床前明月光，疑是地上霜。\n舉頭望明月，低頭思故鄉。",
      "public_domain_status": "PD-original",
      "source_url": "https://zh.wikisource.org/wiki/靜夜思",
      "source_archive": "維基文庫",
      "canonical_tier": 1,
      "concept_links": [{"concept_id": "cp_tang_poetry_lyric_comparatism", "link_type": "分析対象"}],
      "motifs": [{"motif_label": "望郷", "motif_category": "旅"}, {"motif_label": "月", "motif_category": "自然"}]
    },
    {
      "id": "pt_text_dufu_chunwang",
      "title_original": "杜甫・春望",
      "title_ja": "杜甫 春望",
      "title_en": "Du Fu 'Spring View'",
      "author_name_display": "杜甫",
      "era_year": 757,
      "era_period": "盛唐",
      "culture_region": "中国古典",
      "language_original": "lzh",
      "form_genre": "五言律詩",
      "length_lines": 8,
      "full_text_or_excerpt": "國破山河在，城春草木深。\n感時花濺淚，恨別鳥驚心。\n烽火連三月，家書抵萬金。\n白頭搔更短，渾欲不勝簪。",
      "public_domain_status": "PD-original",
      "source_url": "https://zh.wikisource.org/wiki/春望_(杜甫)",
      "source_archive": "維基文庫",
      "canonical_tier": 1,
      "concept_links": [{"concept_id": "cp_tang_poetry_lyric_comparatism", "link_type": "分析対象"}]
    },
    {
      "id": "pt_text_wangwei_lu_zhai",
      "title_original": "王維・鹿柴",
      "title_ja": "王維 鹿柴",
      "title_en": "Wang Wei 'Deer Park'",
      "author_name_display": "王維",
      "era_year": 740,
      "era_period": "盛唐",
      "culture_region": "中国古典",
      "language_original": "lzh",
      "form_genre": "五言絶句",
      "length_lines": 4,
      "full_text_or_excerpt": "空山不見人，但聞人語響。\n返景入深林，復照青苔上。",
      "public_domain_status": "PD-original",
      "source_url": "https://zh.wikisource.org/wiki/鹿柴",
      "source_archive": "維基文庫",
      "canonical_tier": 1
    },
    {
      "id": "pt_text_baijuyi_changhenge",
      "title_original": "白居易・長恨歌",
      "title_ja": "白居易 長恨歌（冒頭）",
